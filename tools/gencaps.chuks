// Generate the capability boundary from one declaration.
//
// A capability's arguments used to be stated three times and agreed on by hand: the
// Chuks call site built a list of strings, the Swift host read fields[1] and hoped it
// was a number, and the Kotlin host did the same thing again. Nothing tied the three
// together, so an argument added on one side and forgotten on another was a runtime
// surprise, and a wrong type was a silent zero until the host stopped guessing.
//
// So the arguments are declared once, in core/capabilities.json, and this writes all
// three sides:
//
//   core/caps.gen.chuks        typed encoder per capability  (no string(...) at call sites)
//   ios/ChuksCaps.gen.swift    typed decoder per capability  (no fields[i], no ?? 0)
//   android/ChuksCaps.gen.kt   the same, for the other host
//
// Run: chuks run tools/gencaps.chuks <sdkroot>
// Both builds run it, so the generated files can never drift from the declaration.
//
// Only capabilities whose arguments have a type to get wrong are declared. One that
// takes nothing, or a single string, has nothing to state and stays hand-written.
import { fs } from "std/fs";
import { json } from "std/json";
import { os } from "std/os";

dataType Arg { name: string, type: string }
dataType Cap { wire: string, fn: string, args: []Arg, note: string }

// "secondsAgo:int" -> Arg
function parseArg(spec: string): Arg {
    const colon: int = spec.indexOf(":")
    if (colon < 0) { return { name: spec, type: "string" } }
    return { name: spec.slice(0, colon), type: spec.slice(colon + 1, spec.length) }
}

// "calendar.create" -> "calendarCreate", the identifier all three languages share.
function fnName(wire: string): string {
    var out: string = ""
    var up: bool = false
    var i: int = 0
    while (i < wire.length) {
        const c: string = wire.slice(i, i + 1)
        i = i + 1
        if (c == ".") { up = true; continue }
        out = out + (up ? c.toUpperCase() : c)
        up = false
    }
    return out
}

function readDecl(sdkroot: string): []Cap {
    var out: []Cap = []
    const path: string = sdkroot + "/core/capabilities.json"
    if (!fs.exists(path)) { return out }
    const doc: any = json.parse(fs.readFile(path))
    const caps: any = doc["capabilities"]
    const names: []string = caps.keys()
    var i: int = 0
    while (i < names.length) {
        const wire: string = names[i]
        i = i + 1
        const entry: any = caps[wire]
        const rawArgs: []any = entry["args"]
        var args: []Arg = []
        var j: int = 0
        while (j < rawArgs.length) { args.push(parseArg(string(rawArgs[j]))); j = j + 1 }
        out.push({ wire: wire, fn: fnName(wire), args: args, note: string(entry["note"]) })
    }
    return out
}

// ---- Chuks: the encoder -----------------------------------------------------

function chuksType(t: string): string { return t }

function chuksEncode(a: Arg): string {
    if (a.type == "bool") { return a.name + " ? \"1\" : \"0\"" }
    if (a.type == "string") { return a.name }
    return "string(" + a.name + ")"
}

function genChuks(caps: []Cap): string {
    var out: string = "// GENERATED by tools/gencaps.chuks from core/capabilities.json. Do not edit.\n"
    out = out + "//\n"
    out = out + "// One typed function per capability that takes arguments worth typing. The call\n"
    out = out + "// site names them and passes them as themselves; the conversion to the wire lives\n"
    out = out + "// here, generated from the same declaration the two hosts decode with, so the\n"
    out = out + "// three can never disagree about order, count or type.\n\n"
    var i: int = 0
    while (i < caps.length) {
        const c: Cap = caps[i]
        i = i + 1
        var params: string = ""
        var fields: string = ""
        var j: int = 0
        while (j < c.args.length) {
            const a: Arg = c.args[j]
            if (j > 0) { params = params + ", "; fields = fields + ", " }
            params = params + a.name + ": " + chuksType(a.type)
            fields = fields + chuksEncode(a)
            j = j + 1
        }
        out = out + "/** " + c.wire + ": " + c.note + " */\n"
        out = out + "export function args" + c.fn.slice(0, 1).toUpperCase() + c.fn.slice(1, c.fn.length) + "(" + params + "): []string {\n"
        out = out + "    return [" + fields + "]\n"
        out = out + "}\n\n"
    }
    return out
}

// ---- Swift: the decoder -----------------------------------------------------

function swiftType(t: string): string {
    if (t == "int") { return "Int" }
    if (t == "float") { return "Double" }
    if (t == "bool") { return "Bool" }
    return "String"
}

function genSwift(caps: []Cap): string {
    var out: string = "// GENERATED by tools/gencaps.chuks from core/capabilities.json. Do not edit.\n"
    out = out + "//\n"
    out = out + "// One decoder per capability. Each answers a value whose fields are named and\n"
    out = out + "// typed, or fails the token with a message naming the argument that was wrong,\n"
    out = out + "// which is the difference between a capability that reports a problem and one\n"
    out = out + "// that quietly acts on a zero.\n"
    out = out + "import Foundation\n\n"
    out = out + "enum ChuksCaps {\n"
    var i: int = 0
    while (i < caps.length) {
        const c: Cap = caps[i]
        i = i + 1
        // A struct rather than a tuple: Swift has no single-element labelled tuple, and
        // this matches the Kotlin data class shape, so both hosts read `a.name`.
        const cls: string = c.fn.slice(0, 1).toUpperCase() + c.fn.slice(1, c.fn.length) + "Args"
        out = out + "    /// " + c.wire + ": " + c.note + "\n"
        out = out + "    struct " + cls + " {\n"
        var j: int = 0
        while (j < c.args.length) {
            const a: Arg = c.args[j]
            out = out + "        let " + a.name + ": " + swiftType(a.type) + "\n"
            j = j + 1
        }
        out = out + "    }\n"
        out = out + "    static func " + c.fn + "(_ f: [String], _ token: String, _ host: ChuksArgFailer) -> " + cls + "? {\n"
        out = out + "        guard f.count >= " + string(c.args.length) + " else {\n"
        out = out + "            host.argMissing(token, \"" + c.wire + "\", " + string(c.args.length) + ", f.count); return nil\n"
        out = out + "        }\n"
        var k: int = 0
        while (k < c.args.length) {
            const a2: Arg = c.args[k]
            const idx: string = string(k)
            if (a2.type == "int") {
                out = out + "        guard let " + a2.name + " = Int(f[" + idx + "]) else { host.argBad(token, \"" + c.wire + "\", \"" + a2.name + "\", \"int\", f[" + idx + "]); return nil }\n"
            } else if (a2.type == "float") {
                out = out + "        guard let " + a2.name + " = Double(f[" + idx + "]) else { host.argBad(token, \"" + c.wire + "\", \"" + a2.name + "\", \"number\", f[" + idx + "]); return nil }\n"
            } else if (a2.type == "bool") {
                out = out + "        let " + a2.name + " = (f[" + idx + "] == \"1\")\n"
            } else {
                out = out + "        let " + a2.name + " = f[" + idx + "]\n"
            }
            k = k + 1
        }
        var pass: string = ""
        var m: int = 0
        while (m < c.args.length) {
            if (m > 0) { pass = pass + ", " }
            pass = pass + c.args[m].name + ": " + c.args[m].name
            m = m + 1
        }
        out = out + "        return " + cls + "(" + pass + ")\n"
        out = out + "    }\n\n"
    }
    out = out + "}\n"
    return out
}

// ---- Kotlin: the same decoder ----------------------------------------------

function kotlinType(t: string): string {
    if (t == "int") { return "Int" }
    if (t == "float") { return "Double" }
    if (t == "bool") { return "Boolean" }
    return "String"
}

function genKotlin(caps: []Cap): string {
    var out: string = "// GENERATED by tools/gencaps.chuks from core/capabilities.json. Do not edit.\n"
    out = out + "//\n"
    out = out + "// The Android half of ios/ChuksCaps.gen.swift, from the same declaration.\n"
    out = out + "package com.chuks.app\n\n"
    var i: int = 0
    while (i < caps.length) {
        const c: Cap = caps[i]
        i = i + 1
        var fieldsDecl: string = ""
        var j: int = 0
        while (j < c.args.length) {
            const a: Arg = c.args[j]
            if (j > 0) { fieldsDecl = fieldsDecl + ", " }
            fieldsDecl = fieldsDecl + "val " + a.name + ": " + kotlinType(a.type)
            j = j + 1
        }
        const cls: string = c.fn.slice(0, 1).toUpperCase() + c.fn.slice(1, c.fn.length) + "Args"
        out = out + "/** " + c.wire + ": " + c.note + " */\n"
        out = out + "data class " + cls + "(" + fieldsDecl + ")\n\n"
    }
    out = out + "object ChuksCaps {\n"
    var n: int = 0
    while (n < caps.length) {
        const c2: Cap = caps[n]
        n = n + 1
        const cls2: string = c2.fn.slice(0, 1).toUpperCase() + c2.fn.slice(1, c2.fn.length) + "Args"
        out = out + "    fun " + c2.fn + "(f: List<String>, token: String, host: ChuksArgFailer): " + cls2 + "? {\n"
        out = out + "        if (f.size < " + string(c2.args.length) + ") { host.argMissing(token, \"" + c2.wire + "\", " + string(c2.args.length) + ", f.size); return null }\n"
        var k2: int = 0
        while (k2 < c2.args.length) {
            const a3: Arg = c2.args[k2]
            const idx2: string = string(k2)
            if (a3.type == "int") {
                out = out + "        val " + a3.name + " = f[" + idx2 + "].toIntOrNull() ?: run { host.argBad(token, \"" + c2.wire + "\", \"" + a3.name + "\", \"int\", f[" + idx2 + "]); return null }\n"
            } else if (a3.type == "float") {
                out = out + "        val " + a3.name + " = f[" + idx2 + "].toDoubleOrNull() ?: run { host.argBad(token, \"" + c2.wire + "\", \"" + a3.name + "\", \"number\", f[" + idx2 + "]); return null }\n"
            } else if (a3.type == "bool") {
                out = out + "        val " + a3.name + " = f[" + idx2 + "] == \"1\"\n"
            } else {
                out = out + "        val " + a3.name + " = f[" + idx2 + "]\n"
            }
            k2 = k2 + 1
        }
        var pass2: string = ""
        var m2: int = 0
        while (m2 < c2.args.length) {
            if (m2 > 0) { pass2 = pass2 + ", " }
            pass2 = pass2 + c2.args[m2].name
            m2 = m2 + 1
        }
        out = out + "        return " + cls2 + "(" + pass2 + ")\n"
        out = out + "    }\n\n"
    }
    out = out + "}\n"
    return out
}

function main(): void {
    const a: []string = os.args()
    const sdkroot: string = a.length > 3 ? a[3] : "."
    const caps: []Cap = readDecl(sdkroot)
    if (caps.length == 0) { println("gencaps: no declaration at " + sdkroot + "/core/capabilities.json"); return }
    fs.writeFile(sdkroot + "/core/caps.gen.chuks", genChuks(caps))
    fs.writeFile(sdkroot + "/ios/ChuksCaps.gen.swift", genSwift(caps))
    fs.writeFile(sdkroot + "/android/ChuksCaps.gen.kt", genKotlin(caps))
    println("gencaps: " + string(caps.length) + " capabilities -> Chuks, Swift, Kotlin")
}

main()
