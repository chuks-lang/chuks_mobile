// Native capabilities — part of @chuks/mobile. Each capability is a thin wrapper
// over the async host->engine bridge (emitNativeCommand): it emits an
// `X|token|capability|args` command that the native host (iOS/Android) executes,
// and for async reads the host calls resolve(token, payload), which fires your
// callback. Your app code uses these wrappers, never the raw command ids.
//
// Fire-and-forget capabilities pass no callback (the token is "0"); async reads
// pass a `(string) -> void` that receives the host's result payload.
import { emitNativeCommand, emitNativeCommandE, emitNativeStream, NativeSub } from "./ui.chuks";
import { Base64 } from "std/base64";

// ---- Clipboard --------------------------------------------------------------
// set() copies text; get() reads it (async — the OS pasteboard read is deferred).
export class Clipboard {
    public static set(text: string): void { emitNativeCommand("clipboard.set", text, null) }
    public static get(onResult: (string)=> void): void { emitNativeCommand("clipboard.get", "", onResult) }
}

// ---- Linking ----------------------------------------------------------------
// Open a URL, tel:, mailto:, or app scheme in the OS. canOpen() answers async with a
// bool (the host's "1"/"0" is converted, so callers never compare a magic string).
export class Linking {
    public static open(url: string): void { emitNativeCommand("linking.open", url, null) }
    public static canOpen(url: string, onResult: (bool)=> void): void {
        emitNativeCommand("linking.canOpen", url, function(s: string): void { onResult(s == "1") })
    }
}

// ---- Share ------------------------------------------------------------------
// Present the OS share sheet with text and/or a URL.
export class Share {
    public static text(t: string): void { emitNativeCommand("share.text", t, null) }
    public static url(u: string): void { emitNativeCommand("share.url", u, null) }
}

// ---- Haptics ----------------------------------------------------------------
// style: "light" | "medium" | "heavy" | "success" | "warning" | "error" | "selection".
export class Haptics {
    public static impact(style: string): void { emitNativeCommand("haptics.impact", style, null) }
}

// ---- Torch / flashlight -----------------------------------------------------
export class Torch {
    public static set(on: bool): void { emitNativeCommand("torch.set", on ? "1" : "0", null) }
}

// ---- Screen brightness ------------------------------------------------------
// level is 0.0..1.0. keepAwake() toggles the idle timer (keep the screen on).
export class Brightness {
    public static set(level: float): void { emitNativeCommand("brightness.set", string(level), null) }
    public static keepAwake(on: bool): void { emitNativeCommand("brightness.keepAwake", on ? "1" : "0", null) }
}

// ---- Orientation ------------------------------------------------------------
// The device orientation, as a stream, plus a lock. watch() fires the current value
// immediately ("portrait" | "landscape"), then on every rotation, until its NativeSub
// is cancelled. lockTo(mode) pins the UI to "portrait" | "landscape", or "auto" to follow
// the device again. (`lock` is a Chuks keyword, hence `lockTo`.)
export class Orientation {
    public static watch(onChange: (string)=> void): NativeSub { return emitNativeStream("orientation.watch", "", onChange, null) }
    public static lockTo(mode: string): void { emitNativeCommand("orientation.lock", mode, null) }
}

// ---- Location / GPS ---------------------------------------------------------
// The device position, from CoreLocation (iOS) / LocationManager (Android). once()
// reads a single fix; watch() streams fixes as the device moves — the first as soon
// as one is available, then on each update, until its NativeSub is cancelled. Both
// payloads are comma-separated (comma, not "|", which is the mutation-wire delimiter):
//   "lat,lng,accuracy,altitude,speed,heading"
// all floats; accuracy is in metres, speed in m/s, heading in degrees (a negative
// value means that field is unavailable on this fix). Needs the "location" permission
// — request it via Permission.request("location", ...) first; onError fires if the
// permission is denied or no location provider is available.
export class Location {
    public static once(onResult: (string)=> void, onError: (string)=> void): void {
        emitNativeCommandE("location.once", "", onResult, onError)
    }
    public static watch(onUpdate: (string)=> void, onError: (string)=> void): NativeSub {
        return emitNativeStream("location.watch", "", onUpdate, onError)
    }
}

// ---- Media picker + camera --------------------------------------------------
// pickImage() opens the OS photo library; takePhoto() opens the OS camera. Both
// present the system UI and, on success, copy the chosen/captured image into the
// app's private storage and answer (via onResult) with a "file://<path>" string you
// can hand straight to an Image — see the Image component's file:// support. onError
// fires if the user cancels, no image comes back, or the camera is unavailable.
// takePhoto needs the "camera" permission (request it via Permission.request first);
// pickImage needs no permission on either platform (the OS picker is the consent).
export class MediaPicker {
    public static pickImage(onResult: (string)=> void, onError: (string)=> void): void {
        emitNativeCommandE("mediapicker.image", "", onResult, onError)
    }
}
export class Camera {
    public static takePhoto(onResult: (string)=> void, onError: (string)=> void): void {
        emitNativeCommandE("camera.photo", "", onResult, onError)
    }
}

// ---- Device info ------------------------------------------------------------
// screen() reads the CURRENT screen size — a live read, not a launch-time constant,
// since it changes on rotation, split-screen, and foldables. The payload is
// "width,height,scale": width/height in logical points (iOS) / density-independent
// pixels (Android), and scale the pixel ratio (e.g. "3" on a 3x iPhone, "2.75" on a
// Pixel). For the device's static identity (os / version / model / isTablet) use the
// sync getters in core/platform.chuks instead.
export class DeviceInfo {
    public static screen(onResult: (string)=> void): void { emitNativeCommand("deviceinfo.screen", "", onResult) }
}

// ---- Biometrics -------------------------------------------------------------
// Face ID / Touch ID (iOS, LAContext) and fingerprint / face (Android, the framework
// BiometricPrompt, API 28+). available() answers "1" if the device has enrolled
// biometrics that can be used right now (the host's "1"/"0" is converted to a real bool
// so callers never compare a magic string). authenticate(reason, onOk, onError) shows the
// OS prompt: onOk fires once the user is verified; onError fires with a message if they
// cancel, fail, or biometrics are unavailable. `reason` is the prompt subtitle (iOS shows
// it under the Face ID sheet; Android as the subtitle).
export class Biometrics {
    public static available(onResult: (bool)=> void): void {
        emitNativeCommand("biometrics.available", "", function(s: string): void { onResult(s == "1") })
    }
    public static authenticate(reason: string, onOk: ()=> void, onError: (string)=> void): void {
        emitNativeCommandE("biometrics.authenticate", reason, function(_: string): void { onOk() }, onError)
    }
}

// ---- Motion sensors ---------------------------------------------------------
// Device-motion streams from CoreMotion (iOS) / SensorManager (Android). Each fires
// "x,y,z" (comma-separated floats, comma not "|") continuously (~20Hz) until its
// NativeSub is cancelled. accelerometer is in g and includes gravity, gyroscope in
// rad/s, magnetometer in microtesla. onError fires if the sensor is absent — e.g. the
// iOS Simulator has no motion hardware, so accelerometer reports "unavailable" there.
export class Motion {
    public static accelerometer(onData: (string)=> void, onError: (string)=> void): NativeSub { return emitNativeStream("motion.accel", "", onData, onError) }
    public static gyroscope(onData: (string)=> void, onError: (string)=> void): NativeSub { return emitNativeStream("motion.gyro", "", onData, onError) }
    public static magnetometer(onData: (string)=> void, onError: (string)=> void): NativeSub { return emitNativeStream("motion.mag", "", onData, onError) }
}

// ---- Pulse (a STREAM: the host ticks a monotonic counter every ~50ms) -------
// A minimal repeating stream used to exercise + prove the teardown path: start it
// in a useEffect, cancel() the returned NativeSub in the cleanup, and on unmount
// hookSweep tears down the native timer. `onTick` gets the tick count as a string.
export class Pulse {
    public static watch(onTick: (string)=> void): NativeSub { return emitNativeStream("pulse.watch", "", onTick, null) }
}

// ---- Permissions (F2) -------------------------------------------------------
// One primitive every gated capability reuses. `kind` is one of: "camera",
// "microphone", "location", "notifications", "photos". status() reads the current
// grant WITHOUT prompting; request() shows the OS dialog (once) and reports the
// outcome. Both answer via onResult with: "granted" | "denied" | "undetermined" |
// "restricted" (Android reports only granted/denied). onError (request only) fires
// for an unknown kind or a platform failure. Built entirely on the F3 bridge.
export class Permission {
    public static status(kind: string, onResult: (string)=> void): void {
        emitNativeCommand("permission.status", kind, onResult)
    }
    public static request(kind: string, onResult: (string)=> void, onError: (string)=> void): void {
        emitNativeCommandE("permission.request", kind, onResult, onError)
    }
}

// ---- File system (Tier B) ---------------------------------------------------
// Read / write / list / delete files in the app's private document directory.
// write()'s content is base64-encoded on the wire, because the command channel is
// newline-delimited and file content is arbitrary/multiline; the host decodes it.
// read() returns the content directly (the result channel is binary-safe). read of
// a missing file goes to onError.
export class FileSystem {
    public static write(name: string, content: string): void {
        emitNativeCommand("fs.write", name + "|" + new Base64().encode(content), null)
    }
    public static read(name: string, onResult: (string)=> void, onError: (string)=> void): void {
        emitNativeCommandE("fs.read", name, onResult, onError)
    }
    public static list(onResult: (string)=> void): void {
        emitNativeCommand("fs.list", "", onResult)
    }
    public static delete(name: string): void { emitNativeCommand("fs.delete", name, null) }
}

// ---- Secure storage (Tier B) ------------------------------------------------
// Encrypted key/value backed by the OS keystore (iOS Keychain, Android Keystore
// AES-GCM) — for tokens, secrets, small sensitive values. Same content encoding
// as FileSystem (the value is base64 on the wire); get() of a missing key ->
// onError. Not for large blobs; use FileSystem for those.
export class SecureStore {
    public static set(key: string, value: string): void {
        emitNativeCommand("secure.set", key + "|" + new Base64().encode(value), null)
    }
    public static get(key: string, onResult: (string)=> void, onError: (string)=> void): void {
        emitNativeCommandE("secure.get", key, onResult, onError)
    }
    public static delete(key: string): void { emitNativeCommand("secure.delete", key, null) }
}

// ---- Local notifications (Tier B) -------------------------------------------
// Post a local notification. Requires the "notifications" permission (see F2).
// Both title and body are base64 on the wire (arbitrary text). Fires shortly
// after the call and appears in the notification shade / as a banner.
export class Notifications {
    public static notify(title: string, body: string): void {
        const b: Base64 = new Base64()
        emitNativeCommand("notif.notify", b.encode(title) + "|" + b.encode(body), null)
    }
}

// ---- Audio playback (Tier B) ------------------------------------------------
// Play a bundled audio track (an asset filename, e.g. "sample.mp4") through the
// OS media player. play() (re)loads + starts; pause/resume/stop control it; a
// single track plays at a time. position() answers (async) with "posMs/durMs" —
// the proof that playback actually advanced (and freezes while paused).
export class Audio {
    public static play(src: string): void { emitNativeCommand("audio.play", src, null) }
    public static pause(): void { emitNativeCommand("audio.pause", "", null) }
    public static resume(): void { emitNativeCommand("audio.resume", "", null) }
    public static stop(): void { emitNativeCommand("audio.stop", "", null) }
    public static position(onResult: (string)=> void): void { emitNativeCommand("audio.position", "", onResult) }
}

// ---- Text-to-speech (Tier B) ------------------------------------------------
// Speak text aloud via the OS speech synthesizer. speak() replaces any current
// utterance; stop() cancels it. text is base64 on the wire (arbitrary/multiline).
// isSpeaking() answers (async) a bool -- true while speaking -- the proof that the
// synthesizer engaged. On Android the engine + voice data must be present (it usually
// is); if absent, isSpeaking stays false.
export class Tts {
    public static speak(text: string): void { emitNativeCommand("tts.speak", new Base64().encode(text), null) }
    public static stop(): void { emitNativeCommand("tts.stop", "", null) }
    public static isSpeaking(onResult: (bool)=> void): void {
        emitNativeCommand("tts.isSpeaking", "", function(s: string): void { onResult(s == "1") })
    }
}

// ---- Real streams (Tier B) --------------------------------------------------
// Live OS state as F3 streams: each fires once immediately with the current value,
// then again on every change, until the returned NativeSub is cancelled (which
// unregisters the underlying OS observer -- teardown is verified via
// Debug.activeStreams reading 0 after cancel, same as Pulse).
export class Battery {
    // onChange gets "level,charging", e.g. "87,1" (level 0..100, charging 1/0).
    // Comma, not "|": "|" is the mutation-wire field delimiter and is unsafe in a payload.
    public static watch(onChange: (string)=> void): NativeSub { return emitNativeStream("battery.watch", "", onChange, null) }
}
export class AppState {
    // onChange gets "active" | "inactive" | "background".
    public static watch(onChange: (string)=> void): NativeSub { return emitNativeStream("appstate.watch", "", onChange, null) }
}
export class Network {
    // onChange gets "wifi" | "cellular" | "none" | "other".
    public static watch(onChange: (string)=> void): NativeSub { return emitNativeStream("network.watch", "", onChange, null) }
}

// ---- Debug ------------------------------------------------------------------
// activeStreams() answers (async) with the host's live native-subscription count —
// the assertion that a stream's NATIVE side was actually released, not just that
// Chuks stopped receiving. Should read "0" after every stream is cancelled.
// fail() always resolves via the ERROR channel, to exercise onErr end-to-end.
export class Debug {
    public static activeStreams(onResult: (string)=> void): void { emitNativeCommand("debug.activeStreams", "", onResult) }
    public static fail(onResult: (string)=> void, onError: (string)=> void): void { emitNativeCommandE("debug.fail", "", onResult, onError) }
}
