// @chuks/ui -- the Chuks Mobile framework toolkit. Authored once; app developers
// import this and write components in app/app.chuks, never editing this file.
//
// It provides: the flexbox Style model, the Node tree, declarative element
// builders, the memoized Component base, and the Reconciler (which diffs trees
// into the minimal CREATE/STYLE/TEXT/INSERT/REMOVE mutation stream the native
// host applies). No module-global state -- the mutation buffer lives on a
// Reconciler instance the app owns, so nothing crosses the import boundary as
// shared mutable state.

import { hookEnter, hookBegin, hookSweep, runEffects, serializeCells, restoreCells } from "./state.chuks";
import { host } from "std/host";
import { Prop } from "./prop.chuks";
import { tw } from "./tw.chuks";

// ---- Style: a compact subset of the flexbox + visual model -----------------
export class Style {
    var dir: string     // "row" | "col"
    var just: string    // start|center|end|between|around
    var align: string   // start|center|end|stretch
    var grow: int
    var basis: int      // flex-basis; 0 = "fill available, ignore content size"
    var w: int
    var h: int
    var pad: int
    var padX: int       // horizontal padding (px); -1 = unset. Overrides `pad` on the L/R edges.
    var padY: int       // vertical padding (py); -1 = unset. Overrides `pad` on the T/B edges.
    var padT: int; var padR: int; var padB: int; var padL: int   // per-side padding (pt/pr/pb/pl)
    var marT: int; var marR: int; var marB: int; var marL: int   // per-side margin (mt/mr/mb/ml)
    var minW: int; var maxW: int; var minH: int; var maxH: int   // min/max width/height
    var wPct: int; var hPct: int   // width/height as a percent of the parent (0..100)
    var bottom: int    // absolute inset from the bottom
    var z: int         // z-index (paint order)
    var aspectR: int   // aspect ratio as w/h * 100 (square = 100, video = 178)
    var rTL: int; var rTR: int; var rBR: int; var rBL: int   // per-corner radius
    var italic: int    // 1 = italic, 0 = not, -1 = unset
    var deco: string   // text decoration: underline | strike | none
    var txform: string // text transform: upper | lower | cap | none
    var tracking: int  // letter spacing (px)
    var leading: int   // line height (px)
    var fontFam: string// font family name
    var overflow: string // hidden | visible | scroll
    var hidden: int    // 1 = not rendered
    var selfAlign: string // align-self: start | center | end | stretch
    var bStyle: string // border style: solid | dashed | dotted
    var gap: int
    var bg: string      // hex, e.g. "1B1F2A"
    var fg: string      // text color hex
    var fs: int         // font size
    var fw: string      // regular|semibold|bold
    var ta: string      // text align: left|center|right
    var img: string     // SF Symbol name for an Image node
    var radius: int
    var pos: string     // "abs" for absolute positioning
    var top: int
    var left: int
    var right: int
    var bw: int         // border width (px)
    var bwT: int; var bwR: int; var bwB: int; var bwL: int   // per-side border width (px); -1 = unset
    var bc: string      // border color hex
    var shadow: int     // elevation: 1 small, 2 medium, 3 large
    var glass: int      // Liquid Glass material: 1 = on (iOS 26 glassEffect; blur fallback elsewhere)
    var opacity: int    // 0-100 (-1 = fully opaque)
    var wrap: string    // "wrap" | "nowrap" (flex-wrap)
    var font: string    // custom font family (e.g. an icon font); "" = system
    var vid: string     // video filename for a Video node
    var swOn: int       // Switch on-state: 1 = on, 0 = off (-1 = not a Switch)
    var swThumb: string // Switch thumb color (hex, e.g. "FFFFFF"); "" = platform default
    var press: int      // Pressable active opacity 0-100 while held (-1 = no press feedback)
    var sec: int        // Input secure-entry (password): 1 = masked (-1 = normal)
    var sbHide: int     // StatusBar hidden: 1 hide, 0 show (-1 = not a StatusBar)
    var sbStyle: string // StatusBar content: "light" | "dark" | "" (auto, follows theme)
    var sbColor: string // StatusBar background color (hex, e.g. "222A3A"); "" = default
    var sbNavColor: string // Android nav-bar background color (hex); "" = default (iOS has no nav bar)
    var mvis: int       // Modal visible: 1 shown, 0 hidden (-1 = not a Modal)
    var mpos: string    // Modal content position: "center" | "bottom"
    var slval: int      // Slider current value (-1 = not a Slider); min/max travel with it
    var slmin: int      // Slider minimum (>= 0)
    var slmax: int      // Slider maximum
    var slstep: int     // Slider step: snap value to multiples of this (0 = continuous)
    var seli: int       // Select selected option index (-1 = not a Select)
    var avis: int       // Alert visible: 1 shown, 0 hidden (-1 = not an Alert)
    var resize: string  // Image resize mode: "cover" | "contain" | "center" ("" = default)
    var prog: int       // Progress bar fill percent 0-100 (-1 = not a Progress)
    var rfsh: int       // Scroll pull-to-refresh: -1 none, 0 idle, 1 refreshing
    var dpmode: string  // DatePicker mode: "date" | "time" | "datetime" ("" = not a DatePicker)
    var dpdisp: string  // DatePicker display: "" (compact field) | "inline" (always-open) | "wheels"
    var tx: int         // transform translateX (px, default 0)
    var ty: int         // transform translateY (px, default 0)
    var rot: int        // transform rotation (degrees, default 0)
    var scl: int        // transform scale as a percent (100 = 1.0)
    var animMs: int     // transition duration in ms for opacity/transform changes (-1 = no animation)
    var animEz: string  // transition easing: "" (ease) | "linear" | "spring"
    var vidPlay: int    // Video playback: 1 play, 0 pause (default 1 = autoplay, backward-compatible)
    var vidLoop: int    // Video loop: 1 loop, 0 play once (default 1)
    var vidMute: int    // Video muted: 1 muted, 0 with sound (default 1)
    var vidFit: string  // Video resize: "" (cover) | "contain"
    var paging: int     // Scroll/List paging: 1 = snap per screen (full-cell), -1 = normal scroll
    // TextInput config ("" / -1 = not set, keep the host default)
    var kbType: string  // keyboard: "email"|"number"|"decimal"|"phone"|"url" ("" = default)
    var retKey: string  // return key: "done"|"send"|"search"|"next"|"go" ("" = default)
    var editable: int   // 0 = not editable, 1 = editable (-1 = default editable)
    var autoFocus: int  // 1 = focus on mount (-1 = no)
    var autoCap: string // "none"|"sentences"|"words"|"characters" ("" = default)
    var autoCorr: int   // 0 = off, 1 = on (-1 = default)
    var maxLen: int     // max characters (-1 = unlimited)
    var stick: int      // Scroll: 1 = stick to bottom (chat) when content grows / keyboard opens (-1 = no)
    var horiz: int      // Scroll/List: 1 = scroll horizontally (a carousel); -1 = vertical (default)
    var nlines: int     // Text: max lines before truncation (-1 = unlimited / wrap freely)
    var ellip: string   // Text truncation: "tail"|"head"|"middle"|"clip" ("" = tail default)
    var disabled: int   // interactive controls: 1 = disabled (dimmed, no press); -1 = enabled
    var tint: string    // Image tintColor (hex): recolor a template image ("" = none)
    var imgFilter: string // Image photo filter preset (mono|sepia|vivid|cool|warm|noir|fade; "" = none)
    var seekTo: int     // Video: seek to this time in seconds when it changes (-1 = no seek)
    var vidCtrls: int   // Video: 1 = show native playback controls (-1 = none)
    var vidVol: int     // Video volume 0-100 (-1 = default, honors `muted`)
    var vidRate: int    // Video playback rate as a percent (100 = 1x; -1 = default)
    var blur: int       // Image blur radius in px (-1 = none)
    var longDelay: int  // Pressable onLongPress delay in ms (-1 = default 500)
    var selectable: int // Text: 1 = user can select/copy the text (-1 = no)
    var hitSlop: int    // Pressable: extra tappable px beyond the visual bounds (-1 = none)
    var spinner: int    // Image: 1 = show a loading spinner until the image loads (-1 = no)
    constructor() {
        this.dir = ""; this.just = ""; this.align = ""
        this.grow = -1; this.basis = -1; this.w = -1; this.h = -1; this.pad = -1; this.padX = -1; this.padY = -1; this.gap = -1
        this.padT = -1; this.padR = -1; this.padB = -1; this.padL = -1
        this.marT = -1; this.marR = -1; this.marB = -1; this.marL = -1
        this.minW = -1; this.maxW = -1; this.minH = -1; this.maxH = -1
        this.wPct = -1; this.hPct = -1; this.bottom = -1; this.z = -1; this.aspectR = -1
        this.rTL = -1; this.rTR = -1; this.rBR = -1; this.rBL = -1
        this.italic = -1; this.deco = ""; this.txform = ""; this.tracking = -9999; this.leading = -1; this.fontFam = ""
        this.overflow = ""; this.hidden = -1; this.selfAlign = ""; this.bStyle = ""
        this.bg = ""; this.fg = ""; this.fs = -1; this.fw = ""; this.ta = ""; this.img = ""; this.radius = -1
        this.pos = ""; this.top = -1; this.left = -1; this.right = -1
        this.bw = -1; this.bwT = -1; this.bwR = -1; this.bwB = -1; this.bwL = -1; this.bc = ""; this.shadow = -1; this.glass = -1; this.opacity = -1; this.wrap = ""; this.font = ""; this.vid = ""
        this.swOn = -1; this.swThumb = ""; this.press = -1; this.sec = -1
        this.sbHide = -1; this.sbStyle = ""; this.sbColor = ""; this.sbNavColor = ""
        this.mvis = -1; this.mpos = ""
        this.slval = -1; this.slmin = 0; this.slmax = 100; this.slstep = 0
        this.seli = -1; this.avis = -1; this.resize = ""; this.prog = -1; this.rfsh = -1
        this.dpmode = ""; this.dpdisp = ""
        this.tx = 0; this.ty = 0; this.rot = 0; this.scl = 100; this.animMs = -1; this.animEz = ""
        this.vidPlay = -1; this.vidLoop = -1; this.vidMute = -1; this.vidFit = ""; this.paging = -1
        this.kbType = ""; this.retKey = ""; this.editable = -1; this.autoFocus = -1
        this.autoCap = ""; this.autoCorr = -1; this.maxLen = -1; this.stick = -1; this.horiz = -1
        this.nlines = -1; this.ellip = ""; this.disabled = -1
        this.tint = ""; this.imgFilter = ""; this.seekTo = -1; this.vidCtrls = -1
        this.vidVol = -1; this.vidRate = -1; this.blur = -1; this.longDelay = -1
        this.selectable = -1; this.hitSlop = -1; this.spinner = -1
    }
    // Serialize the set fields into the host's compact "k=v;" style string. Only
    // non-default fields are emitted, so unchanged styles diff to nothing.
    public str(): string {
        var s: string = ""
        if (this.dir != "") { s = s + "d=" + this.dir + ";" }
        if (this.just != "") { s = s + "j=" + this.just + ";" }
        if (this.align != "") { s = s + "a=" + this.align + ";" }
        if (this.grow >= 0) { s = s + "g=" + string(this.grow) + ";" }
        if (this.basis >= 0) { s = s + "basis=" + string(this.basis) + ";" }
        if (this.w >= 0) { s = s + "w=" + string(this.w) + ";" }
        if (this.h >= 0) { s = s + "h=" + string(this.h) + ";" }
        if (this.pad >= 0) { s = s + "p=" + string(this.pad) + ";" }
        if (this.padX >= 0) { s = s + "px=" + string(this.padX) + ";" }
        if (this.padY >= 0) { s = s + "py=" + string(this.padY) + ";" }
        if (this.padT >= 0) { s = s + "pt=" + string(this.padT) + ";" }
        if (this.padR >= 0) { s = s + "pr=" + string(this.padR) + ";" }
        if (this.padB >= 0) { s = s + "pb=" + string(this.padB) + ";" }
        if (this.padL >= 0) { s = s + "pl=" + string(this.padL) + ";" }
        if (this.marT >= 0) { s = s + "mt=" + string(this.marT) + ";" }
        if (this.marR >= 0) { s = s + "mr=" + string(this.marR) + ";" }
        if (this.marB >= 0) { s = s + "mb=" + string(this.marB) + ";" }
        if (this.marL >= 0) { s = s + "ml=" + string(this.marL) + ";" }
        if (this.minW >= 0) { s = s + "minw=" + string(this.minW) + ";" }
        if (this.maxW >= 0) { s = s + "maxw=" + string(this.maxW) + ";" }
        if (this.minH >= 0) { s = s + "minh=" + string(this.minH) + ";" }
        if (this.maxH >= 0) { s = s + "maxh=" + string(this.maxH) + ";" }
        if (this.wPct >= 0) { s = s + "wpct=" + string(this.wPct) + ";" }
        if (this.hPct >= 0) { s = s + "hpct=" + string(this.hPct) + ";" }
        if (this.bottom >= 0) { s = s + "bottom=" + string(this.bottom) + ";" }
        if (this.z >= 0) { s = s + "z=" + string(this.z) + ";" }
        if (this.aspectR >= 0) { s = s + "aspect=" + string(this.aspectR) + ";" }
        if (this.rTL >= 0) { s = s + "rtl=" + string(this.rTL) + ";" }
        if (this.rTR >= 0) { s = s + "rtr=" + string(this.rTR) + ";" }
        if (this.rBR >= 0) { s = s + "rbr=" + string(this.rBR) + ";" }
        if (this.rBL >= 0) { s = s + "rbl=" + string(this.rBL) + ";" }
        if (this.italic >= 0) { s = s + "italic=" + string(this.italic) + ";" }
        if (this.deco != "") { s = s + "deco=" + this.deco + ";" }
        if (this.txform != "") { s = s + "txform=" + this.txform + ";" }
        if (this.tracking != -9999) { s = s + "tracking=" + string(this.tracking) + ";" }
        if (this.leading >= 0) { s = s + "leading=" + string(this.leading) + ";" }
        if (this.fontFam != "") { s = s + "fontfam=" + this.fontFam + ";" }
        if (this.overflow != "") { s = s + "overflow=" + this.overflow + ";" }
        if (this.hidden >= 0) { s = s + "hidden=" + string(this.hidden) + ";" }
        if (this.selfAlign != "") { s = s + "self=" + this.selfAlign + ";" }
        if (this.bStyle != "") { s = s + "bstyle=" + this.bStyle + ";" }
        if (this.gap >= 0) { s = s + "gap=" + string(this.gap) + ";" }
        if (this.bg != "") { s = s + "bg=" + this.bg + ";" }
        if (this.fg != "") { s = s + "fg=" + this.fg + ";" }
        if (this.fs >= 0) { s = s + "fs=" + string(this.fs) + ";" }
        if (this.fw != "") { s = s + "fw=" + this.fw + ";" }
        if (this.ta != "") { s = s + "ta=" + this.ta + ";" }
        if (this.img != "") { s = s + "img=" + this.img + ";" }
        if (this.radius >= 0) { s = s + "r=" + string(this.radius) + ";" }
        if (this.pos != "") { s = s + "pos=" + this.pos + ";" }
        if (this.top >= 0) { s = s + "top=" + string(this.top) + ";" }
        if (this.left >= 0) { s = s + "left=" + string(this.left) + ";" }
        if (this.right >= 0) { s = s + "right=" + string(this.right) + ";" }
        if (this.bw >= 0) { s = s + "bw=" + string(this.bw) + ";" }
        if (this.bwT >= 0) { s = s + "bwt=" + string(this.bwT) + ";" }
        if (this.bwR >= 0) { s = s + "bwr=" + string(this.bwR) + ";" }
        if (this.bwB >= 0) { s = s + "bwb=" + string(this.bwB) + ";" }
        if (this.bwL >= 0) { s = s + "bwl=" + string(this.bwL) + ";" }
        if (this.bc != "") { s = s + "bc=" + this.bc + ";" }
        if (this.shadow >= 0) { s = s + "shadow=" + string(this.shadow) + ";" }
        if (this.glass >= 0) { s = s + "glass=" + string(this.glass) + ";" }
        if (this.opacity >= 0) { s = s + "opacity=" + string(this.opacity) + ";" }
        if (this.wrap != "") { s = s + "wrap=" + this.wrap + ";" }
        if (this.font != "") { s = s + "font=" + this.font + ";" }
        if (this.vid != "") { s = s + "vid=" + this.vid + ";" }
        // Video-only: always emit when set (>=0) so toggling `playing` back on re-applies
        // (a removed key would never resume). -1 = not a Video, stays out of every other style.
        if (this.vidPlay >= 0) { s = s + "vplay=" + string(this.vidPlay) + ";" }
        if (this.vidLoop >= 0) { s = s + "vloop=" + string(this.vidLoop) + ";" }
        if (this.vidMute >= 0) { s = s + "vmute=" + string(this.vidMute) + ";" }
        if (this.vidFit != "") { s = s + "vfit=" + this.vidFit + ";" }
        if (this.paging >= 0) { s = s + "paging=" + string(this.paging) + ";" }
        if (this.kbType != "") { s = s + "kbt=" + this.kbType + ";" }
        if (this.retKey != "") { s = s + "ret=" + this.retKey + ";" }
        if (this.editable >= 0) { s = s + "edit=" + string(this.editable) + ";" }
        if (this.autoFocus >= 0) { s = s + "afoc=" + string(this.autoFocus) + ";" }
        if (this.autoCap != "") { s = s + "acap=" + this.autoCap + ";" }
        if (this.autoCorr >= 0) { s = s + "acor=" + string(this.autoCorr) + ";" }
        if (this.maxLen >= 0) { s = s + "maxlen=" + string(this.maxLen) + ";" }
        if (this.stick >= 0) { s = s + "stick=" + string(this.stick) + ";" }
        if (this.horiz >= 0) { s = s + "horiz=" + string(this.horiz) + ";" }
        if (this.nlines >= 0) { s = s + "nlines=" + string(this.nlines) + ";" }
        if (this.ellip != "") { s = s + "ellip=" + this.ellip + ";" }
        if (this.disabled >= 0) { s = s + "dis=" + string(this.disabled) + ";" }
        if (this.tint != "") { s = s + "tint=" + this.tint + ";" }
        if (this.imgFilter != "") { s = s + "filt=" + this.imgFilter + ";" }
        if (this.seekTo >= 0) { s = s + "seek=" + string(this.seekTo) + ";" }
        if (this.vidCtrls >= 0) { s = s + "vctrl=" + string(this.vidCtrls) + ";" }
        if (this.vidVol >= 0) { s = s + "vvol=" + string(this.vidVol) + ";" }
        if (this.vidRate >= 0) { s = s + "vrate=" + string(this.vidRate) + ";" }
        if (this.blur >= 0) { s = s + "blur=" + string(this.blur) + ";" }
        if (this.longDelay >= 0) { s = s + "ldelay=" + string(this.longDelay) + ";" }
        if (this.selectable >= 0) { s = s + "sel=" + string(this.selectable) + ";" }
        if (this.hitSlop >= 0) { s = s + "hitslop=" + string(this.hitSlop) + ";" }
        if (this.spinner >= 0) { s = s + "spin=" + string(this.spinner) + ";" }
        if (this.swOn >= 0) { s = s + "on=" + string(this.swOn) + ";" }
        if (this.swThumb != "") { s = s + "swtc=" + this.swThumb + ";" }
        if (this.press >= 0) { s = s + "press=" + string(this.press) + ";" }
        if (this.sec >= 0) { s = s + "sec=" + string(this.sec) + ";" }
        if (this.sbHide >= 0) { s = s + "sbh=" + string(this.sbHide) + ";" }
        if (this.sbStyle != "") { s = s + "sbstyle=" + this.sbStyle + ";" }
        if (this.sbColor != "") { s = s + "sbcolor=" + this.sbColor + ";" }
        if (this.sbNavColor != "") { s = s + "sbnavcolor=" + this.sbNavColor + ";" }
        if (this.mvis >= 0) { s = s + "mvis=" + string(this.mvis) + ";" }
        if (this.mpos != "") { s = s + "mpos=" + this.mpos + ";" }
        if (this.slval >= 0) {                       // a Slider: RANGE before value, so the host sets
            s = s + "slmin=" + string(this.slmin) + ";"   // min/max first — else UISlider clamps the
            s = s + "slmax=" + string(this.slmax) + ";"   // value to its default max (1.0) on first mount.
            if (this.slstep > 0) { s = s + "slstep=" + string(this.slstep) + ";" }
            s = s + "slv=" + string(this.slval) + ";"
        }
        if (this.seli >= 0) { s = s + "seli=" + string(this.seli) + ";" }
        if (this.avis >= 0) { s = s + "avis=" + string(this.avis) + ";" }
        if (this.resize != "") { s = s + "rmode=" + this.resize + ";" }
        if (this.prog >= 0) { s = s + "prog=" + string(this.prog) + ";" }
        if (this.rfsh >= 0) { s = s + "rfsh=" + string(this.rfsh) + ";" }
        if (this.dpmode != "") { s = s + "dp=" + this.dpmode + ";" }
        if (this.dpdisp != "") { s = s + "dpd=" + this.dpdisp + ";" }
        if (this.tx != 0) { s = s + "tx=" + string(this.tx) + ";" }
        if (this.ty != 0) { s = s + "ty=" + string(this.ty) + ";" }
        if (this.rot != 0) { s = s + "rot=" + string(this.rot) + ";" }
        if (this.scl != 100) { s = s + "sc=" + string(this.scl) + ";" }
        if (this.animMs >= 0) { s = s + "anim=" + string(this.animMs) + ";" }
        if (this.animEz != "") { s = s + "ez=" + this.animEz + ";" }
        return s
    }
}

// ---- Node: a view in the tree ----------------------------------------------
export class Node {
    var kind: string    // View | Text | Image | Button | Input | Scroll
    var style: Style
    var text: string
    var action: string  // legacy string tag (still used by the search scaffold)
    var onPress: any     // holds a Prop closure; kept `any` so both event
    var onChange: any    // signatures fit one field (see the Prop union below)
    var data: map[string]ListProp   // List config (count/key/item/rowHeight/gap)
    var kids: []Node
    var comp: any        // kind=="Comp": the component render fn () -> Node (lazy)
    var produced: Node?  // kind=="Comp": last node the component produced (for diffing)
    var ckey: string     // kind=="Comp": explicit identity key (KeyedComp); "" = use path
    // Controlled TextInput: `hasVal` marks the field controlled, `val` is its text.
    // onSubmit/onFocus/onBlur are the extra input events (kept `any` like onPress).
    var hasVal: bool
    var val: string
    var onSubmit: any
    var onFocus: any
    var onBlur: any
    // Pressable/Button gesture events (kept `any` like onPress).
    var onLongPress: any
    var onPressIn: any
    var onPressOut: any
    // Media events (Image/Video): load/error/end are one-shot; progress streams a time value.
    var onLoad: any
    var onError: any
    var onEnd: any
    var onProgress: any
    // Slider: fires once when the drag gesture ENDS (RN onSlidingComplete), with
    // the final value; distinct from onChange which streams during the drag.
    var onSlideDone: any
    // Scroll container: onScroll streams the scroll offset (logical points) as the
    // user scrolls; scrollTo imperatively scrolls to an offset (>= 0 = active).
    var onScroll: any
    var scrollTo: int
    // Image GPU op-chain (a JSON op list from effects.chain); the host runs it on the GPU.
    var opsChain: string
    constructor(kind: string, style: Style, text: string, kids: []Node) {
        this.kind = kind; this.style = style; this.text = text
        this.action = ""; this.onPress = null; this.onChange = null; this.data = {}; this.kids = kids
        this.comp = null; this.produced = null; this.ckey = ""
        this.hasVal = false; this.val = ""; this.onSubmit = null; this.onFocus = null; this.onBlur = null
        this.onLongPress = null; this.onPressIn = null; this.onPressOut = null
        this.onLoad = null; this.onError = null; this.onEnd = null; this.onProgress = null
        this.onSlideDone = null; this.onScroll = null; this.scrollTo = -1; this.opsChain = ""
    }
    // Give a Comp an explicit identity key (chainable): new Counter().key(item.id)
    // (or Comp(Counter).key(id)). Use it when a slot is reused or a loop reorders.
    public key(k: string): Node { this.ckey = k; return this }
    // Produce this node's rendered subtree. A host node is its own output; a
    // Comp(fn) node runs its closure; a class Component subclass overrides this.
    // The reconciler calls render() only for kind=="Comp" nodes.
    public render(): Node { if (this.comp != null) { const f: any = this.comp; return f() } return this }
}

// ---- Node constructors (INTERNAL primitives; the named-prop builders below
//      are the public API). Not exported, so they don't collide with the
//      capitalized public builders when transpiled to Go. -------------------
// Build a container node (native View). Holds children laid out by its Style.
function mkView(style: Style, kids: []Node): Node { return new Node("View", style, "", kids) }
// Build a text node (native Text/label). Self-sizes to its string.
function mkText(style: Style, t: string): Node { return new Node("Text", style, t, []) }
// Build an image node (native Image). Style.img names the SF Symbol / asset.
function mkImage(style: Style): Node { return new Node("Image", style, "", []) }
// Build a button node (native Button) with a text title.
function mkButton(style: Style, t: string): Node { return new Node("Button", style, t, []) }
// Build a text-input node (native Input). `placeholder` is the empty-state hint.
function mkInput(style: Style, placeholder: string): Node { return new Node("Input", style, placeholder, []) }
// Build a multi-line text-area node. Like Input, its text field holds the placeholder.
function mkTextArea(style: Style, placeholder: string): Node { return new Node("TextArea", style, placeholder, []) }
// Build a switch node (native on/off toggle). Style.swOn carries the on-state.
function mkSwitch(style: Style): Node { return new Node("Switch", style, "", []) }
// Build a slider node (native value slider). Style.slval/slmin/slmax carry the range.
function mkSlider(style: Style): Node { return new Node("Slider", style, "", []) }
// Build a select node (native dropdown/menu). Options ride the text field (tab-joined,
// so they survive the stream's |/newline split); Style.seli is the chosen index.
function mkSelect(style: Style, joined: string): Node { return new Node("Select", style, joined, []) }
// Build a date picker node (native date/time picker). The current value rides the
// text channel as an ISO string; Style.dpmode carries the mode. `kind` is
// "DatePicker" (compact field, tap-to-open) or "DatePickerInline" (always-open),
// so each host can pick the right view type at creation.
function mkDatePicker(kind: string, style: Style, value: string): Node { return new Node(kind, style, value, []) }
// Build a menu button. The text channel is tab-joined: parts[0] is the trigger
// label, the rest are the action items (must not contain tab / | / newline).
function mkMenu(style: Style, joined: string): Node { return new Node("Menu", style, joined, []) }
// Build a context-menu wrapper: long-press its children to open an action menu.
// Items ride the text channel tab-joined (same rules as Menu).
function mkContextMenu(style: Style, joined: string, kids: []Node): Node { return new Node("ContextMenu", style, joined, kids) }
// Build a spinner node (native indeterminate activity indicator). w/h = size, fg = color.
function mkSpinner(style: Style): Node { return new Node("Spinner", style, "", []) }
// Build a determinate progress-bar node. Style.prog carries the fill percent (0-100).
function mkProgress(style: Style): Node { return new Node("Progress", style, "", []) }
// Build a status-bar directive node. Renders nothing (0x0); the host reads its
// sbHide/sbStyle and applies them to the real OS status bar.
function mkStatusBar(style: Style): Node { return new Node("StatusBar", style, "", []) }
// Build a modal node. The host renders its children in an OVERLAY layer (scrim +
// content) on top of everything when mvis=1; renders nothing inline.
function mkModal(style: Style, kids: []Node): Node { return new Node("Modal", style, "", kids) }
// Build an alert node: the host presents a NATIVE alert when avis=1. Title / message /
// button labels ride the text field (tab-joined). Renders nothing inline.
function mkAlert(style: Style, joined: string): Node { return new Node("Alert", style, joined, []) }

// ---- Prop value types ------------------------------------------------------
// `Prop` now lives in ./prop.chuks (a leaf module) so tw.chuks can share it
// without a circular import; it is imported at the top of this file.
// A List's config values: sizes/counts (int) plus its row callbacks. These have
// List-specific signatures, so they get their own union, distinct from Prop. The
// last three signatures are for SectionList: rows(s)->int, key(s,r)->string,
// item(s,r,top)->Node; its header(s,top)->Node reuses (int,int)->Node above.
export unionType ListProp = int | bool | function(r: int): string | function(r: int, top: int): Node | function(s: int): int | function(s: int, r: int): string | function(s: int, r: int, top: int): Node | function(r: int): void | function(): void | function(top: int): Node

// ---- Named-prop component builders (the JSX-like API) ----------------------
// Compose with named props + children + closures:
//   Row({ onPress: fn, gap: 12, bg: CARD }, [ Text({ weight: "bold" }, "hi") ])
// Props are a map[string]Prop; missing keys fall through to defaults.

// Read an int prop `k` from the props map, or return `def` if it is absent.
function pInt(p: map[string]Prop, k: string, def: int): int { const v: Prop? = p.get(k); if (v != null) { return int(v) } return def }
// Read a string prop `k` from the props map, or return `def` if it is absent.
function pStr(p: map[string]Prop, k: string, def: string): string { const v: Prop? = p.get(k); if (v != null) { return string(v) } return def }
function pBool(p: map[string]Prop, k: string, def: bool): bool { const v: Prop? = p.get(k); if (v != null) { return v == true } return def }

// ---- Safe-area insets --------------------------------------------------------
// The device safe-area insets (notch/status bar, home indicator, rounded corners),
// reported by each native host. Components pad by these to stay clear of system UI;
// essential for edge-to-edge content (overlays / modals / full-bleed screens).
var _safeTop: int = 0
var _safeRight: int = 0
var _safeBottom: int = 0
var _safeLeft: int = 0
// Called by the host (via the entry's setInsets) whenever the insets are known/change.
export function setSafeInsets(t: int, r: int, b: int, l: int): void {
    _safeTop = t; _safeRight = r; _safeBottom = b; _safeLeft = l
}
export function safeTop(): int { return _safeTop }
export function safeRight(): int { return _safeRight }
export function safeBottom(): int { return _safeBottom }
export function safeLeft(): int { return _safeLeft }
// The scroll viewport height (points) the host last reported. This is the REAL height a
// paging List pages by (screen minus safe areas / chrome), so a full-screen feed should
// size its cells to this, NOT to DeviceInfo.screen (that mismatch offsets every page).
var _vpH: int = 0
export function viewportHeight(): int { return _vpH }
// The cross-axis viewport size the host reports alongside the scroll window: the list's
// WIDTH for a vertical list (used to size grid columns for `numColumns`), or its height for
// a horizontal list. 0 until the host first reports it.
var _vpW: int = 0
export function viewportWidth(): int { return _vpW }
// Read an int config value `k` from a List's ListProp map, or `def` if absent.
function lpInt(d: map[string]ListProp, k: string, def: int): int { const v: ListProp? = d.get(k); if (v != null) { return int(v) } return def }
// Read a BOOLEAN config value `k` (e.g. `horizontal`, `inverted`, `paging`). Accepts a real
// `bool` (the preferred form: `horizontal: true`) and, for back-compat, any non-zero int as
// true — so `horizontal: 5` reads as true rather than silently falling through to false the
// way a `== 1` check would.
function lpBool(d: map[string]ListProp, k: string, def: bool): bool { const v: ListProp? = d.get(k); if (v != null) { return int(v) != 0 } return def }
// Copy the layout/visual props onto a Style. Each pInt/pStr defaults to the
// Style's current value, so an absent prop leaves whatever the builder preset.
function applyLayout(s: Style, p: map[string]Prop): void {
    s.gap = pInt(p, "gap", s.gap)
    s.pad = pInt(p, "pad", s.pad)
    s.padX = pInt(p, "px", s.padX)
    s.padY = pInt(p, "py", s.padY)
    s.padT = pInt(p, "pt", s.padT); s.padR = pInt(p, "pr", s.padR); s.padB = pInt(p, "pb", s.padB); s.padL = pInt(p, "pl", s.padL)
    s.marT = pInt(p, "mt", s.marT); s.marR = pInt(p, "mr", s.marR); s.marB = pInt(p, "mb", s.marB); s.marL = pInt(p, "ml", s.marL)
    s.minW = pInt(p, "minw", s.minW); s.maxW = pInt(p, "maxw", s.maxW); s.minH = pInt(p, "minh", s.minH); s.maxH = pInt(p, "maxh", s.maxH)
    s.wPct = pInt(p, "wpct", s.wPct); s.hPct = pInt(p, "hpct", s.hPct)
    s.bottom = pInt(p, "bottom", s.bottom); s.z = pInt(p, "z", s.z); s.aspectR = pInt(p, "aspect", s.aspectR)
    s.rTL = pInt(p, "rtl", s.rTL); s.rTR = pInt(p, "rtr", s.rTR); s.rBR = pInt(p, "rbr", s.rBR); s.rBL = pInt(p, "rbl", s.rBL)
    s.tracking = pInt(p, "tracking", s.tracking); s.leading = pInt(p, "leading", s.leading)
    s.deco = pStr(p, "deco", s.deco); s.txform = pStr(p, "transform", s.txform); s.fontFam = pStr(p, "fontFamily", s.fontFam)
    s.overflow = pStr(p, "overflow", s.overflow); s.selfAlign = pStr(p, "self", s.selfAlign); s.bStyle = pStr(p, "bstyle", s.bStyle)
    if (p.get("italic") != null) { s.italic = pBool(p, "italic", false) ? 1 : 0 }
    if (p.get("hidden") != null) { s.hidden = pBool(p, "hidden", false) ? 1 : 0 }
    s.w = pInt(p, "w", s.w)
    s.h = pInt(p, "h", s.h)
    s.grow = pInt(p, "grow", s.grow)
    s.basis = pInt(p, "basis", s.basis)
    s.radius = pInt(p, "radius", s.radius)
    s.align = pStr(p, "align", s.align)
    s.just = pStr(p, "justify", s.just)
    s.bg = pStr(p, "bg", s.bg)
    s.fg = pStr(p, "color", s.fg)
    s.fs = pInt(p, "size", s.fs)
    s.fw = pStr(p, "weight", s.fw)
    s.ta = pStr(p, "ta", s.ta)
    if (pBool(p, "abs", false)) { s.pos = "abs" }   // absolute positioning (top/left/right)
    s.top = pInt(p, "top", s.top)
    s.left = pInt(p, "left", s.left)
    s.right = pInt(p, "right", s.right)
    s.dir = pStr(p, "dir", s.dir)               // flex-direction (Row/Column set this too)
    s.bw = pInt(p, "border", s.bw)              // border width
    s.bwT = pInt(p, "borderTop", s.bwT); s.bwR = pInt(p, "borderRight", s.bwR)   // per-side border width
    s.bwB = pInt(p, "borderBottom", s.bwB); s.bwL = pInt(p, "borderLeft", s.bwL)
    s.bc = pStr(p, "borderColor", s.bc)         // border color hex
    s.shadow = pInt(p, "shadow", s.shadow)      // elevation 1..3
    if (p.get("glass") != null) { s.glass = pBool(p, "glass", false) ? 1 : -1 }   // Liquid Glass material
    s.opacity = pInt(p, "opacity", s.opacity)   // 0..100
    s.wrap = pStr(p, "wrap", s.wrap)            // "wrap" | "nowrap"
    s.font = pStr(p, "font", s.font)            // custom font family (icon fonts)
    // Animation: transform props (visual only, no layout) + a transition duration.
    s.tx = pInt(p, "tx", s.tx)                  // translateX px
    s.ty = pInt(p, "ty", s.ty)                  // translateY px
    s.rot = pInt(p, "rotate", s.rot)            // rotation degrees
    s.scl = pInt(p, "scale", s.scl)             // scale percent (100 = 1.0)
    s.animMs = pInt(p, "anim", s.animMs)        // transition duration ms (-1 = none)
    s.animEz = pStr(p, "easing", s.animEz)      // "" ease | "linear" | "spring"
}
// Wire onPress / onChange closures from a props map onto a node. The Reconciler
// registers them by node id and calls them when the native event fires.
function applyEvents(n: Node, p: map[string]Prop): void {
    const op: Prop? = p.get("onPress"); if (op != null) { n.onPress = op }
    const oc: Prop? = p.get("onChange"); if (oc != null) { n.onChange = oc }
    const ol: Prop? = p.get("onLongPress"); if (ol != null) { n.onLongPress = ol }
    const oi: Prop? = p.get("onPressIn"); if (oi != null) { n.onPressIn = oi }
    const oo: Prop? = p.get("onPressOut"); if (oo != null) { n.onPressOut = oo }
}
// Wire media events (Image/Video): onLoad/onError/onEnd fire once; onProgress streams a time.
function applyMediaEvents(n: Node, p: map[string]Prop): void {
    const ld: Prop? = p.get("onLoad"); if (ld != null) { n.onLoad = ld }
    const er: Prop? = p.get("onError"); if (er != null) { n.onError = er }
    const en: Prop? = p.get("onEnd"); if (en != null) { n.onEnd = en }
    const pr: Prop? = p.get("onProgress"); if (pr != null) { n.onProgress = pr }
}
/**
 * A horizontal row (flex-direction: row): lays its children left-to-right.
 *
 * Props: `gap`, `pad`, `align` ("start"|"center"|"end"|"stretch"),
 * `justify` ("start"|"center"|"end"|"between"|"around"), `bg`, `radius`,
 * `w`, `h`, `grow`, `onPress`.
 *
 * ```chuks
 * Row({ align: "center", justify: "between", gap: 12 }, [
 *     Text({ weight: "bold", size: 16 }, "Title"),
 *     Button({ onPress: onOpen }, "Open"),
 * ])
 * ```
 */
// ── Typed component props ────────────────────────────────────────────────────
// ViewProps is the shared, all-optional prop bag: every layout field, a Tailwind
// `tw` string, and events. Per-component types EMBED it and add their own fields
// (TextProps adds the text-only props). Because a builder's param is a typed
// dataType, the literal `{...}` at the call site is checked: keys autocomplete,
// unknown keys (typos) are rejected, and each value is type-checked — and the
// caller imports nothing but the component. Inside, a builder hands the props
// (as `any`) to the shared applyLayoutV/applyEventsV, which read fields BY KEY (a
// dataType is map-backed), so one pair of helpers serves every typed builder.
dataType LayoutProps {
    gap: int?; pad: int?; px: int?; py: int?; w: int?; h: int?; grow: int?; basis: int?; radius: int?;
    align: string?; justify: string?; bg: string?; color: string?; size: int?;
    weight: string?; ta: string?; abs: bool?; top: int?; left: int?; right: int?;
    dir: string?; border: int?; borderColor: string?; shadow: int?; glass: bool?;
    opacity: int?; wrap: string?; font: string?; tx: int?; ty: int?; rotate: int?;
    scale: int?; anim: int?; easing: string?; tw: string?;
    // Per-side padding + margins (px/py are the axes; pt/pr/pb/pl are the sides).
    pt: int?; pr: int?; pb: int?; pl: int?; mt: int?; mr: int?; mb: int?; ml: int?;
    // Min/max size, percentage size, bottom offset, z-index, aspect ratio.
    minw: int?; maxw: int?; minh: int?; maxh: int?; wpct: int?; hpct: int?; bottom: int?; z: int?; aspect: int?;
    // Per-corner radius.
    rtl: int?; rtr: int?; rbr: int?; rbl: int?;
    // Per-side border widths + border style.
    borderTop: int?; borderRight: int?; borderBottom: int?; borderLeft: int?; bstyle: string?;
    // Typography extras, box overflow, self-align, hidden/italic toggles.
    tracking: int?; leading: int?; deco: string?; transform: string?; fontFamily: string?;
    overflow: string?; self: string?; hidden: bool?; italic: bool?;
}
dataType EventProps {
    onPress: (function(): void)?; onChange: (function(v: string): void)?;
    onLongPress: (function(): void)?; onPressIn: (function(): void)?; onPressOut: (function(): void)?;
}
export dataType ViewProps { LayoutProps; EventProps }
export dataType TextProps { ViewProps; numberOfLines: int?; ellipsizeMode: string?; selectable: bool? }

// By-key field readers over an `any` (a map-backed dataType), mirroring pInt/pStr/pBool.
function pvI(p: any, k: string, d: int): int { const v: any = p[k]; return v != null ? int(v) : d }
function pvS(p: any, k: string, d: string): string { const v: any = p[k]; return v != null ? string(v) : d }
function pvB(p: any, k: string, d: bool): bool { const v: any = p[k]; return v != null ? (int(v) != 0) : d }

// The typed-props twin of applyLayout: a Tailwind `tw` string first (so explicit
// props override it), then every layout field by key. Serves all typed builders.
function applyLayoutV(s: Style, p: any): void {
    const tws: any = p["tw"]; if (tws != null) { applyLayout(s, tw(string(tws))) }
    s.gap = pvI(p, "gap", s.gap)
    s.pad = pvI(p, "pad", s.pad)
    s.padX = pvI(p, "px", s.padX)
    s.padY = pvI(p, "py", s.padY)
    s.padT = pvI(p, "pt", s.padT); s.padR = pvI(p, "pr", s.padR); s.padB = pvI(p, "pb", s.padB); s.padL = pvI(p, "pl", s.padL)
    s.marT = pvI(p, "mt", s.marT); s.marR = pvI(p, "mr", s.marR); s.marB = pvI(p, "mb", s.marB); s.marL = pvI(p, "ml", s.marL)
    s.minW = pvI(p, "minw", s.minW); s.maxW = pvI(p, "maxw", s.maxW); s.minH = pvI(p, "minh", s.minH); s.maxH = pvI(p, "maxh", s.maxH)
    s.wPct = pvI(p, "wpct", s.wPct); s.hPct = pvI(p, "hpct", s.hPct)
    s.bottom = pvI(p, "bottom", s.bottom); s.z = pvI(p, "z", s.z); s.aspectR = pvI(p, "aspect", s.aspectR)
    s.rTL = pvI(p, "rtl", s.rTL); s.rTR = pvI(p, "rtr", s.rTR); s.rBR = pvI(p, "rbr", s.rBR); s.rBL = pvI(p, "rbl", s.rBL)
    s.tracking = pvI(p, "tracking", s.tracking); s.leading = pvI(p, "leading", s.leading)
    s.deco = pvS(p, "deco", s.deco); s.txform = pvS(p, "transform", s.txform); s.fontFam = pvS(p, "fontFamily", s.fontFam)
    s.overflow = pvS(p, "overflow", s.overflow); s.selfAlign = pvS(p, "self", s.selfAlign); s.bStyle = pvS(p, "bstyle", s.bStyle)
    if (p["italic"] != null) { s.italic = pvB(p, "italic", false) ? 1 : 0 }
    if (p["hidden"] != null) { s.hidden = pvB(p, "hidden", false) ? 1 : 0 }
    s.w = pvI(p, "w", s.w)
    s.h = pvI(p, "h", s.h)
    s.grow = pvI(p, "grow", s.grow)
    s.basis = pvI(p, "basis", s.basis)
    s.radius = pvI(p, "radius", s.radius)
    s.align = pvS(p, "align", s.align)
    s.just = pvS(p, "justify", s.just)
    s.bg = pvS(p, "bg", s.bg)
    s.fg = pvS(p, "color", s.fg)
    s.fs = pvI(p, "size", s.fs)
    s.fw = pvS(p, "weight", s.fw)
    s.ta = pvS(p, "ta", s.ta)
    if (pvB(p, "abs", false)) { s.pos = "abs" }
    s.top = pvI(p, "top", s.top)
    s.left = pvI(p, "left", s.left)
    s.right = pvI(p, "right", s.right)
    s.dir = pvS(p, "dir", s.dir)
    s.bw = pvI(p, "border", s.bw)
    s.bwT = pvI(p, "borderTop", s.bwT); s.bwR = pvI(p, "borderRight", s.bwR)
    s.bwB = pvI(p, "borderBottom", s.bwB); s.bwL = pvI(p, "borderLeft", s.bwL)
    s.bc = pvS(p, "borderColor", s.bc)
    s.shadow = pvI(p, "shadow", s.shadow)
    if (p["glass"] != null) { s.glass = pvB(p, "glass", false) ? 1 : -1 }
    s.opacity = pvI(p, "opacity", s.opacity)
    s.wrap = pvS(p, "wrap", s.wrap)
    s.font = pvS(p, "font", s.font)
    s.tx = pvI(p, "tx", s.tx)
    s.ty = pvI(p, "ty", s.ty)
    s.rot = pvI(p, "rotate", s.rot)
    s.scl = pvI(p, "scale", s.scl)
    s.animMs = pvI(p, "anim", s.animMs)
    s.animEz = pvS(p, "easing", s.animEz)
}
function applyEventsV(n: Node, p: any): void {
    const a: any = p["onPress"]; if (a != null) { n.onPress = a }
    const b: any = p["onChange"]; if (b != null) { n.onChange = b }
    const c: any = p["onLongPress"]; if (c != null) { n.onLongPress = c }
    const d: any = p["onPressIn"]; if (d != null) { n.onPressIn = d }
    const e: any = p["onPressOut"]; if (e != null) { n.onPressOut = e }
}
function applyMediaEventsV(n: Node, p: any): void {
    const ld: any = p["onLoad"]; if (ld != null) { n.onLoad = ld }
    const er: any = p["onError"]; if (er != null) { n.onError = er }
    const en: any = p["onEnd"]; if (en != null) { n.onEnd = en }
    const pr: any = p["onProgress"]; if (pr != null) { n.onProgress = pr }
}
// Media event fields, embedded by media component prop types (Image/Video).
dataType MediaEventProps {
    onLoad: (function(): void)?; onError: (function(): void)?;
    onEnd: (function(): void)?; onProgress: (function(v: int): void)?;
}

export function Row(first: ViewProps | []Node, kids: []Node = []): Node {
    const s: Style = new Style(); s.dir = "row"
    // props-or-content: `Row([...])` (no config) passes children first; `Row({...}, [...])`
    // passes props then children. Discriminate by type — an array is content, a `{...}` is props.
    if (typeof(first) == "array") { const c: []Node = first; return mkView(s, c) }
    const p: ViewProps = first  // typeof-guard narrowed the union to its dataType arm
    applyLayoutV(s, p); const n: Node = mkView(s, kids); applyEventsV(n, p); return n
}
/**
 * A vertical column (flex-direction: col): lays its children top-to-bottom.
 *
 * Props: `gap`, `pad`, `align`, `justify`, `bg`, `radius`, `grow`, `onPress`.
 *
 * ```chuks
 * Column({ gap: 6 }, [
 *     Text({ weight: "semibold", size: 13 }, "Email"),
 *     TextInput({ placeholder: "you@example.com" }),
 * ])
 * ```
 */
export function Column(first: ViewProps | []Node, kids: []Node = []): Node {
    const s: Style = new Style(); s.dir = "col"; s.just = "center"
    // props-or-content (see Row): `Column([...])` or `Column({...}, [...])`.
    if (typeof(first) == "array") { const c: []Node = first; return mkView(s, c) }
    const p: ViewProps = first  // narrowed to the dataType arm
    applyLayoutV(s, p); const n: Node = mkView(s, kids); applyEventsV(n, p); return n
}
/**
 * A plain box (the base container). No default direction or alignment — just the
 * layout/visual props you set (`w`, `h`, `bg`, `radius`, `grow`, `pad`, `gap`,
 * `align`, `justify`, `border`, ...). Use it for spacers, fills, and simple surfaces;
 * reach for `Column`/`Row` when you want a stacking direction by default.
 *
 * ```chuks
 * View({ w: 44, h: 44, radius: 22, bg: tk("primary") }, [])
 * ```
 */
export function View(first: ViewProps | []Node, kids: []Node = []): Node {
    if (typeof(first) == "array") { return View({}, first) }   // content-only: `View([...])`
    const p: ViewProps = first
    const s: Style = new Style(); applyLayoutV(s, p)
    const n: Node = mkView(s, kids); applyEventsV(n, p); return n
}
/**
 * A run of text; `t` is the string to display. Text self-sizes to its content.
 *
 * Props: `size` (px), `weight` ("regular"|"semibold"|"bold"), `color` (hex),
 * `ta` (text-align "left"|"center"|"right").
 *
 * ```chuks
 * Text({ size: 30, weight: "bold", color: FG }, "Welcome back")
 * ```
 */
export function Text(first: TextProps | string, body: string = ""): Node {
    const s: Style = new Style()
    // props-or-content: `Text("Hello")` (no config) passes the string first; `Text({...}, "Hello")`
    // passes props then the string. Discriminate by type — a string is content, a `{...}` is props.
    if (typeof(first) == "string") { const t: string = first; return mkText(s, t) }
    const p: TextProps = first                               // narrowed to the dataType arm: typed field access
    applyLayoutV(s, p)
    s.nlines = p.numberOfLines ?? -1                         // cap lines (truncates the overflow)
    s.ellip = p.ellipsizeMode ?? ""                          // "tail"|"head"|"middle"|"clip"
    if (p.selectable ?? false) { s.selectable = 1 }          // user can select/copy the text
    const n: Node = mkText(s, body)
    applyEventsV(n, p)                                        // onPress makes the text tappable (a link)
    return n
}
/**
 * A circular icon backed by an SF Symbol.
 *
 * Props: `name` (SF Symbol id, e.g. "bolt.fill"), `size` (px; also the circle
 * diameter), `bg` (circle fill hex), `color` (glyph hex, default white).
 *
 * ```chuks
 * Icon({ name: "bolt.fill", size: 40, bg: ACCENT })
 * ```
 */
/**
 * A looping, muted video surface (native AVPlayer / ExoPlayer). `src` is a
 * bundled video filename. Only mounted (visible) videos play, so a virtualized
 * List keeps just the on-screen ones alive.
 *
 * ```chuks
 * Video({ src: "sample.mp4", h: 320, radius: 12 })
 * ```
 */
/**
 * A video surface. Controllable like RN's Video so you can compose a feed: put one in
 * each cell of a paging List and drive `playing` from the visible index.
 * Props: `src` (bundled name, "file://…", or http(s) URL), `playing` (default true),
 * `loop` (default true), `muted` (default true), `resizeMode` ("cover" | "contain").
 */
dataType VideoProps {
    ViewProps; MediaEventProps;
    src: string?; playing: bool?; loop: bool?; muted: bool?; resizeMode: string?;
    seek: int?; volume: int?; rate: int?; controls: bool?; poster: string?;
}
export function Video(p: VideoProps): Node {
    const s: Style = new Style(); applyLayoutV(s, p)
    s.vid = pvS(p, "src", "")
    // Always set (default on) so these are emitted for every Video and stay controllable.
    s.vidPlay = pvB(p, "playing", true) ? 1 : 0
    s.vidLoop = pvB(p, "loop", true) ? 1 : 0
    s.vidMute = pvB(p, "muted", true) ? 1 : 0
    s.vidFit = pvS(p, "resizeMode", "cover")
    s.seekTo = pvI(p, "seek", -1)                         // seek to N seconds when this changes
    s.vidVol = pvI(p, "volume", -1)                       // 0-100
    s.vidRate = pvI(p, "rate", -1)                        // playback speed percent (100 = 1x)
    const controls: bool = pvB(p, "controls", false)
    if (p["controls"] != null) { s.vidCtrls = controls ? 1 : 0 }
    // A video with `controls` renders the platform's full native player UI (transport, scrubber,
    // fullscreen, AirPlay, PiP, subtitle/audio menus), so it's a distinct kind the host maps to
    // AVPlayerViewController / VideoPlayer / a MediaController-backed view.
    // The node text carries an optional `poster` image URL shown until the first frame plays.
    const n: Node = new Node(controls ? "VideoControls" : "Video", s, pvS(p, "poster", ""), [])
    applyMediaEventsV(n, p)                               // onLoad / onEnd / onProgress
    return n
}
dataType IconProps { ViewProps; name: string? }
export function Icon(p: IconProps): Node {
    const s: Style = new Style()
    const sz: int = pvI(p, "size", 24); s.w = sz; s.h = sz; s.radius = sz / 2
    s.bg = pvS(p, "bg", "")
    s.img = pvS(p, "name", ""); s.fg = pvS(p, "color", "FFFFFF")
    return mkImage(s)
}
/**
 * A remote (network) image loaded from a URL. The host fetches + caches the
 * bytes asynchronously and shows them; give it a size (`w`/`h`) and optional
 * `radius`. `resize`: "cover" (fill, crop — default), "contain" (fit), "center".
 * (For a local SF Symbol icon use `Icon`/`name` instead.) The URL rides the text
 * channel, so it may not contain a newline or "|".
 *
 * Props: `src` (URL), `w`, `h`, `radius`, `resize`, `bg` (placeholder color),
 *   `tintColor`, `blurRadius`, `spinner`, and `filter` — a GPU photo-filter preset
 *   (`mono` | `noir` | `sepia` | `vivid` | `cool` | `warm` | `fade`; `normal` = none),
 *   applied natively via Core Image (iOS) / a ColorMatrix on the hardware layer (Android).
 *
 * ```chuks
 * Image({ src: "https://picsum.photos/200", w: 96, h: 96, radius: 12, filter: "vivid" })
 * ```
 */
dataType ImageProps {
    ViewProps; MediaEventProps;
    src: string?; resize: string?; tintColor: string?; blurRadius: int?;
    filter: string?; spinner: bool?; ops: string?;
}
export function Image(p: ImageProps): Node {
    const s: Style = new Style()
    s.resize = pvS(p, "resize", "cover")
    s.bg = pvS(p, "bg", "")
    s.tint = pvS(p, "tintColor", "")                      // recolor a template image
    s.blur = pvI(p, "blurRadius", -1)                     // blur the image (px)
    s.imgFilter = pvS(p, "filter", "")                    // photo filter preset (mono|sepia|vivid|cool|warm|noir|fade)
    if (pvB(p, "spinner", false)) { s.spinner = 1 }       // show a loading spinner until it loads
    if (p["radius"] != null) { s.radius = pvI(p, "radius", 0) }
    applyLayoutV(s, p)
    const n: Node = new Node("Image", s, pvS(p, "src", ""), [])   // URL in the text channel
    n.opsChain = pvS(p, "ops", "")                        // GPU op-chain (from effects.chain); host runs it on the GPU
    applyMediaEventsV(n, p)                               // onLoad / onError
    return n
}
/**
 * A container whose BACKGROUND is a remote image, with `kids` rendered on top
 * (like RN's ImageBackground). The host loads the URL and paints it behind the
 * content; `resize` controls the fill mode.
 *
 * Props: `src` (URL), `resize`, plus layout (`pad`, `gap`, `w`, `h`, `radius`).
 *
 * ```chuks
 * ImageBackground({ src: HERO_URL, pad: 24, radius: 16 }, [ Text(...), ... ])
 * ```
 */
dataType ImageBackgroundProps { ViewProps; src: string?; resize: string? }
export function ImageBackground(first: ImageBackgroundProps | []Node, kids: []Node = []): Node {
    if (typeof(first) == "array") { return ImageBackground({}, first) }   // content-only
    const p: ImageBackgroundProps = first
    const s: Style = new Style()
    s.resize = pvS(p, "resize", "cover")
    if (p["radius"] != null) { s.radius = pvI(p, "radius", 0) }
    applyLayoutV(s, p)
    return new Node("ImageBackground", s, pvS(p, "src", ""), kids)   // URL in text; children on top
}
/**
 * A native web view (WKWebView on iOS, android.webkit.WebView on Android) that
 * loads a URL. Give it a size (`w`/`h`) or let it `grow` to fill, plus optional
 * `radius`. The URL rides the text channel, so it may not contain a newline or
 * "|" (fine for normal URLs). (Inline HTML can be added later via encoding.)
 *
 * Props: `url`, `w`, `h`, `grow`, `radius`, `bg`.
 *
 * ```chuks
 * WebView({ url: "https://chuks.dev", grow: 1, radius: 12 })
 * ```
 */
dataType WebViewProps { ViewProps; url: string? }
export function WebView(p: WebViewProps): Node {
    const s: Style = new Style()
    if (p["radius"] != null) { s.radius = pvI(p, "radius", 0) }
    applyLayoutV(s, p)
    return new Node("WebView", s, pvS(p, "url", ""), [])   // URL in the text channel
}

/**
 * A live camera preview surface. `facing` selects the lens: "back" (default) or "front".
 * Needs the "camera" permission (request it with Permission.request("camera", ...) first).
 * On iOS it is a real AVCaptureVideoPreviewLayer over an AVCaptureSession; on Android a
 * Camera2 preview on a TextureView. Grab a still from the running preview with
 * Camera.capturePreview(onResult, onError), which resolves a file:// path you can hand to Image.
 */
dataType CameraViewProps { ViewProps; facing: string? }
export function CameraView(p: CameraViewProps): Node {
    const s: Style = new Style()
    if (p["radius"] != null) { s.radius = pvI(p, "radius", 0) }
    applyLayoutV(s, p)
    return new Node("CameraView", s, pvS(p, "facing", "back"), [])   // facing in the text channel
}
/**
 * A tappable button showing title `t`. Pass `onPress` as a () -> void closure;
 * the framework registers it by node id and calls it on tap.
 *
 * Props: `onPress`, `bg`, `color`, `h`, `w`, `radius`, `size`, `weight`.
 *
 * ```chuks
 * Button({ onPress: function(): void { navReplace("home") },
 *          bg: ACCENT, color: "FFFFFF", h: 52, radius: 12 }, "Log in")
 * ```
 */
dataType ButtonBaseProps { ViewProps; disabled: bool? }
export function Button(first: ButtonBaseProps | string, t: string = ""): Node {
    if (typeof(first) == "string") { return Button({}, first) }   // label-only: `Button("Save")`
    const p: ButtonBaseProps = first
    const s: Style = new Style(); s.fw = "bold"; applyLayoutV(s, p)
    if (p["disabled"] != null) { s.disabled = pvB(p, "disabled", false) ? 1 : 0 }   // dim + block taps
    const n: Node = mkButton(s, t); applyEventsV(n, p); return n
}
/**
 * A small rounded value badge (a compact tappable button). Defaults to 56x36.
 *
 * Props: `w`, `h`, `bg`, `color`, `onPress`.
 *
 * ```chuks
 * Pill({ onPress: function(): void { self.inc() } }, string(this.value))
 * ```
 */
export function Pill(first: ViewProps | string, t: string = ""): Node {
    if (typeof(first) == "string") { return Pill({}, first) }   // label-only: `Pill("New")`
    const p: ViewProps = first
    const s: Style = new Style()
    s.w = pvI(p, "w", 56); s.h = pvI(p, "h", 36); s.radius = 10
    s.bg = pvS(p, "bg", "222A3A"); s.fg = pvS(p, "color", "5B8CFF"); s.fs = 16; s.fw = "bold"
    applyLayoutV(s, p)
    const n: Node = mkButton(s, t); applyEventsV(n, p); return n
}
/**
 * A single-line text field. Pass `onChange` as a (string) -> void closure that
 * receives the current text on every edit. Renders as a light field by default.
 *
 * Props: `placeholder`, `value` (controlled), `onChange` ((string) -> void),
 * `onSubmit` (() -> void, return key), `onFocus`, `onBlur`, `keyboardType`
 * ("email"|"number"|"decimal"|"phone"|"url"), `returnKeyType`
 * ("done"|"send"|"search"|"next"|"go"), `secure`, `multiline`, `editable` (default
 * true), `autoFocus`, `maxLength`, `autoCapitalize` ("none"|"sentences"|"words"|
 * "characters"), `autoCorrect`, `bg`, `color`, `h`.
 *
 * ```chuks
 * // Controlled: the field always shows `draft`; clear it by setting draft to "".
 * TextInput({ value: draft.get(), keyboardType: "email", returnKeyType: "send",
 *             onChange: function(v: string): void { draft.set(v) },
 *             onSubmit: function(): void { send() } })
 * ```
 */
dataType TextInputProps {
    ViewProps;
    placeholder: string?; value: string?; secure: bool?; multiline: bool?;
    keyboardType: string?; returnKeyType: string?; editable: bool?; autoFocus: bool?;
    autoCapitalize: string?; autoCorrect: bool?; maxLength: int?;
    onSubmit: (function(): void)?; onFocus: (function(): void)?; onBlur: (function(): void)?;
}
export function TextInput(p: TextInputProps): Node {
    const s: Style = new Style()
    const multi: bool = pvB(p, "multiline", false)   // a multi-line text area vs a single-line field
    s.h = pvI(p, "h", multi ? 96 : 44); s.bg = pvS(p, "bg", "FFFFFF"); s.radius = 10
    s.fg = pvS(p, "color", "111318"); s.fs = 15; applyLayoutV(s, p)
    if (pvB(p, "secure", false)) { s.sec = 1 }    // password field: mask input
    s.kbType = pvS(p, "keyboardType", "")
    s.retKey = pvS(p, "returnKeyType", "")
    if (p["editable"] != null) { s.editable = pvB(p, "editable", true) ? 1 : 0 }
    if (p["autoFocus"] != null) { s.autoFocus = pvB(p, "autoFocus", false) ? 1 : 0 }
    s.autoCap = pvS(p, "autoCapitalize", "")
    if (p["autoCorrect"] != null) { s.autoCorr = pvB(p, "autoCorrect", true) ? 1 : 0 }
    s.maxLen = pvI(p, "maxLength", -1)
    // multiline swaps the native widget (UITextView / TextEditor / multiline EditText)
    const n: Node = multi ? mkTextArea(s, pvS(p, "placeholder", "")) : mkInput(s, pvS(p, "placeholder", ""))
    // Controlled value: mark it so the reconciler emits the V| channel and the host
    // mirrors the field to it (only when it differs, so the cursor never jumps).
    if (p["value"] != null) { n.hasVal = true; n.val = pvS(p, "value", "") }
    n.onSubmit = p["onSubmit"]
    n.onFocus = p["onFocus"]
    n.onBlur = p["onBlur"]
    applyEventsV(n, p); return n
}
/**
 * A native on/off switch (UISwitch / SwiftUI Toggle / Android Switch/SwitchMaterial).
 * Controlled, like RN's Switch: the parent owns `on` and passes it; `onPress` fires
 * when the user flips it. The host reports the change (dispatch), the parent updates
 * its own state in onPress, and the re-render syncs the control to that state — so
 * the switch always reflects Chuks state, never drifts. `bg` is the on-tint (the
 * track color when on); omit for the platform default.
 *
 * Props: `on` (bool), `onPress` (() -> void), `bg` (on-tint hex),
 *        `thumbColor` (knob color hex), `disabled` (bool: dim + block taps).
 *
 * ```chuks
 * Toggle({ on: enabled, onPress: function(): void { enabled = !enabled }, bg: ACCENT })
 * ```
 */
/**
 * Insets its children clear of the device safe area (notch/status bar, home
 * indicator). Composed from the host-reported insets, so it's cross-platform and
 * needs no host code. Use it for EDGE-TO-EDGE content — a full-bleed screen, or an
 * overlay/modal that spans the whole window. (Regular screens are already inset by
 * the app root, so a SafeAreaView there is a no-op.)
 *
 * Props: `edges` ("top,bottom" default; "all" | "top" | "bottom" | any combination),
 * plus any layout/style prop.
 *
 * ```chuks
 * SafeAreaView({ edges: "bottom" }, [ ...sheet content... ])
 * ```
 */
dataType SafeAreaViewProps { ViewProps; edges: string? }
export function SafeAreaView(first: SafeAreaViewProps | []Node, kids: []Node = []): Node {
    if (typeof(first) == "array") { return SafeAreaView({}, first) }   // content-only (default edges)
    const p: SafeAreaViewProps = first
    const edges: string = pvS(p, "edges", "top,bottom")
    const all: bool = edges.contains("all")
    var out: []Node = []
    if ((all || edges.contains("top")) && _safeTop > 0) { out.push(vSpacer(_safeTop)) }
    for (var i: int = 0; i < kids.length; i = i + 1) { out.push(kids[i]) }
    if ((all || edges.contains("bottom")) && _safeBottom > 0) { out.push(vSpacer(_safeBottom)) }
    // Fill the available space by default (a screen-level wrapper), so a grow child
    // like a Scroll has a bounded height to size into on the Yoga hosts (UIKit/Android).
    // Overridable with grow:0 for a content-sized safe inset (e.g. a bottom bar).
    const s: Style = new Style(); s.dir = "col"; s.grow = 1; applyLayoutV(s, p)
    return mkView(s, out)
}
// A fixed-height empty row (a safe-area spacer).
function vSpacer(h: int): Node { const s: Style = new Style(); s.h = h; return mkView(s, []) }

/**
 * A scroll container: children stack and scroll when they overflow. Grows to fill
 * its parent's main axis. For long UNIFORM lists prefer `List` (which virtualizes);
 * use `Scroll` for a bounded set of mixed content. Vertical by default; pass
 * `horizontal: true` for a left-to-right carousel of mixed content.
 *
 * Props: `horizontal` (bool), `paging` (bool: snap one full screen per swipe),
 * `onRefresh` (() -> void) + `refreshing` (vertical only), `stickBottom` (bool,
 * vertical only), `onScroll` ((offset) -> void), `scrollTo` (int), plus any layout prop.
 *
 * `horizontal: true` + `paging: true` is a full-screen swipe carousel (an onboarding
 * pager, an image gallery): each child is one page, the host snaps to the nearest,
 * and swiping goes both ways. Size each page to `viewportWidth()`. Track the current
 * page with `onScroll` (offset / page width) and jump with `scrollTo`.
 *
 * Like every scroll container, wrap the content in a SINGLE child (a Column for
 * vertical, a Row for horizontal); the host scroll view hosts exactly one child.
 *
 *     Scroll({}, [ Column({ gap: 12 }, [ Text(...), Card(...), Button(...) ]) ])
 *     Scroll({ horizontal: true }, [ Row({ gap: 12 }, [ Card(...), Card(...) ]) ])
 *     Scroll({ horizontal: true, paging: true }, [ Row([ page0, page1, page2 ]) ])
 */
dataType ScrollProps {
    ViewProps; horizontal: bool?; paging: bool?; refreshing: bool?; stickBottom: bool?; scrollTo: int?;
    onRefresh: (function(): void)?; onScroll: (function(v: string): void)?;
}
export function Scroll(first: ScrollProps | []Node, kids: []Node = []): Node {
    // props-or-content: `Scroll([...])` is a default vertical scroll of the given content;
    // `Scroll({...}, [...])` configures it. Discriminate by type (array = content, `{...}` = props).
    if (typeof(first) == "array") {
        const c: []Node = first
        const s0: Style = new Style(); s0.dir = "col"; s0.grow = 1; s0.basis = 0
        return new Node("Scroll", s0, "", c)
    }
    const p: ScrollProps = first  // narrowed to the dataType arm: typed field access below
    // horizontal: a carousel of MIXED content (left-to-right). Renders the host's
    // HScroll (same control horizontal Lists use); children lay out in a row and the
    // content is measured wide, not clamped to the viewport. Vertical is the default.
    const horizontal: bool = p.horizontal ?? false
    const s: Style = new Style()
    if (horizontal) { s.dir = "row"; s.horiz = 1 } else { s.dir = "col" }
    s.grow = 1; s.basis = 0
    // paging: snap one full screen per swipe (a carousel / onboarding pager). Works on both
    // axes; combine with `horizontal` for a left-to-right paged carousel.
    if (p.paging ?? false) { s.paging = 1 }
    applyLayoutV(s, p)
    // Pull-to-refresh: `onRefresh` fires when the user pulls down at the top; the
    // parent owns `refreshing` (set it false when the work is done to end the spinner).
    // Vertical only (a horizontal carousel has no pull-to-refresh).
    const orf: (function(): void)? = horizontal ? null : p.onRefresh
    if (orf != null) { s.rfsh = (p.refreshing ?? false) ? 1 : 0 }
    // stickBottom: a chat transcript stays pinned to the newest message. The host keeps the
    // scroll at the bottom when content grows or the keyboard opens, unless the user has
    // scrolled up to read history.
    if (!horizontal && (p.stickBottom ?? false)) { s.stick = 1 }
    const n: Node = new Node(horizontal ? "HScroll" : "Scroll", s, "", kids)
    if (orf != null) { n.onPress = orf }
    // onScroll(offset) streams the scroll position; scrollTo imperatively scrolls to
    // an offset (logical points) and re-fires whenever the value changes.
    const osc: (function(v: string): void)? = p.onScroll
    if (osc != null) { n.onScroll = osc }
    n.scrollTo = p.scrollTo ?? -1
    return n
}
/**
 * A pressable surface: wraps content and gives instant press feedback (dims to
 * `activeOpacity`% while held), firing `onPress` on release. The RN Pressable /
 * TouchableOpacity. The dim is applied NATIVELY by each host on touch-down (no
 * round-trip to Chuks), so it stays responsive. Put anything inside — a card, a
 * row, an icon. Children stack vertically by default (`dir` overrides).
 *
 * Props: `onPress` (() -> void), `activeOpacity` (0-100, default 60), plus any
 * layout/style prop (bg, radius, pad, gap, dir, align, justify, ...).
 *
 * ```chuks
 * Pressable({ onPress: open, bg: CARD, radius: 12, pad: 16 }, [ Text(...) ])
 * ```
 */
dataType PressableProps { ViewProps; activeOpacity: int?; delayLongPress: int?; hitSlop: int?; disabled: bool? }
export function Pressable(first: PressableProps | []Node, kids: []Node = []): Node {
    if (typeof(first) == "array") { return Pressable({}, first) }   // content-only
    const p: PressableProps = first
    const s: Style = new Style(); s.dir = "col"
    s.press = pvI(p, "activeOpacity", 60)
    s.longDelay = pvI(p, "delayLongPress", -1)            // onLongPress hold time (ms)
    s.hitSlop = pvI(p, "hitSlop", -1)                     // extra tappable px beyond the bounds
    if (p["disabled"] != null) { s.disabled = pvB(p, "disabled", false) ? 1 : 0 }   // dim + block taps
    applyLayoutV(s, p)
    const n: Node = mkView(s, kids)
    applyEventsV(n, p)   // onPress + onLongPress + onPressIn/onPressOut
    return n
}
/**
 * An indeterminate activity spinner (UIActivityIndicatorView / SwiftUI ProgressView
 * / Android ProgressBar). Display-only — it just spins to signal work in progress.
 *
 * Props: `size` (px diameter, default 24), `color` (hex; omit for the platform tint).
 *
 * ```chuks
 * Spinner({ size: 28, color: ACCENT })
 * ```
 */
export function Spinner(p: ViewProps): Node {
    const s: Style = new Style()
    const sz: int = pvI(p, "size", 24)
    s.fg = pvS(p, "color", s.fg)
    applyLayoutV(s, p)
    // `size` is the spinner DIAMETER (w/h), not a font size — set after applyLayout
    // (which reads `size` as fs) so it wins and the spurious fs is cleared.
    s.w = sz; s.h = sz; s.fs = -1
    return mkSpinner(s)
}
/**
 * A determinate progress bar (native UIProgressView / SwiftUI linear ProgressView /
 * horizontal ProgressBar). Display-only; the parent owns `value`. For an
 * indeterminate spinner use `Spinner`.
 *
 * Props: `value` (int), `max` (int, default 100), `color` (fill tint hex), `h` (thickness).
 *
 * ```chuks
 * Progress({ value: pct.get(), max: 100, color: ACCENT })
 * ```
 */
dataType ProgressProps { ViewProps; value: int?; max: int? }
export function Progress(p: ProgressProps): Node {
    const val: int = pvI(p, "value", 0)
    const mx: int = pvI(p, "max", 100)
    var pct: int = mx > 0 ? (val * 100) / mx : 0
    if (pct < 0) { pct = 0 }
    if (pct > 100) { pct = 100 }
    const s: Style = new Style()
    s.fg = pvS(p, "color", "")      // fill tint
    s.h = pvI(p, "h", 6)            // bar thickness
    applyLayoutV(s, p)
    s.prog = pct                    // set after applyLayout (which doesn't touch prog)
    return mkProgress(s)
}
/**
 * Controls the OS status bar (a host-global directive, like RN's StatusBar). Renders
 * nothing — put it anywhere in a screen. `hidden` hides the bar (fullscreen media);
 * `style` forces the content color: "light" (white text, for a dark header), "dark"
 * (dark text), or omit to follow the app theme automatically. `color` sets the bar's
 * background (a hex string, e.g. tk("primary")); on iOS it fills the top safe area,
 * on Android it sets the OS status-bar color.
 *
 * Props: `hidden` (bool, default false), `style` ("light" | "dark", default auto),
 * `color` (hex, default none).
 *
 * ```chuks
 * StatusBar({ hidden: isFullscreen })
 * StatusBar({ style: "light", color: tk("primary") })
 * ```
 */
dataType StatusBarProps { ViewProps; hidden: bool?; style: string?; navColor: string? }
export function StatusBar(p: StatusBarProps): Node {
    const s: Style = new Style()
    s.sbHide = pvB(p, "hidden", false) ? 1 : 0
    s.sbStyle = pvS(p, "style", "")
    s.sbColor = pvS(p, "color", "")
    s.sbNavColor = pvS(p, "navColor", "")
    s.w = 0; s.h = 0
    return mkStatusBar(s)
}
/**
 * A modal overlay: `kids` render on top of everything, over a dimmed scrim, when
 * `visible`. Tapping the scrim fires `onDismiss`. `position` centers the content
 * ("center", a dialog) or pins it to the bottom ("bottom", a sheet). The host owns
 * the overlay layer (z-top, full-screen, scrim), so it sits above the tab bar and
 * spans the safe area. Wrap content in a Card for a dialog / sheet surface.
 *
 * Props: `visible` (bool), `onDismiss` (() -> void), `position` ("center" default |
 * "bottom").
 *
 * ```chuks
 * Modal({ visible: showSheet, onDismiss: close, position: "bottom" }, [
 *     Card({ children: [ Text(...), Button({ ..., onPress: close }) ] }),
 * ])
 * ```
 */
dataType ModalProps { ViewProps; visible: bool?; position: string?; onDismiss: (function(): void)? }
export function Modal(first: ModalProps | []Node, kids: []Node = []): Node {
    if (typeof(first) == "array") { return Modal({}, first) }   // content-only (hidden until visible)
    const p: ModalProps = first
    const vis: bool = pvB(p, "visible", false)
    const s: Style = new Style()
    s.mvis = vis ? 1 : 0
    s.mpos = pvS(p, "position", "center")
    // Hidden: emit the node but with NO children, so the content isn't mounted.
    const n: Node = mkModal(s, vis ? kids : [])
    const od: any = p["onDismiss"]           // scrim tap fires onDismiss (wired as onPress)
    if (od != null) { n.onPress = od }
    return n
}
/**
 * A NATIVE alert / confirm dialog (UIAlertController / SwiftUI .alert / AlertDialog).
 * Declarative like Modal: the parent owns `visible` and passes it; the host presents
 * the OS alert when it flips true. Renders nothing inline.
 *
 * Three shapes, from a shared builder:
 *  - Simple confirm: `confirmText` is the primary button; a non-empty `cancelText`
 *    adds a cancel button; `destructive: true` reddens the confirm button.
 *    `onConfirm` / `onCancel` fire on tap.
 *  - Multi-button: pass `buttons` as a pipe-separated string ("Save|Discard|Cancel").
 *    Prefix a label with `!` for a destructive (red) button or `~` for a cancel-style
 *    button. `onButton` fires with the tapped index (as a string; parse with int()).
 *  - Prompt: `prompt: true` adds a text field (`placeholder`, `promptValue` seed the
 *    it); on confirm, `onSubmit` fires with the entered text.
 *
 * Props: `visible` (bool), `title`, `message`, `confirmText` ("OK"), `cancelText`
 * ("" = single-button), `destructive` (bool), `buttons` (pipe string), `prompt` (bool),
 * `placeholder`, `promptValue`, `onConfirm` (() -> void), `onCancel` (() -> void),
 * `onButton` ((string) -> void), `onSubmit` ((string) -> void).
 *
 * ```chuks
 * Alert({ visible: confirming.get(), title: "Delete?", message: "This can't be undone.",
 *         confirmText: "Delete", cancelText: "Cancel", destructive: true,
 *         onConfirm: function(): void { doDelete(); confirming.set(false) },
 *         onCancel:  function(): void { confirming.set(false) } })
 * ```
 */
dataType AlertProps {
    visible: bool?; title: string?; message: string?;
    confirmText: string?; cancelText: string?; destructive: bool?;
    buttons: string?; prompt: bool?; placeholder: string?; promptValue: string?;
    onConfirm: (function(): void)?; onCancel: (function(): void)?;
    onButton: (function(v: string): void)?; onSubmit: (function(v: string): void)?;
}
export function Alert(p: AlertProps): Node {
    const s: Style = new Style()
    s.avis = pvB(p, "visible", false) ? 1 : 0
    const title: string = pvS(p, "title", "")
    const message: string = pvS(p, "message", "")
    const isPrompt: bool = pvB(p, "prompt", false)
    const placeholder: string = pvS(p, "placeholder", "")
    const promptValue: string = pvS(p, "promptValue", "")
    const buttonsProp: string = pvS(p, "buttons", "")
    // Build the button list in tap-index order. The user API takes `buttons` as a
    // pipe-separated string; internally each button is its own trailing TAB field (the
    // mutation protocol splits ops on '|', so a '|' in the text truncates it). Multi-
    // button: index -> onButton. Simple: [~cancel, confirm] or [confirm], so index
    // 0/last map to onCancel/onConfirm. `!`=destructive, `~`=cancel style.
    var buttonList: []string = []
    var confirmIdx: int = -1
    var cancelIdx: int = -1
    if (buttonsProp != "") {
        buttonList = buttonsProp.split("|")
    } else {
        const confirm: string = pvS(p, "confirmText", "OK")
        const cancel: string = pvS(p, "cancelText", "")
        const confirmLabel: string = (pvB(p, "destructive", false) ? "!" : "") + confirm
        if (cancel != "") { buttonList = ["~" + cancel, confirmLabel]; cancelIdx = 0; confirmIdx = 1 }
        else { buttonList = [confirmLabel]; confirmIdx = 0 }
    }
    var joined: string = title + "\t" + message + "\t" + (isPrompt ? "1" : "0") + "\t" + placeholder + "\t" + promptValue
    for (var bi: int = 0; bi < buttonList.length; bi = bi + 1) { joined = joined + "\t" + buttonList[bi] }
    const n: Node = mkAlert(s, joined)
    // The host reports the tapped button INDEX ("0","1",...), plus "\t<text>" for a
    // prompt. routeAlert (top-level, so its locals don't sit inside the captured
    // closure and miscompile under AOT) dispatches to the right callback.
    const ob: any = p["onButton"]
    const oc: any = p["onConfirm"]
    const ox: any = p["onCancel"]
    const os: any = p["onSubmit"]
    n.onChange = function(v: string): void { routeAlert(v, ob, oc, ox, os, confirmIdx, cancelIdx) }
    return n
}
// Route an Alert button tap. `v` is "<idx>" or "<idx>\t<promptText>". Multi-button
// alerts fire onButton(idx); simple/prompt alerts map idx to onConfirm/onCancel and
// pass the prompt text to onSubmit. Top-level (not a closure) so its locals are safe.
function routeAlert(v: string, ob: any, oc: any, ox: any, os: any, confirmIdx: int, cancelIdx: int): void {
    const tab: int = v.indexOf("\t")
    const idxStr: string = tab >= 0 ? v.slice(0, tab) : v
    const text: string = tab >= 0 ? v.slice(tab + 1) : ""
    if (ob != null) { const f: any = ob; f(idxStr); return }
    const idx: int = int(idxStr)
    if (idx == confirmIdx) { if (os != null) { const g: any = os; g(text) } callOpt(oc) }
    else if (idx == cancelIdx) { callOpt(ox) }
}
// Invoke an optional Prop closure (a () -> void callback), if present.
function callOpt(cb: any): void { if (cb != null) { const f: any = cb; f() } }
dataType ToggleProps { ViewProps; on: bool?; thumbColor: string?; disabled: bool? }
export function Toggle(p: ToggleProps): Node {
    const s: Style = new Style()
    s.swOn = pvB(p, "on", false) ? 1 : 0
    s.swThumb = pvS(p, "thumbColor", "")                                         // thumb (knob) color
    if (p["disabled"] != null) { s.disabled = pvB(p, "disabled", false) ? 1 : 0 }   // dim + block taps
    applyLayoutV(s, p)
    const n: Node = mkSwitch(s)
    applyEventsV(n, p)
    return n
}
/**
 * A native value slider (UISlider / SwiftUI Slider / Android SeekBar). Controlled,
 * like Switch: the parent owns `value` and passes it; `onChange` fires with the new
 * value (as a string; parse with int()) as the user drags. Integer range, `min` >= 0.
 *
 * Props: `value` (int), `min` (int, default 0), `max` (int, default 100),
 *        `step` (int, snap to multiples; 0 = continuous),
 *        `onChange` ((string) -> void, streams during drag),
 *        `onSlidingComplete` ((string) -> void, fires once on release),
 *        `color` (active-track/thumb tint hex), `h`.
 *
 * ```chuks
 * Slider({ value: vol.get(), min: 0, max: 100,
 *          onChange: function(v: string): void { vol.set(int(v)) } })
 * ```
 */
dataType SliderProps { ViewProps; min: int?; max: int?; value: int?; step: int?; onSlidingComplete: (function(v: string): void)? }
export function Slider(p: SliderProps): Node {
    const s: Style = new Style()
    s.slmin = pvI(p, "min", 0)
    s.slmax = pvI(p, "max", 100)
    s.slval = pvI(p, "value", s.slmin)
    if (s.slval < 0) { s.slval = 0 }            // keep the serialization sentinel valid
    s.slstep = pvI(p, "step", 0)                // snap to multiples of step (0 = continuous)
    s.h = pvI(p, "h", 40)
    s.fg = pvS(p, "color", "")                  // optional active-track / thumb tint
    applyLayoutV(s, p)
    const n: Node = mkSlider(s)
    applyEventsV(n, p)                          // onChange(v) fires on drag
    const sc: any = p["onSlidingComplete"]
    if (sc != null) { n.onSlideDone = sc }      // fires once with the final value on release
    return n
}
/**
 * A native select / dropdown (UIButton pull-down menu / SwiftUI Menu / Android
 * PopupMenu). Controlled, like Switch: the parent owns the selected index (`value`)
 * and passes `options`; `onChange` fires with the newly-picked index (as a string,
 * parse with int()). The field shows the current option's label.
 *
 * Props: `value` (int index), `onChange` ((string) -> void), `bg`, `color`, `h`.
 * `options` is a separate arg (the Prop union has no list type).
 *
 * ```chuks
 * Select({ value: sel.get(), onChange: function(v: string): void { sel.set(int(v)) } },
 *        ["Low", "Medium", "High"])
 * ```
 */
dataType SelectProps { ViewProps; value: int? }
export function Select(p: SelectProps, options: []string): Node {
    const s: Style = new Style()
    s.seli = pvI(p, "value", 0)
    if (s.seli < 0) { s.seli = 0 }
    s.h = pvI(p, "h", 44)
    s.bg = pvS(p, "bg", "FFFFFF")
    s.fg = pvS(p, "color", "111318")
    s.radius = pvI(p, "radius", 10)
    applyLayoutV(s, p)
    const n: Node = mkSelect(s, options.join("\t"))   // options in the text channel
    applyEventsV(n, p)                                // onChange(index) fires on pick
    return n
}
/**
 * A native date / time picker (UIDatePicker .compact / SwiftUI DatePicker / Android
 * DatePickerDialog + TimePickerDialog). Controlled, like Select: the parent owns the
 * `value` (an ISO string) and passes it; `onChange` fires with the newly-picked value
 * as an ISO string. The field shows the current value.
 *
 * Value format by `mode`: "date" -> "YYYY-MM-DD", "time" -> "HH:MM",
 * "datetime" -> "YYYY-MM-DDTHH:MM". Empty `value` starts at "now".
 *
 * `display` sets how it presents: "" (compact field, tap opens a popover on iOS / a
 * Material dialog on Android), "inline" (always-open graphical calendar on iOS), or
 * "wheels" (the classic wheel on iOS). On Android every display opens the dialog.
 *
 * Props: `value` (ISO string), `mode` ("date" | "time" | "datetime", default "date"),
 *        `display` ("" | "inline" | "wheels"), `onChange` ((string) -> void),
 *        `bg`, `color`, `radius`, `h`.
 *
 * ```chuks
 * DatePicker({ value: born.get(), mode: "date",
 *              onChange: function(v: string): void { born.set(v) } })
 * ```
 */
dataType DatePickerProps { ViewProps; mode: string?; display: string?; value: string? }
export function DatePicker(p: DatePickerProps): Node {
    const s: Style = new Style()
    s.dpmode = pvS(p, "mode", "date")           // date | time | datetime
    s.dpdisp = pvS(p, "display", "")            // "" compact field | "inline" always-open | "wheels"
    // The compact field is a fixed-height row; inline/wheels size to their natural
    // (tall) height, so only clamp height for the compact display.
    if (s.dpdisp == "") { s.h = pvI(p, "h", 44) }
    else if (p["h"] != null) { s.h = pvI(p, "h", -1) }
    s.bg = pvS(p, "bg", "FFFFFF")
    s.fg = pvS(p, "color", "111318")
    s.radius = pvI(p, "radius", 10)
    applyLayoutV(s, p)
    // Compact opens on tap (popover / dialog); inline & wheels are always-open, so
    // each host builds a different view — carry that in the node kind.
    const kind: string = (s.dpdisp == "") ? "DatePicker" : "DatePickerInline"
    const n: Node = mkDatePicker(kind, s, pvS(p, "value", ""))   // ISO value in the text channel
    applyEventsV(n, p)                                      // onChange(iso) fires on pick
    return n
}
/**
 * A native menu button (UIButton pull-down / SwiftUI Menu / Android PopupMenu). Unlike
 * Select there is no persistent selection: it shows a fixed `label` and its `items` are
 * one-shot actions. `onChange` fires with the picked item's index (as a string; parse
 * with int()). `items` is a separate arg (the Prop union has no list type).
 *
 * Props: `label` (trigger text), `onChange` ((string) -> void), `bg`, `color`, `h`, `radius`.
 *
 * ```chuks
 * Menu({ label: "Options",
 *        onChange: function(v: string): void { self.run(int(v)) } },
 *      ["Share", "Rename", "Delete"])
 * ```
 */
dataType MenuProps { ViewProps; label: string? }
export function Menu(p: MenuProps, items: []string): Node {
    const s: Style = new Style()
    s.h = pvI(p, "h", 44)
    s.bg = pvS(p, "bg", "FFFFFF")
    s.fg = pvS(p, "color", "111318")
    s.radius = pvI(p, "radius", 10)
    applyLayoutV(s, p)
    const label: string = pvS(p, "label", "Menu")
    const n: Node = mkMenu(s, label + "\t" + items.join("\t"))   // parts[0]=label, rest=items
    applyEventsV(n, p)                                           // onChange(index) fires on pick
    return n
}
/**
 * A context menu: long-press the wrapped `kids` to open a native action menu
 * (UIContextMenuInteraction / SwiftUI .contextMenu / Android long-press PopupMenu).
 * `onChange` fires with the picked item's index (as a string). `items` is a separate
 * arg before the children.
 *
 * ```chuks
 * ContextMenu({ onChange: function(v: string): void { self.act(int(v)) } },
 *             ["Copy", "Share", "Delete"],
 *             [ Card({ children: [ Text(tw("text-text"), "Long-press me") ] }) ])
 * ```
 */
export function ContextMenu(p: ViewProps, items: []string, kids: []Node): Node {
    const s: Style = new Style()
    applyLayoutV(s, p)
    const n: Node = mkContextMenu(s, items.join("\t"), kids)     // items in the text channel
    applyEventsV(n, p)                                           // onChange(index) fires on pick
    return n
}
/**
 * A grid: lays `items` into `cols` equal-width columns with `gap` between cells and
 * rows. Composed from Row/Column/View, so it works on every engine with no host code.
 * Cells stretch to share the row width (align-items: stretch), so each item fills its
 * cell; give items a height (or let them size to content). The last row is padded with
 * empty cells so items stay aligned. For a long, scrolling grid, put it inside `Scroll`.
 *
 * Props: `cols` (default 2), `gap` (default 10), plus layout props (`pad`, `grow`, `bg`).
 * `items` is a separate arg (the Prop union has no list type).
 *
 * ```chuks
 * Grid({ cols: 3, gap: 10 }, [ tileA, tileB, tileC, tileD, tileE ])
 * ```
 */
dataType GridProps { ViewProps; cols: int? }
export function Grid(first: GridProps | []Node, items: []Node = []): Node {
    if (typeof(first) == "array") { return Grid({}, first) }   // content-only: `Grid([...])`
    const p: GridProps = first
    const cols: int = pvI(p, "cols", 2)
    const gap: int = pvI(p, "gap", 10)
    var rows: []Node = []
    var i: int = 0
    while (i < items.length) {
        var cells: []Node = []
        var c: int = 0
        while (c < cols) {
            const idx: int = i + c
            if (idx < items.length) {
                cells.push(View({ grow: 1 }, [items[idx]]))       // the cell; its child stretches to fill
            } else {
                cells.push(View({ grow: 1 }, []))                 // filler keeps the last row aligned
            }
            c = c + 1
        }
        rows.push(Row({ gap: gap }, cells))
        i = i + cols
    }
    const s: Style = new Style(); s.dir = "col"; applyLayoutV(s, p); s.gap = gap
    return mkView(s, rows)
}
/**
 * A native map centered on a coordinate. iOS renders a real `MKMapView` (MapKit, no
 * API key); Android renders an interactive OpenStreetMap in a web view (a native Google
 * map needs the Maps SDK + an API key). Give it a size or let it `grow` to fill.
 *
 * Coordinates are strings (the Prop union has no float): `lat`, `lng`, and an integer
 * `zoom` (higher = closer; ~1 world, ~13 city, ~17 street).
 *
 * ```chuks
 * Map({ lat: "37.7749", lng: "-122.4194", zoom: "12", grow: 1 })
 * ```
 */
dataType MapProps { ViewProps; lat: string?; lng: string?; zoom: string? }
export function Map(p: MapProps): Node {
    const s: Style = new Style()
    s.radius = pvI(p, "radius", 0)
    applyLayoutV(s, p)
    const lat: string = pvS(p, "lat", "37.7749")
    const lng: string = pvS(p, "lng", "-122.4194")
    const zoom: string = pvS(p, "zoom", "12")
    return new Node("Map", s, lat + "," + lng + "," + zoom, [])   // "lat,lng,zoom" in the text channel
}

// ---- Canvas / SVG shapes ---------------------------------------------------
// Each shape builder returns a compact descriptor string; Canvas joins them with ";"
// into the node's text channel (fields comma-separated). A Path's `d` uses
// space-separated SVG commands (M/L/Z) so it never contains a "," or ";".
function si(p: any, k: string): string { return string(pvI(p, k, 0)) }

// Vector-shape props for Rect/Circle/Line/Path (SVG primitives, no layout).
dataType ShapeProps {
    x: int?; y: int?; w: int?; h: int?; cx: int?; cy: int?; r: int?;
    x1: int?; y1: int?; x2: int?; y2: int?; strokeWidth: int?; radius: int?;
    fill: string?; stroke: string?; d: string?;
}
/** A rectangle. Props: `x`, `y`, `w`, `h`, `fill`, `stroke`, `strokeWidth`, `radius`. */
export function Rect(p: ShapeProps): string {
    return "rect," + si(p, "x") + "," + si(p, "y") + "," + si(p, "w") + "," + si(p, "h") + "," +
        pvS(p, "fill", "") + "," + pvS(p, "stroke", "") + "," + si(p, "strokeWidth") + "," + si(p, "radius")
}
/** A circle. Props: `cx`, `cy`, `r`, `fill`, `stroke`, `strokeWidth`. */
export function Circle(p: ShapeProps): string {
    return "circle," + si(p, "cx") + "," + si(p, "cy") + "," + si(p, "r") + "," +
        pvS(p, "fill", "") + "," + pvS(p, "stroke", "") + "," + si(p, "strokeWidth")
}
/** A line. Props: `x1`, `y1`, `x2`, `y2`, `stroke`, `strokeWidth`. */
export function Line(p: ShapeProps): string {
    return "line," + si(p, "x1") + "," + si(p, "y1") + "," + si(p, "x2") + "," + si(p, "y2") + "," +
        pvS(p, "stroke", "") + "," + string(pvI(p, "strokeWidth", 1))
}
/** An SVG path (M / L / Z subset). Props: `d` (path data), `fill`, `stroke`, `strokeWidth`. */
export function Path(p: ShapeProps): string {
    return "path," + pvS(p, "d", "") + "," + pvS(p, "fill", "") + "," +
        pvS(p, "stroke", "") + "," + si(p, "strokeWidth")
}
/**
 * A native drawing surface. Renders a list of vector shapes (Rect / Circle / Line /
 * Path) with native drawing — Core Graphics on UIKit, SwiftUI `Canvas`, and
 * `android.graphics` on Android. Shapes use pixel coordinates within the canvas; give
 * it a size or let it `grow`. Colors are hex without a leading `#`.
 *
 * ```chuks
 * Canvas({ w: 300, h: 180, bg: tk("surface"), radius: 12 }, [
 *     Rect({ x: 16, y: 16, w: 80, h: 80, fill: "6366F1", radius: 10 }),
 *     Circle({ cx: 210, cy: 56, r: 40, fill: "22C55E" }),
 *     Line({ x1: 16, y1: 140, x2: 284, y2: 140, stroke: "EF4444", strokeWidth: 3 }),
 *     Path({ d: "M150 96 L190 150 L110 150 Z", fill: "F97316" }),
 * ])
 * ```
 */
export function Canvas(first: ViewProps | []string, shapes: []string = []): Node {
    if (typeof(first) == "array") { return Canvas({}, first) }   // content-only: `Canvas([...shapes])`
    const p: ViewProps = first
    const s: Style = new Style()
    s.bg = pvS(p, "bg", "")
    s.radius = pvI(p, "radius", 0)
    applyLayoutV(s, p)
    return new Node("Canvas", s, shapes.join(";"), [])   // shapes joined in the text channel
}
/**
 * Recognizes gestures beyond a tap on its children and reports them through one
 * `onGesture(g)` callback. `g` is an encoded string the host dispatches: "swipe:left",
 * "swipe:right", "swipe:up", "swipe:down", "doubletap", or "longpress". Native
 * recognizers on each engine (UISwipe/UITap/UILongPress, SwiftUI gestures, Android
 * GestureDetector), so each fires once — no per-frame round-trip.
 *
 * ```chuks
 * Gesture({ onGesture: function(g: string): void {
 *     if (g == "swipe:left") { next() }
 *     if (g == "doubletap") { like() }
 * } }, [ card ])
 * ```
 */
dataType GestureProps {
    ViewProps;
    onGesture: (function(v: string): void)?; onPan: (function(v: string): void)?;
    onPinch: (function(v: string): void)?; onRotate: (function(v: string): void)?;
}
export function Gesture(first: GestureProps | []Node, kids: []Node = []): Node {
    if (typeof(first) == "array") { return Gesture({}, first) }   // content-only (no recognizers)
    const p: GestureProps = first
    const s: Style = new Style()
    applyLayoutV(s, p)
    const n: Node = new Node("Gesture", s, "", kids)
    const og: any = p["onGesture"]      // discrete: swipe/doubletap/longpress
    const onPan: any = p["onPan"]        // continuous, each a function(v: string): void
    const onPinch: any = p["onPinch"]
    const onRotate: any = p["onRotate"]
    // Tell the host which CONTINUOUS recognizers to attach (text channel, comma list).
    // Attaching only the requested ones avoids fighting a Scroll and skips the discrete
    // swipe recognizer when pan is on (they both track drags).
    var cont: string = ""
    if (onPan != null) { cont = cont == "" ? "pan" : cont + ",pan" }
    if (onPinch != null) { cont = cont == "" ? "pinch" : cont + ",pinch" }
    if (onRotate != null) { cont = cont == "" ? "rotate" : cont + ",rotate" }
    n.text = cont
    // One value-channel binding routes every gesture string by its prefix to the right
    // callback. Continuous streams ("pan:..."/"pinch:..."/"rotate:...") and discrete
    // ("swipe:left"/"doubletap"/"longpress") all arrive here.
    if (og != null || onPan != null || onPinch != null || onRotate != null) {
        n.onChange = function(v: string): void {
            if (_prefix(v, "pan:")) { _callStr(onPan, v) }
            else if (_prefix(v, "pinch:")) { _callStr(onPinch, v) }
            else if (_prefix(v, "rotate:")) { _callStr(onRotate, v) }
            else { _callStr(og, v) }
        }
    }
    return n
}
// Does `s` start with `p`? (Chuks has no startsWith; slice-compare instead.)
function _prefix(s: string, p: string): bool { return s.length >= p.length && s.slice(0, p.length) == p }
// Call an optional `function(v: string): void` (held as any) with a string arg.
function _callStr(cb: any, v: string): void { if (cb != null) { const f: any = cb; f(v) } }

// ---- continuous-gesture decoders ------------------------------------------
// The host streams a continuous gesture as an encoded value string; these parse it
// into a typed event. phase: 0 = begin, 1 = change, 2 = end. Pan dx/dy are the
// translation (px) from the gesture's start; vx/vy the release velocity (px/s).
// Pinch scale / Rotate deg are the factor*100 (100 = 1.0) / degrees from start.
export class PanEvent {
    var phase: int
    var dx: int
    var dy: int
    var vx: int
    var vy: int
    constructor() { this.phase = 0; this.dx = 0; this.dy = 0; this.vx = 0; this.vy = 0 }
}
export class PinchEvent {
    var phase: int
    var scale: int   // factor as a percent, 100 = 1.0
    var vscale: int
    constructor() { this.phase = 0; this.scale = 100; this.vscale = 0 }
}
export class RotateEvent {
    var phase: int
    var deg: int     // rotation from the gesture start, in degrees
    var vdeg: int
    constructor() { this.phase = 0; this.deg = 0; this.vdeg = 0 }
}
function _afterColon(v: string): []string {
    const ci: int = v.indexOf(":")
    if (ci < 0) { return [] }
    return v.slice(ci + 1, v.length).split(",")
}
/** Decode a "pan:phase,dx,dy,vx,vy" value string from Gesture.onPan. */
export function decodePan(v: string): PanEvent {
    const e: PanEvent = new PanEvent()
    const f: []string = _afterColon(v)
    if (f.length >= 5) { e.phase = int(f[0]); e.dx = int(f[1]); e.dy = int(f[2]); e.vx = int(f[3]); e.vy = int(f[4]) }
    return e
}
/** Decode a "pinch:phase,scale,vscale" value string from Gesture.onPinch. */
export function decodePinch(v: string): PinchEvent {
    const e: PinchEvent = new PinchEvent()
    const f: []string = _afterColon(v)
    if (f.length >= 3) { e.phase = int(f[0]); e.scale = int(f[1]); e.vscale = int(f[2]) }
    return e
}
/** Decode a "rotate:phase,deg,vdeg" value string from Gesture.onRotate. */
export function decodeRotate(v: string): RotateEvent {
    const e: RotateEvent = new RotateEvent()
    const f: []string = _afterColon(v)
    if (f.length >= 3) { e.phase = int(f[0]); e.deg = int(f[1]); e.vdeg = int(f[2]) }
    return e
}
/**
 * A page's root column: its children fill the screen top-to-bottom. Every
 * View.render() returns one of these as its outermost node.
 *
 * Props: `bg` (page background hex), `pad` (default 12), `gap` (default 10).
 *
 * ```chuks
 * Screen({ bg: BG, pad: 24, gap: 18 }, [
 *     Text({ weight: "bold", size: 30, color: FG }, "Welcome back"),
 *     Field("Email", "you@example.com", onEmail),
 *     Button({ onPress: onSubmit, bg: ACCENT, h: 52 }, "Log in"),
 * ])
 * ```
 */
export function Screen(first: ViewProps | []Node, kids: []Node = []): Node {
    if (typeof(first) == "array") { return Screen({}, first) }   // content-only: `Screen([...])`
    const p: ViewProps = first
    const s: Style = new Style(); s.dir = "col"; s.pad = pvI(p, "pad", 12); s.gap = pvI(p, "gap", 10)
    s.bg = pvS(p, "bg", "")
    return mkView(s, kids)
}
/**
 * A virtualized list: only the on-screen rows are mounted, the rest recycled, so
 * a list of thousands of rows stays smooth.
 *
 * Props:
 *   - `count`     total number of rows
 *   - `key`       (rank: int) -> string    stable identity for the row at `rank`
 *   - `item`      (rank: int, top: int) -> Node    builds the row's node
 *   - `rowHeight` row height in px
 *   - `gap`       vertical gap between rows
 *   - `pad`       top/bottom padding (optional)
 *   - `buffer`    extra rows kept above/below the window (optional, default 3)
 *   - `paging`    snap one full screen per swipe (video feeds)
 *   - `onVisible` (rank: int) -> void    the centered row changed (autoplay-follows-visible)
 *   - `onEndReached` () -> void + `endThreshold` (rows)   fire near the end (infinite scroll)
 *   - `onRefresh` () -> void + `refreshing` (bool)        pull-to-refresh + its spinner
 *   - `empty`     (height: int) -> Node                   shown (filling the viewport) when count == 0
 *
 * Identity comes from `key()` (NOT the rank), so a row's views and state survive
 * when a filter moves it to a different position.
 *
 * ```chuks
 * List({ count: this.filtered.length,
 *        key:  function(r: int): string { return string(self.filtered[r]) },
 *        item: function(r: int, top: int): Node { return self.rowAt(r, top) },
 *        rowHeight: 72, gap: 10, pad: 8 })
 * ```
 */
export function List(p: map[string]ListProp): Node {
    const s: Style = new Style(); s.grow = 1; s.basis = 0    // fills the remaining space
    const n: Node = new Node("List", s, "", [])
    n.data = p    // carries count, key, item, rowHeight, gap, pad
    return n
}
/**
 * A virtualized SECTIONED list: rows grouped under section headers, only the
 * on-screen window mounted (same windowing as List). Uniform `rowHeight` +
 * `headerHeight`; the header/rows are absolutely positioned at the `top` passed
 * to their builders (use `abs: true, top`).
 *
 * Props:
 *   - `sectionCount` number of sections
 *   - `rows`         (s: int) -> int              rows in section `s`
 *   - `header`       (s: int, top: int) -> Node   the section header at `top`
 *   - `item`         (s: int, r: int, top: int) -> Node   a row at `top`
 *   - `key`          (s: int, r: int) -> string   stable row identity
 *   - `rowHeight`, `headerHeight`, `gap`, `pad`, `buffer` (optional)
 *
 * ```chuks
 * SectionList({ sectionCount: groups.length,
 *   rows:   function(s: int): int { return groups[s].items.length },
 *   header: function(s: int, top: int): Node { return self.header(s, top) },
 *   item:   function(s: int, r: int, top: int): Node { return self.row(s, r, top) },
 *   key:    function(s: int, r: int): string { return string(s) + "-" + string(r) },
 *   rowHeight: 56, headerHeight: 34, gap: 8, pad: 8 })
 * ```
 */
export function SectionList(p: map[string]ListProp): Node {
    const s: Style = new Style(); s.grow = 1; s.basis = 0
    const n: Node = new Node("SectionList", s, "", [])
    n.data = p
    return n
}

/**
 * Place a component LAZILY. `render` is a () -> Node closure the framework calls
 * top-down, at the component's position, so the component knows its identity when
 * it runs -- which is what makes `useState()` work with no key. Use `Comp` for any
 * component that holds state; pure/controlled components may be called directly.
 *
 * ```chuks
 * Column({ gap: 10 }, [ Comp(Counter), Comp(function(): Node { return Card(id) }) ])
 * ```
 */
export function Comp(render: any): Node {
    const n: Node = new Node("Comp", new Style(), "", [])
    n.comp = render
    return n
}
/**
 * Like `Comp`, but with an explicit identity key for a hand-rolled loop of
 * stateful children (prefer `List` for dynamic collections -- its rows are already
 * keyed). The key makes a child's state follow the item, not the slot.
 *
 * ```chuks
 * for (var i = 0; i < items.length; i = i + 1) {
 *     kids.push(KeyedComp("item:" + string(items[i].id), rowFor(items[i])))
 * }
 * ```
 */
export function KeyedComp(key: string, render: any): Node {
    const n: Node = new Node("Comp", new Style(), "", [])
    n.comp = render; n.ckey = key
    return n
}

/**
 * A class-based component (the SwiftUI/React model). `new MyComponent(props)`
 * builds a LAZY placeable node: its render() is NOT called until the framework
 * reaches its position in the tree, so the component knows its identity when it
 * runs (which is what makes useState() work with no key). Subclasses override
 * render(); props are plain constructor arguments; .key(id) chains for lists.
 *
 * ```chuks
 * class Counter extends Component {
 *     var start: int
 *     constructor(start: int) { super(); this.start = start }
 *     override public render(): Node {
 *         var c = useState(this.start)
 *         var n: int = c.get()
 *         return Button({ onPress: function(): void { c.set(c.get() + 1) } }, string(n))
 *     }
 * }
 * // placed directly, no wrapper: Column({}, [ new Counter(0), new Counter(0).key("b") ])
 * ```
 */
export class Component extends Node {
    constructor() { super("Comp", new Style(), "", []) }
    // Subclasses override this. The default is an empty view (so a Component that
    // forgets to override renders nothing rather than looping on itself).
    override public render(): Node { return mkView(new Style(), []) }
}

// ---- Reconciler: diffs trees into the minimal mutation stream --------------
// The app owns one instance; the mutation buffer lives here, not as module state.
export class Reconciler {
    var lines: []string
    var handlers: map[string]any    // node id -> onPress/onChange closure (events)
    var vpTop: int                  // viewport (set by the host each scroll) for List windowing
    var vpH: int
    var vpW: int                    // cross-axis viewport size (list width for a vertical list; grid columns)
    var rootPrev: Node?             // last rendered root, for diffing
    var itemNodes: map[string]Node  // List cell id -> last node it showed (for reconcile prev)
    var mounted: []string           // List cell ids in use this frame
    var listCount: int              // last content count (to re-emit content height only on change)
    var listContentH: int           // last content height emitted (re-emit when it changes: count/header/footer)
    var listHeaderShown: map[string]bool  // List id -> header node currently mounted
    var listFooterShown: map[string]bool  // List id -> footer node currently mounted
    var cellRank: map[string]int    // recycling: cell id -> the row rank it currently shows (-1 = free)
    var poolSize: int               // recycling: how many pool cells have been created
    var pending: map[string]any     // async bridge: token -> result closure (survives frames, unlike handlers)
    var pendingErr: map[string]any  // async bridge: token -> OPTIONAL error closure (host reports a failure)
    var streamTokens: map[string]bool // async bridge: token -> true if a STREAM (fires repeatedly; not dropped on fire)
    var tokenSeq: int               // async bridge: monotonic token counter
    var listVisible: map[string]int // List id -> last centered row index reported to its onVisible
    var pendingVisible: []any       // onVisible closures queued this frame, fired after render (see flushVisible)
    var listEndFired: map[string]int // List id -> count at which onEndReached last fired (fire once per count)
    var listRefreshing: map[string]int // List id -> last refreshing flag emitted (diff the spinner)
    var listEmpty: map[string]bool   // List id -> whether the empty-state node is currently mounted
    var listScrollIdx: map[string]int // List id -> last scrollToIndex target emitted (fire on change)
    var listScrollEnd: map[string]int // List id -> last scrollToEnd nonce emitted (fire on change)
    var listScrollPos: map[string]int // List id -> last scroll offset reported to its onScroll
    var scrollToPos: map[string]int  // Scroll id -> last scrollTo target emitted (fire on change)
    constructor() {
        this.lines = []; this.handlers = {}
        this.vpTop = 0; this.vpH = 0; this.vpW = 0; this.rootPrev = null
        this.itemNodes = {}; this.mounted = []; this.listCount = -1
        this.cellRank = {}; this.poolSize = 0
        this.pending = {}; this.pendingErr = {}; this.streamTokens = {}; this.tokenSeq = 0
        this.listVisible = {}; this.pendingVisible = []; this.listEndFired = {}
        this.listRefreshing = {}; this.listEmpty = {}; this.listContentH = -1
        this.listHeaderShown = {}; this.listFooterShown = {}
        this.listScrollIdx = {}; this.listScrollEnd = {}; this.listScrollPos = {}
        this.scrollToPos = {}
    }
    // Start a new mutation batch (clears the buffer). Call once per frame.
    public begin(): void { this.lines = [] }
    // Drop the committed-tree baseline so the next renderRoot re-emits the WHOLE tree as
    // creates (not a diff). The dev server uses this so a freshly connected or relaunched
    // host, which has no views yet, receives the full tree. Component state is untouched
    // (it lives in the hook cells, not here), so a reconnecting host keeps current state.
    public forgetCommitted(): void {
        this.rootPrev = null
        this.itemNodes = {}; this.mounted = []; this.listCount = -1
        this.cellRank = {}; this.poolSize = 0
    }
    // Append one mutation line ("C|id|kind", "S|id|style", "I|id|parent|idx", "R|id", ...).
    public emit(s: string): void { this.lines.push(s) }
    // Number of mutations buffered this frame.
    public count(): int { return this.lines.length }
    // Join the buffered mutations into the newline-delimited stream the host applies.
    public drain(): string { return this.lines.join("\n") }
    // Record the visible scroll window used by reconcileList to pick the mount range.
    public setViewport(top: int, h: int, w: int): void { this.vpTop = top; this.vpH = h; if (w > 0) { this.vpW = w } }
    // Fire any onVisible callbacks queued during this render (a paging List's centered row
    // changed). Called AFTER renderRoot so the closures can setState safely; returns true if
    // any fired, so the caller re-renders to reflect the new state (e.g. play the settled cell).
    public flushVisible(): bool {
        if (this.pendingVisible.length == 0) { return false }
        const cbs: []any = this.pendingVisible
        this.pendingVisible = []
        var i: int = 0
        while (i < cbs.length) { const cb: any = cbs[i]; cb(); i = i + 1 }
        return true
    }
    // Reconcile the whole app tree from the root; the app calls this after any
    // state change and the memoization makes everything unchanged bail.
    public renderRoot(next: Node): void {
        this.reconcile(this.rootPrev, next, "app", "root", 0)
        this.rootPrev = next
    }

    // Fire the closure bound to a node id. `fire` for onPress, `fireValue` for
    // onChange (inputs). The closure lives on the Chuks side; only the tag (the
    // node id) ever crosses the host boundary.
    public fire(tag: string): void {
        if (this.handlers[tag] != null) { const f: any = this.handlers[tag]; f() }
    }
    // Fire the onChange(value) closure bound to node `tag` (from an input).
    public fireValue(tag: string, value: string): void {
        if (this.handlers[tag] != null) { const f: any = this.handlers[tag]; f(value) }
    }
    // ---- async host->engine bridge (F3) --------------------------------------
    // Request a native capability. If `cb` is non-null it is registered under a
    // fresh token and the host calls back resolve(token, payload) when the async
    // work completes; a null `cb` is fire-and-forget (token "0"). Emits the
    // command into the SAME drain stream the host already applies, as an X op:
    //   X|token|capability|args
    // `args` is a raw string (JSON when structured). The callback survives across
    // frames (it lives in `pending`, which begin() does NOT clear) because the
    // host resolves it on a later runloop turn, not within this batch.
    // `stream` = true registers a REPEATING token (fired on every host event until
    // cancelled) rather than a one-shot. Returns the token so the caller can build a
    // NativeSub handle to cancel it. A null `cb` is fire-and-forget (token "0").
    // `onErr` (optional) is fired if the host reports a FAILURE for this request
    // (permission denied at the OS level, hardware missing, native op errored) —
    // distinct from a valid result. Failable capabilities pass it; simple ones null.
    public command(cap: string, args: string, cb: any, onErr: any, stream: bool): string {
        var tok: string = "0"
        if (cb != null) {
            this.tokenSeq = this.tokenSeq + 1
            tok = "k" + string(this.tokenSeq)
            this.pending[tok] = cb
            if (onErr != null) { this.pendingErr[tok] = onErr }
            if (stream) { this.streamTokens[tok] = true }
        }
        this.emit("X|" + tok + "|" + cap + "|" + args)
        return tok
    }
    // Drop a token from every registry (success/error/stream). Central so cancel,
    // drop, one-shot success, and failure all forget the token the same way.
    //
    // ORPHAN-SWEEP EXTENSION POINT: a one-shot token whose host work never completes
    // (a hung native call that never resolve()s or fail()s, while its component stays
    // mounted) sits in `pending` forever. The unmount case is already handled
    // (hookSweep -> NativeSub.cancel), so this is the narrow "component alive, native
    // side silent" case. Adding a timeout audit is ADDITIVE, no restructuring:
    //   1. a parallel `pendingMeta: map[string]int` (token -> creation stamp), set in
    //      command() and cleared HERE (this is the single removal choke point, so it
    //      stays in lockstep automatically);
    //   2. a `sweepOrphans(nowMs)` method that walks pending.keys() and
    //      failToken(token, "timeout") for anything past a cutoff;
    //   3. a `sweepOrphans` C-ABI export the host drives (it owns the clock; the
    //      framework has no built-in time source — token ids are monotonic, a coarse
    //      age proxy). Age is the axis, not owner. Prefer a host-side per-capability
    //      timeout (calls the existing fail()) for the common case; this is the net.
    forgetToken(token: string): void {
        if (this.pending.has(token)) { this.pending.delete(token) }
        if (this.pendingErr.has(token)) { this.pendingErr.delete(token) }
        if (this.streamTokens.has(token)) { this.streamTokens.delete(token) }
    }
    // The host reports a result for `token`. Fire the registered callback. A one-shot
    // token is dropped BEFORE firing (so it can't fire twice); a stream token stays
    // registered for the next event. An unknown/late token (already cancelled or
    // dropped) is ignored — this is the fire-after-cancel / fire-during-unmount race
    // landing safely, mirroring Cell.set's has-guard.
    public fireToken(token: string, payload: string): void {
        if (this.pending.has(token)) {
            const f: any = this.pending[token]
            if (!this.streamTokens.getOr(token, false)) { this.forgetToken(token) }
            f(payload)
        }
    }
    // The host reports a FAILURE for `token`. Fire the error callback (if any) and
    // forget the token entirely — an error terminates the request (one-shot or
    // stream). Same has-guard: a late/unknown failure is ignored.
    public failToken(token: string, message: string): void {
        if (this.pending.has(token)) {
            const onErr: any = this.pendingErr.getOr(token, null)
            this.forgetToken(token)
            if (onErr != null) { onErr(message) }
        }
    }
    // Chuks-initiated cancel (a NativeSub.cancel(), typically from a useEffect
    // cleanup on unmount): drop the token locally AND tell the host to tear down the
    // native op/subscription, so a stream stops draining battery and a one-shot
    // aborts. Emits into the current drain, which the host applies.
    public cancelStream(token: string): void {
        this.forgetToken(token)
        this.emit("X|" + token + "|__cancel__|")
    }
    // Host-initiated death (the user dismissed the picker / the native op ended with
    // no result): drop the token locally, no host command (the host already knows).
    public dropToken(token: string): void { this.forgetToken(token) }
    // register a node's event closure (tag = the node id), and emit its T binding
    bindEvents(n: Node, id: string): void {
        if (n.onPress != null) { this.handlers[id] = n.onPress; this.emit("T|" + id + "|" + id) }
        else if (n.onChange != null) { this.handlers[id] = n.onChange; this.emit("T|" + id + "|" + id) }
        else if (n.action != "") { this.emit("T|" + id + "|" + n.action) }
        // Extra TextInput events, each a separate binding keyed by "<id>:<event>".
        if (n.onSubmit != null) { this.handlers[id + ":submit"] = n.onSubmit; this.emit("TS|" + id) }
        if (n.onFocus != null) { this.handlers[id + ":focus"] = n.onFocus; this.emit("TF|" + id) }
        if (n.onBlur != null) { this.handlers[id + ":blur"] = n.onBlur; this.emit("TB|" + id) }
        if (n.onLongPress != null) { this.handlers[id + ":longpress"] = n.onLongPress; this.emit("TL|" + id) }
        if (n.onPressIn != null) { this.handlers[id + ":pressin"] = n.onPressIn; this.emit("TPI|" + id) }
        if (n.onPressOut != null) { this.handlers[id + ":pressout"] = n.onPressOut; this.emit("TPO|" + id) }
        if (n.onLoad != null) { this.handlers[id + ":load"] = n.onLoad; this.emit("ML|" + id) }
        if (n.onError != null) { this.handlers[id + ":error"] = n.onError; this.emit("ME|" + id) }
        if (n.onEnd != null) { this.handlers[id + ":end"] = n.onEnd; this.emit("MN|" + id) }
        if (n.onProgress != null) { this.handlers[id + ":progress"] = n.onProgress; this.emit("MP|" + id) }
        if (n.onSlideDone != null) { this.handlers[id + ":slidedone"] = n.onSlideDone; this.emit("SC|" + id) }
        if (n.onScroll != null) { this.handlers[id + ":scroll"] = n.onScroll; this.emit("SS|" + id) }
    }

    // Mount a fresh node and its whole subtree: emit Create/Style/Text/Insert +
    // event binding, recursing into children. Used for first mount and remounts.
    public mountNode(n: Node, id: string, parent: string, index: int): void {
        if (n.kind == "Comp") {
            // set the component's identity, run it, then mount what it produced AT
            // the Comp's own id (a component is transparent in the native tree).
            // render() dispatches: a Comp(fn) node runs its closure, a class
            // Component subclass runs its overridden render().
            const path: string = n.ckey != "" ? "key:" + n.ckey : id
            hookEnter(path)
            const produced: Node = n.render()
            n.produced = produced
            this.mountNode(produced, id, parent, index)
            return
        }
        if (n.kind == "List") { this.reconcileList(null, n, id, parent, index); return }
        if (n.kind == "SectionList") { this.reconcileSectionList(null, n, id, parent, index); return }
        this.emit("C|" + id + "|" + n.kind)
        const st: string = n.style.str()
        if (st != "") { this.emit("S|" + id + "|" + st) }
        if (n.text != "") { this.emit("P|" + id + "|" + n.text) }
        if (n.opsChain != "") { this.emit("IF|" + id + "|" + n.opsChain) }   // Image GPU op-chain
        if (n.hasVal) { this.emit("V|" + id + "|" + n.val) }   // controlled TextInput value
        this.bindEvents(n, id)
        this.emit("I|" + id + "|" + parent + "|" + string(index))
        for (var i: int = 0; i < n.kids.length; i = i + 1) {
            this.mountNode(n.kids[i], id + "." + string(i), id, i)
        }
    }
    public reconcile(prev: Node?, next: Node, id: string, parent: string, index: int): void {
        if (prev == null) { this.mountNode(next, id, parent, index); return }
        const p: Node = prev
        if (p == next) { return }              // memoized + unchanged: whole subtree bails
        // component at this position: run it (setting its identity) and diff what it
        // produced against what it produced last render.
        if (next.kind == "Comp") {
            const path: string = next.ckey != "" ? "key:" + next.ckey : id
            hookEnter(path)
            const produced: Node = next.render()
            next.produced = produced
            var prevProduced: Node? = null
            if (p.kind == "Comp") { prevProduced = p.produced } else { this.emit("R|" + id) }
            this.reconcile(prevProduced, produced, id, parent, index)
            return
        }
        // prev was a component here, next is a plain node: drop the old subtree, mount fresh.
        if (p.kind == "Comp") { this.emit("R|" + id); this.mountNode(next, id, parent, index); return }
        // kind changed at this position (e.g. a page swap): remove + remount.
        if (p.kind != next.kind) {
            this.emit("R|" + id)
            this.mountNode(next, id, parent, index)
            return
        }
        if (next.kind == "List") { this.reconcileList(prev, next, id, parent, index); return }
        if (next.kind == "SectionList") { this.reconcileSectionList(prev, next, id, parent, index); return }
        if (p.text != next.text) { this.emit("P|" + id + "|" + next.text) }
        if (p.opsChain != next.opsChain) { this.emit("IF|" + id + "|" + next.opsChain) }   // Image GPU op-chain change
        if (next.hasVal && (!p.hasVal || p.val != next.val)) { this.emit("V|" + id + "|" + next.val) }
        const ps: string = p.style.str()
        const ns: string = next.style.str()
        if (ps != ns) { this.emit("S|" + id + "|" + ns) }
        // Event binding can CHANGE on update, not just on mount: a slot that was
        // inert can gain an onPress when the screen swaps in place (e.g. a NavBar
        // trailing button appearing as Home -> Profile reuses the same node id), or
        // lose one. bindEvents (which emits T|) runs ONLY on mountNode, so re-emit
        // the tag here whenever the binding target changes — otherwise the host keeps
        // a stale (or empty) action and the tap never fires on ANY host.
        const prevTag: string = (p.onPress != null || p.onChange != null) ? id : p.action
        const nextTag: string = (next.onPress != null || next.onChange != null) ? id : next.action
        if (prevTag != nextTag) { this.emit("T|" + id + "|" + nextTag) }
        // the closure is recreated each render; rebind it (tag/id unchanged)
        if (next.onPress != null) { this.handlers[id] = next.onPress }
        else if (next.onChange != null) { this.handlers[id] = next.onChange }
        if (next.onSubmit != null) { this.handlers[id + ":submit"] = next.onSubmit }
        if (next.onFocus != null) { this.handlers[id + ":focus"] = next.onFocus }
        if (next.onBlur != null) { this.handlers[id + ":blur"] = next.onBlur }
        if (next.onLongPress != null) { this.handlers[id + ":longpress"] = next.onLongPress }
        if (next.onPressIn != null) { this.handlers[id + ":pressin"] = next.onPressIn }
        if (next.onPressOut != null) { this.handlers[id + ":pressout"] = next.onPressOut }
        if (next.onLoad != null) { this.handlers[id + ":load"] = next.onLoad }
        if (next.onError != null) { this.handlers[id + ":error"] = next.onError }
        if (next.onEnd != null) { this.handlers[id + ":end"] = next.onEnd }
        if (next.onProgress != null) { this.handlers[id + ":progress"] = next.onProgress }
        if (next.onSlideDone != null) { this.handlers[id + ":slidedone"] = next.onSlideDone }
        if (next.onScroll != null) { this.handlers[id + ":scroll"] = next.onScroll }
        // scrollTo: imperatively scroll when the target changes (reuses the List LS op).
        if (next.scrollTo >= 0 && next.scrollTo != this.scrollToPos.getOr(id, -1)) {
            this.scrollToPos[id] = next.scrollTo
            this.emit("LS|" + id + "|" + string(next.scrollTo))
        }
        for (var i: int = 0; i < next.kids.length; i = i + 1) {
            const child: Node? = i < p.kids.length ? p.kids[i] : null
            this.reconcile(child, next.kids[i], id + "." + string(i), id, i)
        }
        // remove old children the new tree no longer has
        for (var i: int = next.kids.length; i < p.kids.length; i = i + 1) {
            this.emit("R|" + id + "." + string(i))
        }
    }

    // True if string slice `a` contains `x`. Small helper for the mount window.
    containsStr(a: []string, x: string): bool {
        for (var i: int = 0; i < a.length; i = i + 1) { if (a[i] == x) { return true } }
        return false
    }
    // Virtualize a List node: mount the Scroll + content scaffold once, then mount
    // only the window of items visible for the current viewport, recycling the
    // rest. Item identity comes from key(rank), so a row survives when a filter
    // moves it to a different rank (its id "c<key>" is stable, only its top moves).
    reconcileList(prev: Node?, next: Node, id: string, parent: string, index: int): void {
        const d0: map[string]ListProp = next.data
        if (lpBool(d0, "horizontal", false)) { this.reconcileHList(prev, next, id, parent, index); return }
        const d: map[string]ListProp = next.data
        const count: int = lpInt(d, "count", 0)
        const rowH: int = lpInt(d, "rowHeight", 0)
        const gap: int = lpInt(d, "gap", 0)
        const pad: int = lpInt(d, "pad", 0)
        const stride: int = rowH + gap
        const buffer: int = lpInt(d, "buffer", 3)
        const itemFn: any = d.get("item")
        const contentId: string = id + ".0"
        // Optional header/footer offset the rows. headerH/footerH default 0, so a feed
        // without them lays out exactly as before (the video feed is unaffected).
        const headerH: int = lpInt(d, "headerHeight", 0)
        const footerH: int = lpInt(d, "footerHeight", 0)
        const rowsTop: int = pad + headerH               // where the first row sits
        // inverted (chat): row 0 sits at the BOTTOM and later rows stack upward, so a
        // freshly-appended row 0 (newest) shows at the bottom. `invBase` is row 0's top;
        // top(r) = invBase - r*stride. Default off, so a feed lays out exactly as before.
        const inverted: bool = lpBool(d, "inverted", false)
        // numColumns (grid): pack `ncol` cells per row across the list WIDTH (reported by the
        // host as vpW). The reconciler computes each cell's column width + x and overrides them
        // on the item node, so the app's item builder need not know the layout. ncol defaults
        // to 1 (a plain list); grids are non-inverted, so inverted forces ncol back to 1.
        const ncol0: int = lpInt(d, "numColumns", 1)
        const ncol: int = (inverted || ncol0 < 1) ? 1 : ncol0
        const gridRows: int = (count + ncol - 1) / ncol   // rows of `ncol` cells; == count when ncol==1
        var colW: int = 0
        if (ncol > 1 && this.vpW > 0) { colW = (this.vpW - 2 * pad - (ncol - 1) * gap) / ncol }
        const contentH: int = rowsTop + gridRows * stride + footerH + pad
        const invBase: int = contentH - pad - footerH - rowH

        if (prev == null) {
            // fresh mount (first render, or remount after a page swap tore this List
            // down): start from a clean pool so stale cells can't suppress mounts.
            this.mounted = []; this.itemNodes = {}; this.cellRank = {}; this.poolSize = 0
            const listS: Style = new Style(); listS.grow = 1; listS.basis = 0
            if (lpBool(d, "paging", false)) { listS.paging = 1 }   // snap per screen (video feeds)
            this.emit("C|" + id + "|Scroll"); this.emit("S|" + id + "|" + listS.str())
            this.emit("I|" + id + "|" + parent + "|" + string(index))
            const cS: Style = new Style(); cS.h = contentH
            this.emit("C|" + contentId + "|View"); this.emit("S|" + contentId + "|" + cS.str())
            this.emit("I|" + contentId + "|" + id + "|0")
            this.listCount = count; this.listContentH = contentH
        } else if (contentH != this.listContentH) {   // count, header, or footer changed the height
            const cS: Style = new Style(); cS.h = contentH
            this.emit("S|" + contentId + "|" + cS.str())
            this.listCount = count; this.listContentH = contentH
        }

        // Which rows fall in the viewport (± buffer). Inverted flips the mapping: top
        // decreases as r grows, so the near/far viewport edges swap which r they bound.
        // Window on GRID ROWS (each holds `ncol` cells), then expand to item ranks. For a plain
        // list ncol==1, so a grid row is a row and this is unchanged.
        var gr0: int = 0
        var gr1: int = 0
        if (inverted) {
            gr0 = (invBase - (this.vpTop + this.vpH)) / stride - buffer
            gr1 = (invBase - this.vpTop) / stride + buffer + 1
        } else {
            gr0 = (this.vpTop - rowsTop) / stride - buffer
            gr1 = (this.vpTop + this.vpH - rowsTop) / stride + buffer + 1
        }
        if (gr0 < 0) { gr0 = 0 }
        if (gr1 > gridRows) { gr1 = gridRows }
        if (gr1 < gr0) { gr1 = gr0 }
        var r0: int = gr0 * ncol
        var r1: int = gr1 * ncol
        if (r1 > count) { r1 = count }

        // ---- VIEW RECYCLING (the FlashList trick) --------------------------------
        // A fixed POOL of cell views ("<content>.cell<i>"). On scroll we don't destroy
        // the rows that leave and create the ones that enter — we REBIND a leaving
        // cell to the entering row: reconcile() diffs its old node against the new
        // one and emits only the changed text / position (S|/P|), reusing the native
        // view. Result: during a fling, ~zero Create/Remove mutations — only cheap
        // content updates — so the native side never churns view + Yoga-node allocs.
        var freeCells: []string = []           // cells whose current rank fell out of the window
        var rankCell: map[string]string = {}    // rank (as string) still on-screen -> the cell showing it
        for (var i: int = 0; i < this.poolSize; i = i + 1) {
            const cid: string = contentId + ".cell" + string(i)
            const cr: int = this.cellRank.getOr(cid, -1)
            if (cr >= r0 && cr < r1) { rankCell[string(cr)] = cid } else { freeCells.push(cid) }
        }

        const newMounted: []string = []
        var fi: int = 0                          // next free cell to hand out
        for (var r: int = r0; r < r1; r = r + 1) {
            var cid: string = ""
            const kept: string? = rankCell.get(string(r))
            if (kept != null) { cid = kept }                  // this row is already on a cell: reuse in place
            else if (fi < freeCells.length) { cid = freeCells[fi]; fi = fi + 1 }   // recycle a leaving cell
            else { cid = contentId + ".cell" + string(this.poolSize); this.poolSize = this.poolSize + 1 }  // grow the pool
            const gridRow: int = r / ncol
            const top: int = inverted ? invBase - r * stride : rowsTop + gridRow * stride
            const node: Node = itemFn(r, top)
            // Grid: the list owns each cell's column x + width; override them on the node so the
            // app's item builder stays layout-agnostic. `right` is cleared so width wins.
            if (ncol > 1 && colW > 0) {
                const col: int = r % ncol
                node.style.left = pad + col * (colW + gap)
                node.style.w = colW
                node.style.right = -1
            }
            const pn: Node? = this.itemNodes.get(cid)         // the node this cell last showed (null on first use)
            this.reconcile(pn, node, cid, contentId, 0)       // diff -> minimal S|/P|, no C|/R| when recycling
            this.itemNodes[cid] = node
            this.cellRank[cid] = r
            newMounted.push(cid)
        }
        // Leftover free cells (a shrinking window) stay mounted but off-screen at their
        // stale top — reusable next frame. They keep their cellRank, so if that rank
        // scrolls back in they're kept in place. No churn.
        this.mounted = newMounted

        // onVisible: report the centered row (the one under the middle of the viewport) when
        // it changes, so a feed can set that cell's Video playing = true. Queued, not called
        // inline, so the closure's setState runs after this render (see flushVisible).
        const vf: any = d.get("onVisible")
        if (vf != null && count > 0 && stride > 0) {
            var centered: int = inverted ? (invBase - (this.vpTop + this.vpH / 2)) / stride : (this.vpTop + this.vpH / 2 - rowsTop) / stride
            if (centered < 0) { centered = 0 }
            if (centered >= count) { centered = count - 1 }
            if (centered != this.listVisible.getOr(id, -1)) {
                this.listVisible[id] = centered
                const idx: int = centered
                this.pendingVisible.push(function(): void { vf(idx) })
            }
        }
        // onEndReached: infinite scroll. Fire when the last visible row reaches within
        // `endThreshold` of the end. Fired once per `count` (recorded in listEndFired), so a
        // steady view at the bottom doesn't spam it; when the app appends data (count grows)
        // it can fire again. Queued like onVisible so its setState runs after this render.
        const ef: any = d.get("onEndReached")
        if (ef != null && count > 0 && stride > 0) {
            const threshold: int = lpInt(d, "endThreshold", 0)
            // The "end" is the far edge of the data: the bottom row normally, or the TOP row
            // when inverted (a chat scrolling up to load older messages). In a grid the last
            // visible GRID ROW covers up to `ncol` ranks, so convert to the last visible rank.
            const lastGridRow: int = inverted ? (invBase - this.vpTop) / stride : (this.vpTop + this.vpH - rowsTop) / stride
            const lastVisible: int = ncol > 1 ? (lastGridRow + 1) * ncol - 1 : lastGridRow
            if (lastVisible >= count - 1 - threshold && this.listEndFired.getOr(id, -1) != count) {
                this.listEndFired[id] = count
                this.pendingVisible.push(function(): void { ef() })
            }
        }
        // onRefresh: pull-to-refresh on the List's own scroll (reuses the Scroll path). The
        // parent owns `refreshing` and clears it when the work is done to stop the spinner.
        const rf: any = d.get("onRefresh")
        if (rf != null) {
            this.handlers[id] = rf
            const refreshing: int = lpBool(d, "refreshing", false) ? 1 : 0
            const prevR: int = this.listRefreshing.getOr(id, -2)
            if (prevR == -2) { this.emit("T|" + id + "|" + id) }   // enable the refresh control once
            if (refreshing != prevR) {
                this.listRefreshing[id] = refreshing
                const rS: Style = new Style(); rS.rfsh = refreshing
                this.emit("S|" + id + "|" + rS.str())
            }
        }
        // empty: when there are no rows, render the empty-state node (filled to the viewport
        // height) in place of the list; remove it once rows arrive.
        const emptyFn: any = d.get("empty")
        const emptyId: string = contentId + ".empty"
        if (count == 0 && emptyFn != null) {
            const enode: Node = emptyFn(this.vpH)
            const pe: Node? = this.itemNodes.get(emptyId)
            this.reconcile(pe, enode, emptyId, contentId, 0)
            this.itemNodes[emptyId] = enode
        } else if (this.itemNodes.has(emptyId)) {
            this.emit("R|" + emptyId); this.itemNodes.delete(emptyId)
        }
        // header / footer: absolutely-positioned nodes above the rows (top = pad) and below
        // them (top = rowsTop + count*stride). The app positions its node with abs+top like a row.
        const headerFn: any = d.get("header")
        const headerId: string = contentId + ".header"
        if (headerFn != null) {
            const hnode: Node = headerFn(pad)
            this.reconcile(this.itemNodes.get(headerId), hnode, headerId, contentId, 0)
            this.itemNodes[headerId] = hnode; this.listHeaderShown[id] = true
        } else if (this.listHeaderShown.getOr(id, false)) {
            this.emit("R|" + headerId); this.itemNodes.delete(headerId); this.listHeaderShown[id] = false
        }
        const footerFn: any = d.get("footer")
        const footerId: string = contentId + ".footer"
        if (footerFn != null) {
            const fnode: Node = footerFn(rowsTop + count * stride)
            this.reconcile(this.itemNodes.get(footerId), fnode, footerId, contentId, 0)
            this.itemNodes[footerId] = fnode; this.listFooterShown[id] = true
        } else if (this.listFooterShown.getOr(id, false)) {
            this.emit("R|" + footerId); this.itemNodes.delete(footerId); this.listFooterShown[id] = false
        }
        // scrollToIndex / scrollToEnd: imperative-style scroll via the declarative model. The
        // host scrolls the list to a content-offset (LS|id|y), animated. scrollToIndex brings
        // that row to the top (below the header); it re-fires when the value changes. scrollToEnd
        // is a NONCE (bump it to re-pin to newest, e.g. on each appended chat message) and scrolls
        // to the very bottom using the just-computed contentH, so it lands after any new rows.
        const sti: int = lpInt(d, "scrollToIndex", -1)
        if (sti >= 0 && sti != this.listScrollIdx.getOr(id, -999)) {
            this.listScrollIdx[id] = sti
            const stiY: int = inverted ? invBase - sti * stride : rowsTop + sti * stride
            this.emit("LS|" + id + "|" + string(stiY))
        }
        const ste: int = lpInt(d, "scrollToEnd", 0)
        if (ste != this.listScrollEnd.getOr(id, 0)) {
            this.listScrollEnd[id] = ste
            var endY: int = contentH - this.vpH
            if (endY < 0) { endY = 0 }
            this.emit("LS|" + id + "|" + string(endY))
        }
        // inverted: on first mount, land at the bottom (row 0 = newest). Tracked via
        // listScrollEnd so we don't re-scroll every frame; the app bumps `scrollToEnd` to
        // re-pin to newest after that. (contentH - vpH; the host clamps to the real max.)
        if (inverted && prev == null) {
            this.listScrollEnd[id] = lpInt(d, "scrollToEnd", 0)
            var invY: int = contentH - this.vpH
            if (invY < 0) { invY = 0 }
            this.emit("LS|" + id + "|" + string(invY))
        }
        // onScroll: report the scroll offset (points) whenever it changes, so an app can drive
        // a parallax header, a scroll-to-top button, etc. Queued like onVisible (fired after
        // render); opt-in, so a list without onScroll pays nothing.
        const osf: any = d.get("onScroll")
        if (osf != null && this.vpTop != this.listScrollPos.getOr(id, -1)) {
            this.listScrollPos[id] = this.vpTop
            const off: int = this.vpTop
            this.pendingVisible.push(function(): void { osf(off) })
        }
    }

    // A HORIZONTAL virtualized list (a carousel / story reel). Same windowed cell-recycling
    // as reconcileList, but the main axis is x: the host scrolls sideways and reports its
    // x-offset + width as the scroll window (vpTop/vpH), so the windowing math is unchanged;
    // only the layout flips. Cells fill the list HEIGHT (the app sizes the cross axis) and the
    // reconciler places each at its x (left) with a fixed `itemWidth`.
    reconcileHList(prev: Node?, next: Node, id: string, parent: string, index: int): void {
        const d: map[string]ListProp = next.data
        const count: int = lpInt(d, "count", 0)
        const itemW: int = lpInt(d, "itemWidth", 0)
        const gap: int = lpInt(d, "gap", 0)
        const pad: int = lpInt(d, "pad", 0)
        const stride: int = itemW + gap
        const buffer: int = lpInt(d, "buffer", 3)
        const itemFn: any = d.get("item")
        const contentId: string = id + ".0"
        const leftStart: int = pad
        const contentW: int = leftStart + count * stride + pad

        if (prev == null) {
            this.mounted = []; this.itemNodes = {}; this.cellRank = {}; this.poolSize = 0
            const listS: Style = new Style(); listS.grow = 1; listS.basis = 0; listS.horiz = 1
            if (lpBool(d, "paging", false)) { listS.paging = 1 }   // snap one item per screen
            // A distinct kind so a host that needs a different scroll class for the x-axis
            // (Android's HorizontalScrollView) creates the right view; the `horiz` style tells
            // the others (UIKit/SwiftUI reuse their vertical scroll view on the x-axis).
            this.emit("C|" + id + "|HScroll"); this.emit("S|" + id + "|" + listS.str())
            this.emit("I|" + id + "|" + parent + "|" + string(index))
            const cS: Style = new Style(); cS.w = contentW           // content is WIDE; height fills
            this.emit("C|" + contentId + "|View"); this.emit("S|" + contentId + "|" + cS.str())
            this.emit("I|" + contentId + "|" + id + "|0")
            this.listCount = count; this.listContentH = contentW
        } else if (contentW != this.listContentH) {
            const cS: Style = new Style(); cS.w = contentW
            this.emit("S|" + contentId + "|" + cS.str())
            this.listCount = count; this.listContentH = contentW
        }

        // Windowing runs along the X axis: vpTop is the scroll's x-offset and vpW the
        // viewport WIDTH (the host reports true width/height; it does not swap them).
        var c0: int = (this.vpTop - leftStart) / stride - buffer
        if (c0 < 0) { c0 = 0 }
        var c1: int = (this.vpTop + this.vpW - leftStart) / stride + buffer + 1
        if (c1 > count) { c1 = count }
        if (c1 < c0) { c1 = c0 }

        var freeCells: []string = []
        var rankCell: map[string]string = {}
        for (var i: int = 0; i < this.poolSize; i = i + 1) {
            const cid: string = contentId + ".cell" + string(i)
            const cr: int = this.cellRank.getOr(cid, -1)
            if (cr >= c0 && cr < c1) { rankCell[string(cr)] = cid } else { freeCells.push(cid) }
        }

        const newMounted: []string = []
        var fi: int = 0
        for (var c: int = c0; c < c1; c = c + 1) {
            var cid: string = ""
            const kept: string? = rankCell.get(string(c))
            if (kept != null) { cid = kept }
            else if (fi < freeCells.length) { cid = freeCells[fi]; fi = fi + 1 }
            else { cid = contentId + ".cell" + string(this.poolSize); this.poolSize = this.poolSize + 1 }
            const left: int = leftStart + c * stride
            const node: Node = itemFn(c, pad)                 // pass the cross-axis top (pad); we own x
            node.style.left = left; node.style.w = itemW; node.style.right = -1
            const pn: Node? = this.itemNodes.get(cid)
            this.reconcile(pn, node, cid, contentId, 0)
            this.itemNodes[cid] = node
            this.cellRank[cid] = c
            newMounted.push(cid)
        }
        this.mounted = newMounted

        // onVisible: the item under the horizontal center.
        const vf: any = d.get("onVisible")
        if (vf != null && count > 0 && stride > 0) {
            var centered: int = (this.vpTop + this.vpH / 2 - leftStart) / stride
            if (centered < 0) { centered = 0 }
            if (centered >= count) { centered = count - 1 }
            if (centered != this.listVisible.getOr(id, -1)) {
                this.listVisible[id] = centered
                const idx: int = centered
                this.pendingVisible.push(function(): void { vf(idx) })
            }
        }
        // onEndReached: near the right edge.
        const ef: any = d.get("onEndReached")
        if (ef != null && count > 0 && stride > 0) {
            const threshold: int = lpInt(d, "endThreshold", 0)
            const lastVisible: int = (this.vpTop + this.vpH - leftStart) / stride
            if (lastVisible >= count - 1 - threshold && this.listEndFired.getOr(id, -1) != count) {
                this.listEndFired[id] = count
                this.pendingVisible.push(function(): void { ef() })
            }
        }
        // scrollToIndex / scrollToEnd along x (reuses the LS command; host reports/moves x).
        const sti: int = lpInt(d, "scrollToIndex", -1)
        if (sti >= 0 && sti != this.listScrollIdx.getOr(id, -999)) {
            this.listScrollIdx[id] = sti
            this.emit("LS|" + id + "|" + string(leftStart + sti * stride))
        }
        const ste: int = lpInt(d, "scrollToEnd", 0)
        if (ste != this.listScrollEnd.getOr(id, 0)) {
            this.listScrollEnd[id] = ste
            var endX: int = contentW - this.vpH
            if (endX < 0) { endX = 0 }
            this.emit("LS|" + id + "|" + string(endX))
        }
        // onScroll: report the x offset when it changes.
        const osf: any = d.get("onScroll")
        if (osf != null && this.vpTop != this.listScrollPos.getOr(id, -1)) {
            this.listScrollPos[id] = this.vpTop
            const off: int = this.vpTop
            this.pendingVisible.push(function(): void { osf(off) })
        }
    }

    // Like reconcileList but SECTIONED: sections each contribute a header (headerH)
    // + rowsFn(s) rows (rowH+gap each). Cells are absolutely positioned at their
    // running offset; only the on-screen window (± buffer) is mounted. Reuses the
    // shared windowing state (mounted / itemNodes / listCount / vpTop / vpH).
    reconcileSectionList(prev: Node?, next: Node, id: string, parent: string, index: int): void {
        const d: map[string]ListProp = next.data
        const sectionCount: int = lpInt(d, "sectionCount", 0)
        const rowH: int = lpInt(d, "rowHeight", 0)
        const headerH: int = lpInt(d, "headerHeight", 0)
        const gap: int = lpInt(d, "gap", 0)
        const pad: int = lpInt(d, "pad", 0)
        const stride: int = rowH + gap
        const buffer: int = lpInt(d, "buffer", 3)
        const rowsFn: any = d.get("rows")
        const keyFn: any = d.get("key")
        const headerFn: any = d.get("header")
        const itemFn: any = d.get("item")
        const contentId: string = id + ".0"

        // total content height (uniform cells, so a single pass over sections)
        var total: int = pad
        for (var s0: int = 0; s0 < sectionCount; s0 = s0 + 1) {
            const nr0: int = int(rowsFn(s0))
            total = total + headerH + nr0 * stride
        }
        total = total + pad
        const contentH: int = total

        if (prev == null) {
            this.mounted = []
            this.itemNodes = {}
            const listS: Style = new Style(); listS.grow = 1; listS.basis = 0
            this.emit("C|" + id + "|Scroll"); this.emit("S|" + id + "|" + listS.str())
            this.emit("I|" + id + "|" + parent + "|" + string(index))
            const cS: Style = new Style(); cS.h = contentH
            this.emit("C|" + contentId + "|View"); this.emit("S|" + contentId + "|" + cS.str())
            this.emit("I|" + contentId + "|" + id + "|0")
            this.listCount = contentH
        } else if (contentH != this.listCount) {
            const cS: Style = new Style(); cS.h = contentH
            this.emit("S|" + contentId + "|" + cS.str())
            this.listCount = contentH
        }

        const vpLo: int = this.vpTop - buffer * stride
        const vpHi: int = this.vpTop + this.vpH + buffer * stride
        const desired: []string = []

        var off: int = pad
        for (var s: int = 0; s < sectionCount; s = s + 1) {
            const nr: int = int(rowsFn(s))
            const secBottom: int = off + headerH + nr * stride
            if (secBottom >= vpLo && off <= vpHi) {
                const hid: string = contentId + ".h" + string(s)
                desired.push(hid)
                const hnode: Node = headerFn(s, off)
                const hWas: bool = this.containsStr(this.mounted, hid)
                const hpn: Node? = hWas ? this.itemNodes.get(hid) : null
                this.reconcile(hpn, hnode, hid, contentId, 0)
                this.itemNodes[hid] = hnode
                const rowsTop: int = off + headerH
                var r0: int = (vpLo - rowsTop) / stride
                if (r0 < 0) { r0 = 0 }
                var r1: int = (vpHi - rowsTop) / stride + 1
                if (r1 > nr) { r1 = nr }
                if (r1 < r0) { r1 = r0 }
                for (var r: int = r0; r < r1; r = r + 1) {
                    const rtop: int = rowsTop + r * stride
                    const rid: string = contentId + ".c" + string(keyFn(s, r))
                    desired.push(rid)
                    const rnode: Node = itemFn(s, r, rtop)
                    const rWas: bool = this.containsStr(this.mounted, rid)
                    const rpn: Node? = rWas ? this.itemNodes.get(rid) : null
                    this.reconcile(rpn, rnode, rid, contentId, 0)
                    this.itemNodes[rid] = rnode
                }
            }
            off = secBottom
        }

        // recycle cells that scrolled out of the window
        for (var m: int = 0; m < this.mounted.length; m = m + 1) {
            const iid: string = this.mounted[m]
            if (!this.containsStr(desired, iid)) { this.emit("R|" + iid) }
        }
        this.mounted = desired
    }
}

// ---- App: the base a screen extends. The framework drives it; you override
//      the hooks (setup/render/onTick/save/load). Your entry is one line:
//        runApp(new MyScreen())
//      -- the host contract below (mount/tick/dispatch/...) is generated here,
//      never in app code. ----------------------------------------------------
// The active App (set in its constructor), so a capability called from anywhere
// can reach the reconciler to enqueue an async command. One app instance exists.
var HOST: App? = null

// ─── Background → render-thread dispatch ─────────────────────────────────────
// Chuks is multithreaded: a spawned task (a WebSocket read pump, a download, a
// timer) runs on its own coroutine and must NOT touch useState or the reconciler
// directly (those are only safe on the render thread, and the cell map is not
// locked). Instead it hands a closure to dispatchAsync(); the closure is queued
// under a lock and RUN on the render thread at the start of the next host entry
// point, where mutating state is safe. wakeHost() asks the native host to tick
// immediately so the closure paints within a frame instead of waiting for the
// idle heartbeat.
@threadSafe
class AsyncQueue {
    var _q: []function(): void
    constructor() { this._q = [] }
    public post(fn: function(): void): void {
        lock (this) { this._q.push(fn) }
        wakeHost()
    }
    // Atomically swap out the pending closures; they are run OUTSIDE the lock (by
    // runAsyncQueue) so a closure that posts again cannot deadlock on the
    // non-reentrant lock.
    public take(): []function(): void {
        var out: []function(): void = []
        lock (this) { out = this._q; this._q = [] }
        return out
    }
    public pending(): int { var n: int = 0; lock (this) { n = this._q.length }; return n }
}

var ASYNC: AsyncQueue = new AsyncQueue()

// Hand a result back to the render thread from a spawned task. The closure runs on
// the render thread at the next host entry point, so it may safely touch useState:
//   c.onMessage(function(m: string): void { dispatchAsync(function(): void { msgs.set(...) }) })
export function dispatchAsync(fn: function(): void): void { ASYNC.post(fn) }

// Queued-closure count (host heartbeat gating / diagnostics).
export function asyncPending(): int { return ASYNC.pending() }

// Run all queued closures on the CURRENT (render) thread, before the render that
// follows, so their state changes are reflected this frame.
function runAsyncQueue(): void {
    var fns: []function(): void = ASYNC.take()
    var i: int = 0
    while (i < fns.length) { fns[i](); i = i + 1 }
}

// Ask the native host to call tick() promptly. Wired to the C-ABI wake callback via
// a runtime builtin; until that lands (and on hosts that never register one) this is
// a no-op and the host's idle heartbeat drains the queue instead.
function wakeHost(): void { host.wake() }

// The per-frame animation stepper. core/animated.chuks wires this (via setFrameStepper)
// the first time an app starts a physics animation (decay/spring); until then it is a
// no-op, so a program with no per-frame physics pays nothing. Returns the count of
// values still animating. When that count crosses 0<->N, App.tick emits FA|1 / FA|0 so
// the host runs its display-link only while physics is live.
var _frameStepper: any = null
export function setFrameStepper(fn: any): void { _frameStepper = fn }

export class App {
    var recon: Reconciler
    var prevFrameActive: int      // last per-frame stepper count (for FA| edge detection)
    constructor() { this.recon = new Reconciler(); this.prevFrameActive = 0; HOST = this }
    // ---- hooks you override ----
    // One-time initialization with a size hint `n` (e.g. seed data). Optional.
    public setup(_n: int): void { }
    // Return the app's UI tree. Called on mount and after every event/tick.
    public render(): Node { return mkView(new Style(), []) }
    // Advance per-frame state before each re-render. Optional.
    public onTick(): void { }
    // Serialize state for hot-reload preservation. Defaults to snapshotting every
    // useState cell, so state survives a reload with no per-app code. Override to
    // customize (e.g. drop transient state or serialize non-JSON values yourself).
    public saveState(): string { return serializeCells() }
    // Restore state from a saveState() string after a hot reload. Defaults to
    // restoring the useState cells captured by saveState().
    public loadState(data: string): void { restoreCells(data) }
    // ---- framework-driven (the native host calls these; don't override) ----
    // Render the tree and emit the initial mutation stream. Returns mutation count.
    // hookBegin/hookSweep bracket every render so component state cells are seeded,
    // reconnected by identity, and freed when a component leaves the tree.
    public mount(): int { runAsyncQueue(); this.recon.begin(); hookBegin(); this.recon.renderRoot(this.render()); runEffects(); hookSweep(); return this.recon.count() }
    // Full re-mount: re-emit the entire current tree (state preserved). The dev server
    // calls this on every /mount so any host that connects or relaunches gets a complete
    // tree, not an empty diff against a tree it never received. Not called in production.
    public remount(): int { this.recon.forgetCommitted(); return this.mount() }
    // Report the visible scroll window (top, height) and re-render. Drives List virtualization.
    public setViewport(top: int, h: int, w: int): int {
        runAsyncQueue()
        if (h > 0) { _vpH = h }   // expose the real viewport height (viewportHeight()) for full-screen feeds
        if (w > 0) { _vpW = w }   // expose the list width (viewportWidth()) for grid column sizing
        this.recon.begin(); hookBegin(); this.recon.setViewport(top, h, w); this.recon.renderRoot(this.render()); runEffects(); hookSweep()
        // A paging List may have queued onVisible callbacks (centered row changed). Fire them,
        // then re-render (WITHOUT begin, so the windowing mutations above are kept) so the newly
        // visible cell's state change (e.g. Video playing) lands in the same frame.
        if (this.recon.flushVisible()) {
            hookBegin(); this.recon.renderRoot(this.render()); runEffects(); hookSweep()
        }
        return this.recon.count()
    }
    // Advance one frame: step per-frame physics, then onTick() + re-render. Emits
    // FA|1 / FA|0 when physics starts / stops so the host runs a display-link only
    // while it is live. Returns the mutation count.
    public tick(): int {
        runAsyncQueue()
        this.recon.begin()
        var active: int = 0                            // advance decay/spring values (updates their cur)
        if (_frameStepper != null) { const f: any = _frameStepper; active = int(f()) }
        if ((active > 0) != (this.prevFrameActive > 0)) { this.recon.emit("FA|" + (active > 0 ? "1" : "0")) }
        this.prevFrameActive = active
        hookBegin(); this.onTick(); this.recon.renderRoot(this.render()); runEffects(); hookSweep()
        return this.recon.count()
    }
    // A native tap arrived for node `tag`: fire its onPress closure, then re-render.
    public dispatch(tag: string): int {
        runAsyncQueue()
        this.recon.begin(); this.recon.fire(tag); hookBegin(); this.recon.renderRoot(this.render()); runEffects(); hookSweep(); return this.recon.count()
    }
    // A native input change arrived for node `tag`: fire its onChange(value), then re-render.
    public dispatchInput(tag: string, value: string): int {
        runAsyncQueue()
        this.recon.begin(); this.recon.fireValue(tag, value); hookBegin(); this.recon.renderRoot(this.render()); runEffects(); hookSweep(); return this.recon.count()
    }
    // A native async result arrived for `token` (F3): fire the registered callback
    // with `payload`, then re-render. Mirrors dispatch, but keyed by an async token
    // rather than a UI node id.
    public resolve(token: string, payload: string): int {
        runAsyncQueue()
        this.recon.begin(); this.recon.fireToken(token, payload); hookBegin(); this.recon.renderRoot(this.render()); runEffects(); hookSweep(); return this.recon.count()
    }
    // The host reports that `token` is dead (user dismissed the picker, native op
    // ended with no result). Drop it and re-render. Mirrors resolve, without a fire.
    public cancelToken(token: string): int {
        runAsyncQueue()
        this.recon.begin(); this.recon.dropToken(token); hookBegin(); this.recon.renderRoot(this.render()); runEffects(); hookSweep(); return this.recon.count()
    }
    // The host reports a FAILURE for `token` (permission denied, hardware missing,
    // native error). Fire the request's error callback and re-render.
    public failToken(token: string, message: string): int {
        runAsyncQueue()
        this.recon.begin(); this.recon.failToken(token, message); hookBegin(); this.recon.renderRoot(this.render()); runEffects(); hookSweep(); return this.recon.count()
    }
    // Return the pending mutation stream as text and hand it to the host.
    public drain(): string { return this.recon.drain() }
}

// A handle to an outstanding native request (async one-shot or a stream). Hold it
// to cancel: `sub.cancel()` drops the callback and tells the host to tear down the
// native op/subscription. For streams, call cancel() in a useEffect cleanup so
// hookSweep tears it down on unmount (no leaked native listener).
export class NativeSub {
    var token: string
    constructor(token: string) { this.token = token }
    public cancel(): void { const h: App? = HOST; if (h != null) { h.recon.cancelStream(this.token) } }
}

/**
 * Request a native capability from the host (the async host->engine bridge).
 * `cap` is the capability id (e.g. "clipboard.get"), `args` a raw string payload
 * (JSON when structured), and `cb` an optional `(string) -> void` fired with the
 * host's result. Returns a NativeSub you can cancel(). Capability wrappers in
 * core/native.chuks call this; app code uses those (Clipboard, Share, ...).
 */
export function emitNativeCommand(cap: string, args: string, cb: any): NativeSub {
    const h: App? = HOST
    if (h != null) { return new NativeSub(h.recon.command(cap, args, cb, null, false)) }
    return new NativeSub("0")
}

/**
 * Like emitNativeCommand, but for a capability that can FAIL: `onErr` (a
 * `(string) -> void`) fires with the host's error message if the request fails
 * (permission denied, hardware missing), instead of `cb`.
 */
export function emitNativeCommandE(cap: string, args: string, cb: any, onErr: any): NativeSub {
    const h: App? = HOST
    if (h != null) { return new NativeSub(h.recon.command(cap, args, cb, onErr, false)) }
    return new NativeSub("0")
}

/**
 * Subscribe to a native STREAM (repeating events: battery, app state, location,
 * sensors). `cb` fires on every event until you cancel the returned NativeSub.
 * `onErr` (optional) fires if the subscription fails. Start streams in a useEffect
 * and cancel() in its cleanup so they tear down on unmount.
 */
export function emitNativeStream(cap: string, args: string, cb: any, onErr: any): NativeSub {
    const h: App? = HOST
    if (h != null) { return new NativeSub(h.recon.command(cap, args, cb, onErr, true)) }
    return new NativeSub("0")
}

// ---- NavStack: named routing ----------------------------------------------
// A screen is a function () -> Node (like RN's JSX component); there is no page
// base class. A NavStack holds a map of named routes to those functions and a
// page stack, renders the top screen, and switches via navigate()/back()/navReplace().

var NAV: NavStack? = null    // the active NavStack (so pages can navigate from anywhere)

export class NavStack extends App {
    // Routes map a name to a screen: a function () -> Node. (Like RN, a screen is
    // just a function that returns Node; there is no page base class to extend.)
    var routes: map[string]function(): Node   // route name -> screen function () -> Node
    var stack: []string           // route-name stack; last = visible page
    constructor(routes: map[string]function(): Node, initial: string) {
        super()
        this.routes = routes
        this.stack = [initial]
        NAV = this
    }
    // Push a route name onto the stack (prefer the navigate() free function).
    public push(name: string): void { this.stack.push(name) }
    // Reset the stack to a single route (prefer the navReplace() free function).
    public replace(name: string): void { this.stack = [name] }
    // Pop the top route, if any remains below it (prefer the back() free function).
    public popStack(): void {
        if (this.stack.length > 1) {
            const s: []string = []
            for (var i: int = 0; i < this.stack.length - 1; i = i + 1) { s.push(this.stack[i]) }
            this.stack = s
        }
    }
    // The current screen function (top of the stack).
    cur(): any { return this.routes[this.stack[this.stack.length - 1]] }
    // Render the current screen LAZILY: wrap it in a Comp so the screen function
    // runs inside the reconciler's top-down walk, with identity "app". This is what
    // lets screens and their components use useState() with no key.
    override render(): Node { const f: any = this.cur(); return Comp(f) }
    override setup(_n: int): void { }
    // Hot reload also preserves the current screen: serialize the route stack ahead
    // of the useState cells so an edit keeps you on the page you were on, not route 0.
    // Format: "<route\t...>\n<cellsJSON>" (cell JSON is single-line, no raw newlines).
    override saveState(): string { return this.stack.join("\t") + "\n" + serializeCells() }
    override loadState(data: string): void {
        if (data == "") { return }
        const parts: []string = data.split("\n")
        if (parts.length < 2) { restoreCells(data); return }   // old format: cells only
        if (parts[0] != "") { this.stack = parts[0].split("\t") }
        var cells: string = parts[1]
        for (var i: int = 2; i < parts.length; i = i + 1) { cells = cells + "\n" + parts[i] }
        restoreCells(cells)
    }
}

/**
 * Push a page onto the navigation stack by its route name (the name you
 * registered in createRoot). Back returns to the current page. Call from any
 * event closure; the re-render after the event shows the new top page.
 *
 * ```chuks
 * Button({ onPress: function(): void { navigate("settings") } }, "Settings")
 * ```
 */
export function navigate(name: string): void { const nv: NavStack? = NAV; if (nv != null) { nv.push(name) } }
/**
 * Replace the whole stack with a single page, so Back cannot return to what came
 * before. Use it for login -> home and logout -> login transitions.
 *
 * ```chuks
 * Button({ onPress: function(): void { navReplace("home") } }, "Log in")
 * ```
 */
export function navReplace(name: string): void { const nv: NavStack? = NAV; if (nv != null) { nv.replace(name) } }
/**
 * Pop the top page and return to the previous one. No-op at the root page.
 *
 * ```chuks
 * Button({ onPress: function(): void { back() } }, "< Back")
 * ```
 */
export function back(): void { const nv: NavStack? = NAV; if (nv != null) { nv.popStack() } }

// NOTE: the native host contract (set_count/mount/tick/...) can't live here --
// the transpiler tree-shakes exported functions that no Chuks code calls (the C
// bridge calls them, which it can't see), and only the ENTRY module's exports
// are emitted with their bare names for cgo. So core/entry.chuks defines them as
// thin forwarders to its App instance -- the one unavoidable bit of C-ABI glue.
