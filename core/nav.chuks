// @chuks/ui -- structural / navigation components: the app skeleton (top bar,
    // bottom tabs, and later sheets/modals/toasts). Token-styled and cross-platform.
//
// Core is ICON-AGNOSTIC (the React Native model, not Flutter's bundled set): it
// never imports an icon package. You pass icons in — a prebuilt node for the bar
// actions, or a render function for the tabs (whose color depends on the active
    // state). Bring @chuks/lucide, or any other icon set, from the app side.
import { Node, Row, Column, Text, Prop, KeyedComp } from "./ui.chuks";
import { tw } from "./tw.chuks";
import { tk } from "./theme.chuks";

// A round, tappable icon button around a NON-NULL icon node. `hasPress` says
// whether `onPress` should be wired (decided by the caller, inline).
//
// Why the caller decides presence and not this function: under AOT, a null
// optional class/function value passed ACROSS a function-call boundary reads back
// non-null (a typed-nil interface), so `icon == null` / `onPress != null` inside a
// callee is unreliable. The `!= null` checks therefore live at the call site in
// NavBar (inline field reads, which are correct), and iconBtn only ever receives a
// real icon plus a plain bool.
function iconBtn(icon: Node, hasPress: bool, onPress: function?(): void): Node {
    var p: map[string]Prop = tw("w-10 h-10 rounded-full items-center justify-center")
    if (hasPress) { const h: any = onPress; p["onPress"] = h }
    return Row(p, [ icon ])
}
// An empty 40x40 slot that balances the bar when a side has no icon.
function iconSpacer(): Node { return Row(tw("w-10 h-10"), []) }

// NavBar props: set only what you need, by name (no positional nulls). `title` is
// required; the rest are optional. `leading`/`trailing` are prebuilt icon nodes
// (build them app-side, e.g. lucide("chevron-left", 22, tk("text"))).
//   NavBar({ title: "Inbox" })
//   NavBar({ title: "Inbox", trailing: gear, onTrailing: openSettings })
export dataType NavBarProps {
    title: string,
    leading: Node?,                 // a prebuilt icon node (e.g. lucide(...))
    onLeading: function?(): void,
    trailing: Node?,
    onTrailing: function?(): void,
}
export function NavBar(p: NavBarProps): Node {
    // Resolve each slot INLINE (see iconBtn's note): the `!= null` checks on the
    // optional props must happen here, at the call site, because the same checks
    // are unreliable once the value crosses into a callee under AOT.
    var leading: Node = iconSpacer()
    if (p.leading != null) { leading = iconBtn(p.leading, p.onLeading != null, p.onLeading) }
    var trailing: Node = iconSpacer()
    if (p.trailing != null) { trailing = iconBtn(p.trailing, p.onTrailing != null, p.onTrailing) }
    return Column(tw("bg-surface"), [
        Row(tw("items-center gap-sm p-md"), [
            leading,
            Text(tw("grow text-lg font-bold text-text"), p.title),
            trailing,
        ]),
        Row(tw("h-1 bg-borderSoft"), []),   // bottom hairline
    ])
}

// TabBar: a bottom tab bar. `iconFor` is a render function
// (name: string, color: string, size: int) -> Node that builds each tab's icon;
// the TabBar calls it with the active/inactive color so selection recolors the
// icon (the RN `tabBarIcon` pattern). `names` is parallel to `labels`.
//   TabBar(["house","bell"], ["Home","Alerts"],
    //          function(n,c,s){ return lucide(n, s, c) }, active, onSelect)
// Build a tab's onPress. The index is a parameter (fresh per call), not a
// captured loop variable, so each tab fires with its own index (a closure that
    // captured the loop var would fire with the last index for every tab).
function tabPress(onSelect: any, idx: int): any {
    return function(): void { const f: any = onSelect; f(idx) }
}

export function TabBar(names: []string, labels: []string, iconFor: any, active: int, onSelect: any): Node {
    var tabs: []Node = []
    for (var i: int = 0; i < names.length; i = i + 1) {
        const sel: bool = i == active
        const col: string = sel ? tk("primary") : tk("subtle")
        var tp: map[string]Prop = tw("grow items-center justify-center gap-xs p-sm")
        if (onSelect != null) { tp["onPress"] = tabPress(onSelect, i) }
        const build: any = iconFor
        const icon: Node = build(names[i], col, 24)
        const lbl: string = sel ? "text-xs font-semibold text-primary" : "text-xs text-subtle"
        tabs.push(Column(tp, [ icon, Text(tw(lbl), labels[i]) ]))
    }
    return Column(tw("bg-surface"), [
        Row(tw("h-1 bg-borderSoft"), []),   // top hairline
        Row(tw("p-sm"), tabs),
    ])
}

// TabView: a bottom-tab scaffold — the active screen above a shared TabBar. It is
// a plain, stateless render function (everything returns Node); the app owns the
// active-tab index (a module-level var) and passes it in, and `onSelect(i)` sets
// it. `screens` is parallel to `icons`/`labels`; each is a () -> Node screen
// function that fills the area above the bar.
//   TabView(["house","bell"], ["Home","Alerts"], iconFor, [Home, Alerts], active, onSelect)
export function TabView(icons: []string, labels: []string, iconFor: any, screens: []any, active: int, onSelect: any): Node {
    const build: any = screens[active]
    return Column(tw("bg-bg"), [
        // Place the active screen lazily, keyed by tab, so it runs with its own
        // identity (its useState is per-tab and doesn't leak to the next tab).
        KeyedComp("tab:" + string(active), build),
        TabBar(icons, labels, iconFor, active, onSelect),
    ])
}
