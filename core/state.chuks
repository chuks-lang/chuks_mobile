// @chuks/ui state -- per-instance component state, keyed by structural identity.
//
// The reconciler calls hookEnter(path) before it runs each component, so a
// component's useState() needs NO key: identity comes from the component's
// position in the tree (keyed by tree position, like React's fiber). State persists in
// `_cells` across renders and is reconnected by identity every render.
//
// App developers use `useState` / `useKeyedState`; the leading-underscore context
// and hookEnter/hookSweep are framework-internal (core/ui.chuks drives them).

import { json } from "std/json";

var _path: string = ""              // identity of the component currently rendering
var _slot: int = 0                  // index within a component (multiple useState per component)
var _fxSlot: int = 0                // index within a component for useEffect calls
// The persistent state boxes, keyed by "path#slot" (or "key:..."). Behind a lock:
// the render thread reads and writes them every frame, and an async handler reads
// them after an await, from its own thread (a write from there is queued, see
// Cell.set). An unlocked map read against a concurrent write is fatal on both
// backends. The lock is uncontended in practice and costs tens of nanoseconds.
@threadSafe
class CellStore {
    var m: map[string]any
    constructor() { this.m = {} }
    public get(k: string): any { var v: any = null; lock (this) { v = this.m.getOr(k, null) }; return v }
    public has(k: string): bool { var h: bool = false; lock (this) { h = this.m.has(k) }; return h }
    public set(k: string, v: any): void { lock (this) { this.m[k] = v } }
    // Write only when the key is present (a set on an unmounted cell is a no-op).
    public setIfPresent(k: string, v: any): bool { var ok: bool = false; lock (this) { if (this.m.has(k)) { this.m[k] = v; ok = true } }; return ok }
    // Seed a key that has no value yet (a cell's initial).
    public seed(k: string, v: any): void { lock (this) { if (!this.m.has(k)) { this.m[k] = v } } }
    public keys(): []string { var ks: []string = []; lock (this) { ks = this.m.keys() }; return ks }
    public replace(next: map[string]any): void { lock (this) { this.m = next } }
    public snapshot(): string { var out: string = ""; lock (this) { out = json.stringify(this.m) }; return out }
}
var _cells: CellStore = new CellStore()
var _seen: map[string]bool = {}     // cell keys touched this render, for hookSweep()

// ---- state serialization (hot-reload preservation) -------------------------
// Stores ride the state snapshot (hot reload, restoration) beside the cells. The
// store module registers how to save and restore them here, since this module
// cannot import it.
var STORE_SAVE: (function(): map[string]any)? = null
var STORE_LOAD: (function(m: map[string]any): void)? = null
/** Framework-internal: core/store.chuks registers its snapshot hooks. */
export function setStoreSnapshot(save: function(): map[string]any, load: function(m: map[string]any): void): void { STORE_SAVE = save; STORE_LOAD = load }

// Serialize every useState/useKeyedState cell to JSON so the dev server can carry
// state across a `chuks watch` restart. Cells keyed by structural identity, so as
// long as the component tree keeps the same shape the values reconnect on reload.
export function serializeCells(): string {
    const save: any = STORE_SAVE
    if (save == null) { return _cells.snapshot() }
    // One JSON object: the cells, plus each store under "store:<name>".
    const m: map[string]any = json.parse(_cells.snapshot())
    const stores: map[string]any = save()
    const ks: []string = stores.keys()
    for (var i: int = 0; i < ks.length; i = i + 1) { m["store:" + ks[i]] = stores[ks[i]] }
    return json.stringify(m)
}

// Restore cells from serializeCells() output BEFORE the first render, so useState
// finds the preserved value instead of re-seeding its initial. Keys absent from the
// snapshot (new components after a structural edit) fall back to their initial.
export function restoreCells(data: string): void {
    if (data == "") { return }
    const parsed: map[string]any = json.parse(data)
    const ks: []string = parsed.keys()
    var stores: map[string]any = {}
    for (var i: int = 0; i < ks.length; i = i + 1) {
        if (ks[i].startsWith("store:")) { stores[ks[i].slice(6, ks[i].length)] = parsed[ks[i]] }
        else { _cells.set(ks[i], parsed[ks[i]]) }
    }
    const load: any = STORE_LOAD
    if (load != null && stores.keys().length > 0) { load(stores) }
}

// Effect bookkeeping (see useEffect below). Declared up top so hookBegin/hookSweep
// can reference them (Chuks needs types/vars defined before use).
class Effect { var depsKey: string; var cleanup: any; constructor() { this.depsKey = ""; this.cleanup = null } }
class PendingFx { var key: string; var fn: any; var old: any; constructor() { this.key = ""; this.fn = null; this.old = null } }
var _effects: map[string]Effect = {}    // identity -> { depsKey, cleanup }
var _fxSeen: map[string]bool = {}       // effect keys touched this render
var _pendingFx: []PendingFx = []        // effects to run after this render pass

// The hook keys (cells, effects) the component now rendering has touched, in order.
// A component the reconciler skips (nothing of its own changed) does not run, so it
// touches nothing; the reconciler keeps the list from its last run and re-marks the
// keys, or the sweep would take a skipped component for an unmounted one.
var _touched: []string = []
// Framework-internal: called before a component renders to set its identity.
export function hookEnter(path: string): void { _path = path; _slot = 0; _fxSlot = 0; var t: []string = []; _touched = t }
/** Framework-internal: the hook keys touched since hookEnter ("c:" cells, "f:" effects). */
export function hookTouched(): []string { return _touched }
/** Framework-internal: a skipped component's keys count as visited this pass. */
export function hookRetain(keys: []string): void {
    for (var k of keys) {
        if (k.slice(0, 2) == "c:") { _seen[k.slice(2)] = true } else { _fxSeen[k.slice(2)] = true }
    }
}

// Set by any state write, cleared when a render pass begins. The heartbeat reads it to
// decide whether an idle beat needs a render at all: without it the only way to answer
// that question was to render and diff, which is what made a scrolling app drop frames
// twice a second.
//
// A write through a Cell also names the component it belongs to (the path in the cell
// key), so a pass re-runs only the components whose own state changed and reuses
// what every other component produced last time, the way React re-renders the
// component that called setState and not its siblings. A write that names no
// component (`markDirty()`, a keyed cell) re-runs everything, and so does a pass in
// which nothing was marked at all: an event handler that mutated module state and
// relied on the render that follows every event still gets that render.
var _dirty: bool = false
var _dirtyAll: bool = false
var _dirtyPaths: map[string]bool = {}
var _passAll: bool = true                // this pass: every component runs
var _passPaths: map[string]bool = {}     // this pass: the components that run (when not all)
/**
 * Framework-internal: mark that state changed, so the next beat renders, and that
 * EVERY component must re-run (the change belongs to no one component). `Cell.set`
 * marks its own component instead; call this by hand only when you hold state OUTSIDE
 * the cell system (a module-level store) and need the heartbeat to notice a change to
 * it. `requestRender()` in core/ui.chuks is the app-facing form.
 */
export function markDirty(): void { _dirty = true; _dirtyAll = true }
// A cell changed: its component re-runs on the next pass. The key is "<path>#<slot>"
// (a keyed component's path is "key:<k>", still a path). A useKeyedState cell has no
// slot and belongs to whichever component asked for it, so it re-runs everything.
function markDirtyCell(k: string): void {
    _dirty = true
    const hash: int = k.indexOf("#")
    if (hash < 0) { _dirtyAll = true; return }
    _dirtyPaths[k.slice(0, hash)] = true
}
/** Framework-internal: re-run one component (by its identity) on the next render. A store uses this for its readers. */
export function markDirtyPath(path: string): void { _dirty = true; _dirtyPaths[path] = true }
/** Framework-internal: the identity of the component rendering right now ("" outside a render). */
export function renderingPath(): string { return _path }

/**
 * Framework-internal: whether a state write has landed since the last render. The
 * host's idle beat asks this to skip rendering entirely when nothing changed.
 */
export function isDirty(): bool { return _dirty }
/** Framework-internal: clear the dirty flag, called by the render pass once it commits. */
export function clearDirty(): void { _dirty = false }
/** Framework-internal: does every component run this pass? */
export function passRunsAll(): bool { return _passAll }
/** Framework-internal: does the component at `path` run this pass? */
export function passRuns(path: string): bool { return _passAll || _passPaths.getOr(path, false) }

// ─── The render thread ───────────────────────────────────────────────────────
//
// State, the reconciler and navigation belong to one thread: the engine's main
// coroutine, where the host's calls (mount, dispatch, tick) run. Chuks is
// multithreaded, and an `async function` body or a spawned task runs on its own
// coroutine. Code there must not write a cell or push a route directly; it hands
// the write over, and the write runs on the render thread at the next host entry.
//
// The framework does the handing over itself: every entry point that mutates
// (Cell.set, navigate and friends, toast, one-shot capabilities) asks
// onRenderThread() and, when the answer is no, queues itself through onRender().
// An app author never sees the boundary; an async handler reads as straight code.
//
// The test is the language's: the host enters the engine on its main coroutine,
// where Task.current() is null, and every async body or spawned task runs inside
// a task. Verified on the VM, AOT, and the on-device dev runtime on both hosts.

/**
 * Is this code running on the render thread (the engine's main coroutine, where
 * the host's calls run)? False inside an `async function` body or a spawned task,
 * and inside any helper or closure they call.
 */
export function onRenderThread(): bool { return Task.current() == null }

// The queue that carries a closure to the render thread. ui.chuks installs its
// AsyncQueue here at load (this module cannot import ui.chuks back).
var RENDER_POST: any = null

/** Framework-internal: install the render-thread queue (ui.chuks does this). */
export function setRenderPost(post: function(fn: function(): void): void): void { RENDER_POST = post }

/**
 * Run `fn` on the render thread: right now when already there, otherwise queued to
 * run at the next host entry point, in order with everything else queued. This is
 * what the framework's own entry points use; app code rarely needs it, because
 * `Cell.set`, `navigate`, `toast` and the capabilities already go through it.
 */
export function onRender(fn: function(): void): void {
    if (Task.current() == null) { fn(); return }
    const post: any = RENDER_POST
    if (post != null) { post(fn); return }
    fn()   // no framework loaded (a bare test): nothing else owns the thread
}

/**
 * A typed handle to one piece of component state, returned by `useState`.
 *
 * `Cell<T>` is purely a handle: the value lives in the shared cell store keyed by the
 * component's identity, so `T` types only the get/set surface (`get()` returns T, no
 * cast). Inference usually fills T from the initial value (`useState(0)` gives
 * `Cell<int>`); annotate, or pass an explicit type argument, for empty collections
 * (`useState<[]string>([])`).
 *
 * `set()` on a cell whose component has unmounted is a deliberate no-op rather than
 * an error or a resurrected cell, so a late async or stream callback firing into a
 * screen the user already left is harmless.
 *
 * ```chuks
 * const count: Cell<int> = useState(0)
 * const n: int = count.get()
 * count.set(n + 1)                      // marks state dirty; the next beat renders
 * ```
 */
export class Cell<T> {
    var k: string
    constructor(k: string) { this.k = k }
    // Safe from any thread: the store is locked. What comes back is the value as it is
    // now; a collection is the same object the render thread holds, so an async body
    // that will change one should copy it rather than mutate it in place.
    public get(): T { return _cells.get(this.k) }
    // Only update a cell that still exists. While the component is mounted useState
    // seeds it, so set() works; after it unmounts hookSweep drops the cell, so set()
    // is a no-op instead of resurrecting a dead cell. This makes a late async/stream
    // callback firing into an unmounted component harmless (React's "setState on an
    // unmounted component is a no-op"): the fire-after-unmount race lands here.
    //
    // From an async body or a spawned task the write is queued for the render thread
    // (see onRender above): the cell store is not locked, and only that thread may
    // touch it. The set lands at the next host entry, within a frame.
    public set(v: T): void {
        if (Task.current() != null) {
            const cell: Cell<T> = this
            onRender(function(): void { cell.set(v) })
            return
        }
        if (_cells.setIfPresent(this.k, v)) { markDirtyCell(this.k) }
    }
}

/**
 * Declare a piece of local component state. No key needed -- identity comes from
 * the component's position in the tree -- and it holds any type. Returns a Cell:
 * read `cell.get()` (cast to your type), write `cell.set(v)`.
 *
 * ```chuks
 * var count = useState(0)          // Cell<int> by inference
 * var n: int = count.get()         // typed, no cast
 * Button({ onPress: () => count.set(count.get() + 1) }, string(n))
 * ```
 */
export function useState<T>(initial: T): Cell<T> {
    var k: string = _path + "#" + string(_slot)
    _slot = _slot + 1
    _seen[k] = true; _touched.push("c:" + k)
    _cells.seed(k, initial)
    return new Cell<T>(k)
}

/**
 * Explicit-key state for a hand-rolled loop of stateful items. Prefer `List`
 * (its rows are already keyed) for dynamic collections; use this only when you
 * build a fixed set of stateful children yourself and want stable identity.
 *
 * ```chuks
 * var open = useKeyedState("row:" + string(id), false)
 * ```
 */
export function useKeyedState<T>(key: string, initial: T): Cell<T> {
    var k: string = "key:" + key
    _seen[k] = true; _touched.push("c:" + k)
    _cells.seed(k, initial)
    return new Cell<T>(k)
}

var _parked: []string = []
/**
 * Framework-internal (a navigator calls this; apps do not). Declare the identities
 * that are MOUNTED BUT NOT RENDERED this pass, so their state survives the sweep.
 *
 * Only the visible route renders. Without this the sweep would treat every screen
 * stacked beneath it as unmounted, drop its cells and run its effect cleanups, and
 * popping back would land on a screen that had forgotten which tab you were on, where
 * it was scrolled, everything the user had set up.
 *
 * `prefixes` are cell-key prefixes, i.e. a keyed component's path. hookBegin clears
 * the list every pass, so an app with no navigator retains nothing and a route that
 * is actually popped is swept the moment it stops being declared.
 */
// Park hook identities under these key prefixes: their state and effects survive
// untouched instead of being swept as unmounted. ACCUMULATES within a render pass
// (hookBegin clears it), because a pass can now have two navigators in it: the app
// stack parks its deep entries, and a tab that owns its history parks its own. An
// assignment here would silently drop whichever called first, and the symptom would
// be a screen losing its state only when it was nested.
export function hookPark(prefixes: []string): void {
    for (var i: int = 0; i < prefixes.length; i = i + 1) { _parked.push(prefixes[i]) }
}
function isParked(key: string): bool {
    for (var i: int = 0; i < _parked.length; i = i + 1) {
        const p: string = _parked[i]
        if (key.length >= p.length && key.slice(0, p.length) == p) { return true }
    }
    return false
}

// Framework-internal: begin a render pass (clear the visited sets + effect queue).
export function hookBegin(): void {
    var e1: map[string]bool = {}; _seen = e1
    var e2: map[string]bool = {}; _fxSeen = e2
    var e3: []PendingFx = []; _pendingFx = e3
    var e4: []string = []; _parked = e4
    // Take the pending writes as this pass's plan, and start collecting the next
    // pass's: a write during this pass (an effect that sets state) lands in the next
    // one instead of being cleared with it. Nothing marked means everything runs.
    _passAll = _dirtyAll || _dirtyPaths.keys().length == 0
    _passPaths = _dirtyPaths
    var e5: map[string]bool = {}; _dirtyPaths = e5
    _dirtyAll = false; _dirty = false
}

// Framework-internal: after a render, drop cells whose identity was not visited
// (a component that unmounted), so a later remount at the same path starts fresh.
// Also run cleanup for any effect whose component unmounted.
export function hookSweep(): void {
    var live: map[string]any = {}
    var ks: []string = _cells.keys()
    for (var i: int = 0; i < ks.length; i = i + 1) {
        var key: string = ks[i]
        if (_seen.getOr(key, false) || isParked(key)) { live[key] = _cells.get(key) }
    }
    _cells.replace(live)
    // effects: run cleanup for identities not visited this render, then drop them.
    var liveFx: map[string]Effect = {}
    var fks: []string = _effects.keys()
    for (var j: int = 0; j < fks.length; j = j + 1) {
        var fk: string = fks[j]
        var ev: Effect? = _effects.get(fk)
        if (ev != null) {
            if (_fxSeen.getOr(fk, false) || isParked(fk)) { liveFx[fk] = ev }
            else { if (ev.cleanup != null) { var c: any = ev.cleanup; c() } }
        }
    }
    _effects = liveFx
}

// ---- Effects (useEffect): side effects that run after the render commits, on
//      mount and whenever a dependency changes, with cleanup on re-run/unmount.

function depsKeyOf(deps: []any): string {
    var s: string = ""
    for (var i: int = 0; i < deps.length; i = i + 1) { s = s + "|" + string(deps[i]) }
    return s
}

/**
 * Run a side effect after the component renders: on first mount, and again
 * whenever any value in `deps` changes. `fn` returns an OPTIONAL cleanup (a
 * function, or null) that runs before the next re-run and when the component
 * unmounts. Pass `[]` for run-once-on-mount.
 *
 * ```chuks
 * useEffect(() => {
 *     var id = startTimer()
 *     return () => stopTimer(id)   // cleanup on unmount
 * }, [])
 * ```
 */
export function useEffect(fn: any, deps: []any): void {
    var key: string = _path + "!" + string(_fxSlot)
    _fxSlot = _fxSlot + 1
    _fxSeen[key] = true; _touched.push("f:" + key)
    var dk: string = depsKeyOf(deps)
    var prev: Effect? = _effects.get(key)
    if (prev == null || prev.depsKey != dk) {
        var old: any = prev != null ? prev.cleanup : null
        var e: Effect = new Effect(); e.depsKey = dk; e.cleanup = old
        _effects[key] = e
        var p: PendingFx = new PendingFx(); p.key = key; p.fn = fn; p.old = old
        _pendingFx.push(p)
    }
}

// Framework-internal: run queued effects after the render commits. Each pending
// effect runs its previous cleanup (if deps changed), then fn(), storing the new
// cleanup it returns.
export function runEffects(): void {
    for (var i: int = 0; i < _pendingFx.length; i = i + 1) {
        var p: PendingFx = _pendingFx[i]
        if (p.old != null) { var c: any = p.old; c() }
        var f: any = p.fn
        var cleanup: any = f()
        var e: Effect? = _effects.get(p.key)
        if (e != null) { e.cleanup = cleanup }
    }
    var empty: []PendingFx = []; _pendingFx = empty
}
