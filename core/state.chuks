// @chuks/ui state -- per-instance component state, keyed by structural identity.
//
// The reconciler calls hookEnter(path) before it runs each component, so a
// component's useState() needs NO key: identity comes from the component's
// position in the tree (keyed by tree position, like React's fiber). State persists in
// `_cells` across renders and is reconnected by identity every render.
//
// App developers use `useState` / `useKeyedState`; the leading-underscore context
// and hookEnter/hookSweep are framework-internal (core/ui.chuks drives them).

import { json } from "std/json";

var _path: string = ""              // identity of the component currently rendering
var _slot: int = 0                  // index within a component (multiple useState per component)
var _fxSlot: int = 0                // index within a component for useEffect calls
var _cells: map[string]any = {}     // persistent state boxes, keyed by "path#slot" (or "key:...")
var _seen: map[string]bool = {}     // cell keys touched this render, for hookSweep()

// ---- state serialization (hot-reload preservation) -------------------------
// Serialize every useState/useKeyedState cell to JSON so the dev server can carry
// state across a `chuks watch` restart. Cells keyed by structural identity, so as
// long as the component tree keeps the same shape the values reconnect on reload.
export function serializeCells(): string { return json.stringify(_cells) }

// Restore cells from serializeCells() output BEFORE the first render, so useState
// finds the preserved value instead of re-seeding its initial. Keys absent from the
// snapshot (new components after a structural edit) fall back to their initial.
export function restoreCells(data: string): void {
    if (data == "") { return }
    const parsed: map[string]any = json.parse(data)
    const ks: []string = parsed.keys()
    for (var i: int = 0; i < ks.length; i = i + 1) { _cells[ks[i]] = parsed[ks[i]] }
}

// Effect bookkeeping (see useEffect below). Declared up top so hookBegin/hookSweep
// can reference them (Chuks needs types/vars defined before use).
class Effect { var depsKey: string; var cleanup: any; constructor() { this.depsKey = ""; this.cleanup = null } }
class PendingFx { var key: string; var fn: any; var old: any; constructor() { this.key = ""; this.fn = null; this.old = null } }
var _effects: map[string]Effect = {}    // identity -> { depsKey, cleanup }
var _fxSeen: map[string]bool = {}       // effect keys touched this render
var _pendingFx: []PendingFx = []        // effects to run after this render pass

// Framework-internal: called before a component renders to set its identity.
export function hookEnter(path: string): void { _path = path; _slot = 0; _fxSlot = 0 }

// A typed handle to one state cell. `Cell<T>` is purely a handle: the value lives
// in the shared `_cells` store, so T only types the get/set surface (get() returns
// T, no cast). Read with get(), write set(v). Inference usually fills T from the
// initial value (useState(0) -> Cell<int>); annotate or pass an explicit type arg
// for empty collections (useState<[]string>([]) -> Cell<[]string>).
// Set by any state write, cleared after a render. The heartbeat reads it to decide
// whether an idle beat needs a render at all: without it the only way to answer that
// question was to render and diff, which is what made a scrolling app drop frames
// twice a second.
var _dirty: bool = false
export function markDirty(): void { _dirty = true }
export function isDirty(): bool { return _dirty }
export function clearDirty(): void { _dirty = false }

export class Cell<T> {
    var k: string
    constructor(k: string) { this.k = k }
    public get(): T { return _cells.getOr(this.k, null) }
    // Only update a cell that still exists. While the component is mounted useState
    // seeds it, so set() works; after it unmounts hookSweep drops the cell, so set()
    // is a no-op instead of resurrecting a dead cell. This makes a late async/stream
    // callback firing into an unmounted component harmless (React's "setState on an
    // unmounted component is a no-op"): the fire-after-unmount race lands here.
    public set(v: T): void { if (_cells.has(this.k)) { _cells[this.k] = v; markDirty() } }
}

/**
 * Declare a piece of local component state. No key needed -- identity comes from
 * the component's position in the tree -- and it holds any type. Returns a Cell:
 * read `cell.get()` (cast to your type), write `cell.set(v)`.
 *
 * ```chuks
 * var count = useState(0)          // Cell<int> by inference
 * var n: int = count.get()         // typed, no cast
 * Button({ onPress: function(): void { count.set(count.get() + 1) } }, string(n))
 * ```
 */
export function useState<T>(initial: T): Cell<T> {
    var k: string = _path + "#" + string(_slot)
    _slot = _slot + 1
    _seen[k] = true
    if (!_cells.has(k)) { _cells[k] = initial }
    return new Cell<T>(k)
}

/**
 * Explicit-key state for a hand-rolled loop of stateful items. Prefer `List`
 * (its rows are already keyed) for dynamic collections; use this only when you
 * build a fixed set of stateful children yourself and want stable identity.
 *
 * ```chuks
 * var open = useKeyedState("row:" + string(id), false)
 * ```
 */
export function useKeyedState<T>(key: string, initial: T): Cell<T> {
    var k: string = "key:" + key
    _seen[k] = true
    if (!_cells.has(k)) { _cells[k] = initial }
    return new Cell<T>(k)
}

var _parked: []string = []
/**
 * Framework-internal (a navigator calls this; apps do not). Declare the identities
 * that are MOUNTED BUT NOT RENDERED this pass, so their state survives the sweep.
 *
 * Only the visible route renders. Without this the sweep would treat every screen
 * stacked beneath it as unmounted, drop its cells and run its effect cleanups, and
 * popping back would land on a screen that had forgotten which tab you were on, where
 * it was scrolled, everything the user had set up.
 *
 * `prefixes` are cell-key prefixes, i.e. a keyed component's path. hookBegin clears
 * the list every pass, so an app with no navigator retains nothing and a route that
 * is actually popped is swept the moment it stops being declared.
 */
export function hookPark(prefixes: []string): void { _parked = prefixes }
function isParked(key: string): bool {
    for (var i: int = 0; i < _parked.length; i = i + 1) {
        const p: string = _parked[i]
        if (key.length >= p.length && key.slice(0, p.length) == p) { return true }
    }
    return false
}

// Framework-internal: begin a render pass (clear the visited sets + effect queue).
export function hookBegin(): void {
    var e1: map[string]bool = {}; _seen = e1
    var e2: map[string]bool = {}; _fxSeen = e2
    var e3: []PendingFx = []; _pendingFx = e3
    var e4: []string = []; _parked = e4
}

// Framework-internal: after a render, drop cells whose identity was not visited
// (a component that unmounted), so a later remount at the same path starts fresh.
// Also run cleanup for any effect whose component unmounted.
export function hookSweep(): void {
    var live: map[string]any = {}
    var ks: []string = _cells.keys()
    for (var i: int = 0; i < ks.length; i = i + 1) {
        var key: string = ks[i]
        if (_seen.getOr(key, false) || isParked(key)) { live[key] = _cells[key] }
    }
    _cells = live
    // effects: run cleanup for identities not visited this render, then drop them.
    var liveFx: map[string]Effect = {}
    var fks: []string = _effects.keys()
    for (var j: int = 0; j < fks.length; j = j + 1) {
        var fk: string = fks[j]
        var ev: Effect? = _effects.get(fk)
        if (ev != null) {
            if (_fxSeen.getOr(fk, false) || isParked(fk)) { liveFx[fk] = ev }
            else { if (ev.cleanup != null) { var c: any = ev.cleanup; c() } }
        }
    }
    _effects = liveFx
}

// ---- Effects (useEffect): side effects that run after the render commits, on
//      mount and whenever a dependency changes, with cleanup on re-run/unmount.

function depsKeyOf(deps: []any): string {
    var s: string = ""
    for (var i: int = 0; i < deps.length; i = i + 1) { s = s + "|" + string(deps[i]) }
    return s
}

/**
 * Run a side effect after the component renders: on first mount, and again
 * whenever any value in `deps` changes. `fn` returns an OPTIONAL cleanup (a
 * function, or null) that runs before the next re-run and when the component
 * unmounts. Pass `[]` for run-once-on-mount.
 *
 * ```chuks
 * useEffect(function(): any {
 *     var id = startTimer()
 *     return function(): void { stopTimer(id) }   // cleanup on unmount
 * }, [])
 * ```
 */
export function useEffect(fn: any, deps: []any): void {
    var key: string = _path + "!" + string(_fxSlot)
    _fxSlot = _fxSlot + 1
    _fxSeen[key] = true
    var dk: string = depsKeyOf(deps)
    var prev: Effect? = _effects.get(key)
    if (prev == null || prev.depsKey != dk) {
        var old: any = prev != null ? prev.cleanup : null
        var e: Effect = new Effect(); e.depsKey = dk; e.cleanup = old
        _effects[key] = e
        var p: PendingFx = new PendingFx(); p.key = key; p.fn = fn; p.old = old
        _pendingFx.push(p)
    }
}

// Framework-internal: run queued effects after the render commits. Each pending
// effect runs its previous cleanup (if deps changed), then fn(), storing the new
// cleanup it returns.
export function runEffects(): void {
    for (var i: int = 0; i < _pendingFx.length; i = i + 1) {
        var p: PendingFx = _pendingFx[i]
        if (p.old != null) { var c: any = p.old; c() }
        var f: any = p.fn
        var cleanup: any = f()
        var e: Effect? = _effects.get(p.key)
        if (e != null) { e.cleanup = cleanup }
    }
    var empty: []PendingFx = []; _pendingFx = empty
}
