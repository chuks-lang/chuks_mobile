{
  "_": "Every capability whose arguments have a type to get wrong. One line each, and both sides of the boundary are generated from it: the encoder in Chuks and the decoder in Swift and Kotlin, so the two can never drift. A capability that takes nothing, or one string, is absent on purpose: there is nothing to state.",
  "capabilities": {
    "haptics.vibrate": {
      "args": [
        "ms:int"
      ],
      "note": "a single buzz, in milliseconds"
    },
    "torch.set": {
      "args": [
        "on:bool"
      ],
      "note": "flashlight on or off"
    },
    "brightness.set": {
      "args": [
        "level:float"
      ],
      "note": "screen brightness, 0 to 1"
    },
    "brightness.keepAwake": {
      "args": [
        "on:bool"
      ],
      "note": "hold the screen awake"
    },
    "calendar.upcoming": {
      "args": [
        "days:int"
      ],
      "note": "events in the next N days"
    },
    "calendar.create": {
      "args": [
        "title:string",
        "startInMin:int",
        "durationMin:int"
      ],
      "note": "create an event"
    },
    "pedometer.query": {
      "args": [
        "secondsAgo:int"
      ],
      "note": "step history over a past window"
    },
    "bg.result": {
      "args": [
        "name:string",
        "ok:bool"
      ],
      "note": "a background handler finished"
    },
    "bg.periodic": {
      "args": [
        "name:string",
        "seconds:int",
        "constraints:string"
      ],
      "note": "repeat no sooner than N seconds"
    },
    "bg.once": {
      "args": [
        "name:string",
        "seconds:int",
        "constraints:string"
      ],
      "note": "run once, no sooner than N seconds"
    },
    "bg.processing": {
      "args": [
        "name:string",
        "seconds:int",
        "constraints:string"
      ],
      "note": "long work wanting power and network"
    },
    "fs.write": {
      "args": [
        "name:string",
        "content:string"
      ],
      "note": "write a file in the app's directory"
    },
    "secure.set": {
      "args": [
        "key:string",
        "value:string"
      ],
      "note": "store a secret in the OS keystore"
    },
    "notif.notify": {
      "args": [
        "title:string",
        "body:string"
      ],
      "note": "post a local notification"
    },
    "ble.read": {
      "args": [
        "deviceId:string",
        "service:string",
        "characteristic:string"
      ],
      "note": "read a characteristic once"
    },
    "ble.write": {
      "args": [
        "deviceId:string",
        "service:string",
        "characteristic:string",
        "valueHex:string"
      ],
      "note": "write a characteristic"
    },
    "ble.subscribe": {
      "args": [
        "deviceId:string",
        "service:string",
        "characteristic:string"
      ],
      "note": "stream a characteristic's values"
    },
    "location.watchBackground": {
      "args": [
        "title:string",
        "body:string"
      ],
      "note": "the Android tracking notification"
    }
  }
}
