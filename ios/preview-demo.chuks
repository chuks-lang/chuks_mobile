// Smoke-test app for the Chuks Preview host, exercising DeviceInfo + StatusBar color:
// the StatusBar node tints the OS status bar (indigo, light icons), and
// DeviceInfo.screen reads the live screen size. Served over the dev server. Not shipped.
import { NavStack, Node, Column, Text, StatusBar, Comp, setSafeInsets } from "../core/ui.chuks";
import { useState, useEffect, Cell } from "../core/state.chuks";
import { syncSystemTheme, followingSystem, tk } from "../core/theme.chuks";
import { setPlatformInfo, deviceModel, osVersion } from "../core/platform.chuks";
import { DeviceInfo } from "../core/native.chuks";

function screenBody(): Node {
    var screen: Cell = useState("measuring...")
    useEffect(function(): any {
        DeviceInfo.screen(function(v: string): void {
            const p: []string = v.split(",")
            if (p.length >= 3) { screen.set(p[0] + " x " + p[1] + "  @" + p[2] + "x") }
        })
        return function(): void {}
    }, [])
    return Column({ dir: "col", gap: 14, grow: 1, justify: "center", align: "center", bg: tk("bg") }, [
        StatusBar({ style: "light", color: tk("primary") }),
        Text({ size: 15, color: tk("muted"), ta: "center" }, "DeviceInfo.screen"),
        Text({ size: 30, weight: "bold", color: tk("primary"), ta: "center", w: 320 }, string(screen.get())),
        Text({ size: 16, color: tk("muted"), ta: "center", w: 320 }, deviceModel() + "  .  iOS/Android " + osVersion()),
        Text({ size: 13, color: tk("muted"), ta: "center", w: 320 }, "the status bar above is StatusBar({ color })"),
    ])
}

function createRoot(): NavStack {
    var routes: map[string]function(): Node = {}
    routes["home"] = function(): Node { return Comp(screenBody) }
    return new NavStack(routes, "home")
}

var APP = createRoot()

export function set_count(n: int): void { APP.setup(n) }
export function mount(): int { return APP.mount() }
export function remount(): int { return APP.remount() }
export function setViewport(top: int, height: int): int { return APP.setViewport(top, height) }
export function tick(): int { return APP.tick() }
export function dispatch(action: string): int { return APP.dispatch(action) }
export function dispatchInput(action: string, value: string): int { return APP.dispatchInput(action, value) }
export function resolve(token: string, payload: string): int { return APP.resolve(token, payload) }
export function cancelToken(token: string): int { return APP.cancelToken(token) }
export function fail(token: string, message: string): int { return APP.failToken(token, message) }
export function drain(): string { return APP.drain() }
export function saveState(): string { return APP.saveState() }
export function loadState(data: string): void { APP.loadState(data) }
export function setColorScheme(dark: int): void { syncSystemTheme(dark == 1) }
export function colorSchemeFollows(): int { return followingSystem() ? 1 : 0 }
export function setInsets(top: int, right: int, bottom: int, left: int): void { setSafeInsets(top, right, bottom, left) }
export function setPlatform(os: string, version: string, model: string, isTablet: int): void {
    setPlatformInfo(os, version, model, isTablet == 1)
}
