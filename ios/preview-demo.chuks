// Smoke-test app for the Chuks Preview host, exercising 0.1.5 helpers: StatusBar color +
// navColor (Android nav bar), and MediaPicker.saveImage (save a picked photo to the gallery).
// Served over the dev server. Not shipped.
import { NavStack, Node, Column, Row, Text, Pressable, Image, StatusBar, Comp, setSafeInsets } from "../core/ui.chuks";
import { useState, Cell } from "../core/state.chuks";
import { syncSystemTheme, followingSystem, tk } from "../core/theme.chuks";
import { setPlatformInfo } from "../core/platform.chuks";
import { MediaPicker } from "../core/native.chuks";

function btn(label: string, onPress: () => void): Node {
    return Pressable({ onPress: onPress, bg: tk("surface"), radius: 12, pad: 14, grow: 1, align: "center",
                       border: 1, borderColor: tk("border") }, [
        Text({ size: 15, weight: "bold", color: tk("text"), ta: "center" }, label),
    ])
}

function screenBody(): Node {
    var uri: Cell = useState("")
    var status: Cell = useState("pick an image, then save it")
    return Column({ dir: "col", gap: 18, grow: 1, justify: "center", align: "center", bg: tk("bg") }, [
        StatusBar({ style: "light", color: tk("primary"), navColor: tk("primary") }),
        string(uri.get()) != ""
            ? Image({ src: string(uri.get()), w: 220, h: 220, radius: 18, resize: "cover" })
            : Column({ dir: "col", w: 220, h: 220, radius: 18, bg: tk("surface"), justify: "center", align: "center",
                       border: 1, borderColor: tk("border") }, [ Text({ size: 14, color: tk("muted") }, "no image") ]),
        Text({ size: 15, color: tk("muted"), ta: "center", w: 300 }, string(status.get())),
        Row({ dir: "row", gap: 12, w: 300 }, [
            btn("Pick", function(): void {
                MediaPicker.pickImage(function(u: string): void { uri.set(u); status.set("picked") },
                                      function(e: string): void { status.set(e) })
            }),
            btn("Save to gallery", function(): void {
                if (string(uri.get()) == "") { status.set("pick an image first"); return }
                status.set("saving...")
                MediaPicker.saveImage(string(uri.get()),
                    function(): void { status.set("saved to gallery") },
                    function(e: string): void { status.set(e) })
            }),
        ]),
    ])
}

function createRoot(): NavStack {
    var routes: map[string]function(): Node = {}
    routes["home"] = function(): Node { return Comp(screenBody) }
    return new NavStack(routes, "home")
}

var APP = createRoot()

export function set_count(n: int): void { APP.setup(n) }
export function mount(): int { return APP.mount() }
export function remount(): int { return APP.remount() }
export function setViewport(top: int, height: int): int { return APP.setViewport(top, height) }
export function tick(): int { return APP.tick() }
export function dispatch(action: string): int { return APP.dispatch(action) }
export function dispatchInput(action: string, value: string): int { return APP.dispatchInput(action, value) }
export function resolve(token: string, payload: string): int { return APP.resolve(token, payload) }
export function cancelToken(token: string): int { return APP.cancelToken(token) }
export function fail(token: string, message: string): int { return APP.failToken(token, message) }
export function drain(): string { return APP.drain() }
export function saveState(): string { return APP.saveState() }
export function loadState(data: string): void { APP.loadState(data) }
export function setColorScheme(dark: int): void { syncSystemTheme(dark == 1) }
export function colorSchemeFollows(): int { return followingSystem() ? 1 : 0 }
export function setInsets(top: int, right: int, bottom: int, left: int): void { setSafeInsets(top, right, bottom, left) }
export function setPlatform(os: string, version: string, model: string, isTablet: int): void {
    setPlatformInfo(os, version, model, isTablet == 1)
}
