// ChuksTok: a vertical full-screen paging video feed, COMPOSED from primitives (List +
// Video), not a black box. The paging List reports the centered cell via onVisible; each
// cell's Video plays only when it is the visible one. Swipe up/down -> the new clip autoplays,
// the rest pause. This is the M1 proof that the composition model works.
import { NavStack, Node, Column, Text, List, Video, Comp, setSafeInsets, viewportHeight } from "../core/ui.chuks";
import { useState, useEffect, Cell } from "../core/state.chuks";
import { DeviceInfo } from "../core/native.chuks";
import { syncSystemTheme, followingSystem } from "../core/theme.chuks";
import { setPlatformInfo } from "../core/platform.chuks";

// Real vertical (1080x1920) footage from Pexels, verified reachable from the device.
var CLIPS: []string = [
    "https://videos.pexels.com/video-files/4434150/4434150-hd_1080_1920_30fps.mp4",
    "https://videos.pexels.com/video-files/5385885/5385885-hd_1080_1920_25fps.mp4",
    "https://videos.pexels.com/video-files/2795405/2795405-hd_1080_1920_25fps.mp4",
]

function feed(): Node {
    const visible: Cell = useState(0)
    const sw: Cell = useState(400)
    const sh: Cell = useState(800)

    useEffect(function(): any {
        DeviceInfo.screen(function(s: string): void {
            const f: []string = s.split(",")   // "w,h,scale"
            if (f.length >= 2) { sw.set(int(f[0])); sh.set(int(f[1])) }
        })
        return function(): void {}
    }, [])

    const w: int = int(sw.get())
    // rowHeight MUST equal the scroll's real page height (viewportHeight), or paging snaps
    // between cells and the last clip can't be scrolled fully into view. Fall back to the
    // screen height only for the first frame, before the host reports a viewport.
    const vph: int = viewportHeight()
    const h: int = vph > 0 ? vph : int(sh.get())
    const vis: int = int(visible.get())

    return List({
        count: CLIPS.length,
        rowHeight: h,
        paging: 1,
        onVisible: function(i: int): void { visible.set(i) },
        key: function(r: int): string { return string(r) },
        item: function(r: int, top: int): Node {
            return Column({ abs: true, top: top, left: 0, w: w, h: h, bg: "000000" }, [
                Video({ src: CLIPS[r], playing: r == vis, loop: true, muted: true, resizeMode: "cover",
                        abs: true, top: 0, left: 0, w: w, h: h }),   // explicit fill (grow:1 is unreliable inside an abs cell)
                Text({ abs: true, top: h - 130, left: 20, color: "FFFFFF", size: 22, weight: "bold" },
                     "clip " + string(r + 1) + (r == vis ? "   playing" : "   paused")),
            ])
        },
    })
}

function createRoot(): NavStack {
    var routes: map[string]function(): Node = {}
    routes["home"] = function(): Node { return Comp(feed) }
    return new NavStack(routes, "home")
}

var APP = createRoot()

export function set_count(n: int): void { APP.setup(n) }
export function mount(): int { return APP.mount() }
export function remount(): int { return APP.remount() }
export function setViewport(top: int, height: int): int { return APP.setViewport(top, height) }
export function tick(): int { return APP.tick() }
export function dispatch(action: string): int { return APP.dispatch(action) }
export function dispatchInput(action: string, value: string): int { return APP.dispatchInput(action, value) }
export function resolve(token: string, payload: string): int { return APP.resolve(token, payload) }
export function cancelToken(token: string): int { return APP.cancelToken(token) }
export function fail(token: string, message: string): int { return APP.failToken(token, message) }
export function drain(): string { return APP.drain() }
export function saveState(): string { return APP.saveState() }
export function loadState(data: string): void { APP.loadState(data) }
export function setColorScheme(dark: int): void { syncSystemTheme(dark == 1) }
export function colorSchemeFollows(): int { return followingSystem() ? 1 : 0 }
export function setInsets(top: int, right: int, bottom: int, left: int): void { setSafeInsets(top, right, bottom, left) }
export function setPlatform(os: string, version: string, model: string, isTablet: int): void {
    setPlatformInfo(os, version, model, isTablet == 1)
}
