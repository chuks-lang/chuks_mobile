// Minimal dev server for the Chuks Preview smoke test: serves preview-demo.chuks over
// the same mutation protocol the real dev server uses. Run: chuks run ios/preview-demo-server.chuks
import { createServer, Request, Response } from "std/http";
import { set_count, mount, remount, tick, setViewport, dispatch, dispatchInput, resolve, fail, drain } from "./preview-demo.chuks";

set_count(1000)
var app = createServer({})
app.post("/mount", function(req: Request, res: Response) { remount(); res.send(drain()) })
app.post("/tick", function(req: Request, res: Response) { tick(); res.send(drain()) })
app.post("/viewport", function(req: Request, res: Response) {
    const p: []string = req.body.split(" ")
    setViewport(int(p[0]), int(p[1]))
    res.send(drain())
})
app.post("/event", function(req: Request, res: Response) { dispatch(req.body.trim()); res.send(drain()) })
app.post("/input", function(req: Request, res: Response) {
    const b: string = req.body
    const nl: int = b.indexOf("\n")
    if (nl >= 0) { dispatchInput(b.slice(0, nl), b.slice(nl + 1)) }
    else { dispatchInput(b.trim(), "") }
    res.send(drain())
})
app.post("/resolve", function(req: Request, res: Response) {   // native stream/async result (F3)
    const b: string = req.body
    const nl: int = b.indexOf("\n")
    if (nl >= 0) { resolve(b.slice(0, nl), b.slice(nl + 1)) }
    else { resolve(b.trim(), "") }
    res.send(drain())
})
app.post("/fail", function(req: Request, res: Response) {   // native capability failure (F3 error channel)
    const b: string = req.body
    const nl: int = b.indexOf("\n")
    if (nl >= 0) { fail(b.slice(0, nl), b.slice(nl + 1)) }
    else { fail(b.trim(), "") }
    res.send(drain())
})
app.get("/state", function(req: Request, res: Response) { res.send("") })
app.listen(7799, "0.0.0.0")
print("preview demo server on :7799")
