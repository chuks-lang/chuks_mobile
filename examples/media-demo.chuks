// P4: media events. Image onLoad/onError + tintColor; Video onProgress/onEnd + seek.
import { NavStack, Node, Column, Row, Text, Image, Video, Button, Scroll, setSafeInsets } from "../core/ui.chuks";
import { useState, Cell } from "../core/state.chuks";
import { tk, syncSystemTheme, followingSystem } from "../core/theme.chuks";
import { setPlatformInfo } from "../core/platform.chuks";

function card(title: string, body: Node): Node {
    return Column({ bg: tk("surface"), radius: 14, pad: 14, gap: 8 }, [
        Text({ color: tk("muted"), size: 12, weight: "bold" }, title),
        body,
    ])
}

function screen(): Node {
    const imgState: Cell = useState("loading…")
    const errState: Cell = useState("loading…")
    const vidTime: Cell = useState(0)
    const vidEnded: Cell = useState(false)
    const seekTo: Cell = useState(-1)

    return Column({ grow: 1, bg: tk("bg") }, [
        Column({ bg: tk("surface"), pad: 14 }, [
            Text({ color: tk("text"), size: 20, weight: "bold" }, "Media events"),
        ]),
        Scroll({ grow: 1 }, [ Column({ pad: 12, gap: 12 }, [
            card("Image onLoad -> " + string(imgState.get()), Image({
                src: "https://picsum.photos/id/237/400/200", w: 300, h: 150, radius: 10,
                onLoad: function(): void { imgState.set("loaded") },
                onError: function(): void { imgState.set("error") },
            })),
            card("Image onError (bad url) -> " + string(errState.get()), Image({
                src: "https://example.invalid/nope.png", w: 300, h: 90, radius: 10, bg: tk("bg"),
                onLoad: function(): void { errState.set("loaded") },
                onError: function(): void { errState.set("failed to load") },
            })),
            card("Image tintColor", Image({ src: "https://picsum.photos/id/1025/200/120", w: 200, h: 120, radius: 10, tintColor: tk("primary") })),
            card("Image blurRadius: 12", Image({ src: "https://picsum.photos/id/1025/300/140", w: 300, h: 140, radius: 10, blurRadius: 12 })),
            card("Video " + string(int(vidTime.get())) + "s" + (bool(vidEnded.get()) ? " (ended)" : "") + " / seek", Column({ gap: 8 }, [
                Video({
                    src: "https://videos.pexels.com/video-files/4434150/4434150-hd_1080_1920_30fps.mp4",
                    w: 220, h: 300, radius: 10, loop: true, muted: true, controls: true,
                    seek: int(seekTo.get()),
                    onProgress: function(t: int): void { vidTime.set(t) },
                    onEnd: function(): void { vidEnded.set(true) },
                }),
                Row({ gap: 10 }, [
                    Button({ bg: tk("primary"), w: 130, h: 40, onPress: function(): void { seekTo.set(8) } }, "seek 8s"),
                    Button({ bg: tk("primary"), w: 130, h: 40, onPress: function(): void { seekTo.set(0) } }, "restart"),
                ]),
            ])),
        ]) ]),
    ])
}

function createRoot(): NavStack {
    var routes: map[string]function(): Node = {}
    routes["home"] = function(): Node { return screen() }
    return new NavStack(routes, "home")
}

var APP = createRoot()

export function set_count(x: int): void { APP.setup(x) }
export function mount(): int { return APP.mount() }
export function remount(): int { return APP.remount() }
export function setViewport(top: int, height: int, width: int): int { return APP.setViewport(top, height, width) }
export function tick(): int { return APP.tick() }
export function dispatch(action: string): int { return APP.dispatch(action) }
export function dispatchInput(action: string, value: string): int { return APP.dispatchInput(action, value) }
export function resolve(token: string, payload: string): int { return APP.resolve(token, payload) }
export function cancelToken(token: string): int { return APP.cancelToken(token) }
export function fail(token: string, message: string): int { return APP.failToken(token, message) }
export function drain(): string { return APP.drain() }
export function saveState(): string { return APP.saveState() }
export function loadState(data: string): void { APP.loadState(data) }
export function setColorScheme(dark: int): void { syncSystemTheme(dark == 1) }
export function colorSchemeFollows(): int { return followingSystem() ? 1 : 0 }
export function setInsets(top: int, right: int, bottom: int, left: int): void { setSafeInsets(top, right, bottom, left) }
export function setPlatform(os: string, version: string, model: string, isTablet: int): void {
    setPlatformInfo(os, version, model, isTablet == 1)
}
