// Local WebSocket echo + broadcast server for M2 testing (run on the Mac via `chuks run`).
// Echoes each message straight back to the sender (for latency measurement) and relays it
// to every other connected client (so a multi-device chat demo works). Not shipped.
import { WebSocketServer, WSServerOptionsBuilder, WebSocketConnection } from "pkg/@chuks/websocket"

var PEERS: []WebSocketConnection = []

function main(): void {
    const wss: WebSocketServer = new WebSocketServer(new WSServerOptionsBuilder().host("0.0.0.0").port(8899).build())

    wss.onConnection(function(conn: WebSocketConnection): void {
        PEERS.push(conn)
        println("client connected; peers=" + string(PEERS.length))
        conn.send("welcome@0")             // push on connect so the client receive path is exercised immediately
        conn.onMessage(function(msg: string): void {
            conn.send(msg)                 // echo to sender (round-trip latency probe)
            var i: int = 0                 // relay to everyone else (chat)
            while (i < PEERS.length) {
                const p: WebSocketConnection = PEERS[i]
                if (p != conn && p.isOpen()) { p.send(msg) }
                i = i + 1
            }
        })
        conn.onClose(function(code: int, reason: string): void {
            println("client closed: " + string(code) + " " + reason)
        })
    })

    println("echo server listening on ws://0.0.0.0:8899")
    wss.listen()
}

main()
