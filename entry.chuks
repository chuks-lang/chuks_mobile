// Framework entry — the native glue, part of @chuks/mobile. You don't edit this
// (like Expo's generated AppEntry): it bridges your app root to the fixed native
// host contract (the chuks_* C ABI the iOS/Android hosts call). It imports your
// root by convention from app/app.chuks; your app lives in app.chuks + app/views/.
//
// These exported names are the C ABI, so this file is the compiled entry module
// (chuks.json "entry" points here, the host build targets it).
import { createRoot } from "../app/app.chuks";
import { syncSystemTheme, followingSystem } from "./theme.chuks";
import { setSafeInsets } from "./ui.chuks";
import { setPlatformInfo } from "./platform.chuks";

var APP = createRoot()   // concrete root type, so overridden hooks dispatch directly

export function set_count(n: int): void { APP.setup(n) }
export function mount(): int { return APP.mount() }
export function setViewport(top: int, height: int): int { return APP.setViewport(top, height) }
export function tick(): int { return APP.tick() }
export function dispatch(action: string): int { return APP.dispatch(action) }
export function dispatchInput(action: string, value: string): int { return APP.dispatchInput(action, value) }
// Async host->engine bridge (F3): the host calls this when a native capability
// requested via an `X|token|...` command completes, passing the same token and a
// result payload. Fires the registered Chuks callback and re-renders.
export function resolve(token: string, payload: string): int { return APP.resolve(token, payload) }
export function drain(): string { return APP.drain() }
export function saveState(): string { return APP.saveState() }
export function loadState(data: string): void { APP.loadState(data) }

// Dark-mode sync: the native host reports the OS appearance (launch + on change).
// setColorScheme only updates the theme; the host re-renders (mount/tick) itself.
// colorSchemeFollows() tells the host if the app is still tracking the OS.
export function setColorScheme(dark: int): void { syncSystemTheme(dark == 1) }
export function colorSchemeFollows(): int { return followingSystem() ? 1 : 0 }

// Safe-area insets (points/dp): the host reports these on layout; components read
// them via safeTop()/safeBottom()/… No render here — the host re-renders after.
export function setInsets(top: int, right: int, bottom: int, left: int): void { setSafeInsets(top, right, bottom, left) }

// Platform + device info: the host reports these once at launch. Read in app code via
// getPlatform() / isIOS() / osVersion() etc. (core/platform.chuks).
export function setPlatform(os: string, version: string, model: string, isTablet: int): void {
    setPlatformInfo(os, version, model, isTablet == 1)
}
