<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.chuks.app"
    android:versionCode="__VERSION_CODE__" android:versionName="__VERSION_NAME__">
    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />
    <!--CHUKS_PERMISSIONS-->
    <application android:enableOnBackInvokedCallback="true"
        android:label="Chuks"
        android:hasCode="true"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true"
                  android:launchMode="singleTask"
                  android:windowSoftInputMode="adjustResize"
                  android:configChanges="uiMode|orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--CHUKS_VIEW_FILTER-->
        </activity>
        <!-- Background tasks. BIND_JOB_SERVICE is required by the platform: without it
             JobScheduler refuses to start the service and the failure is silent. -->
        <service android:name=".ChuksJobService"
                 android:permission="android.permission.BIND_JOB_SERVICE"
                 android:exported="false" />
        <!-- Background location. The type is mandatory from Android 14: a foreground
             service that does not declare one is refused at start. -->
        <service android:name=".ChuksLocationService"
                 android:foregroundServiceType="location"
                 android:exported="false" />
        <!-- Scheduled notifications. The alarm fires into this receiver with no Activity
             alive, and BOOT_COMPLETED re-arms the stored ones, since alarms do not
             survive a reboot. Exported because the boot broadcast comes from the
             system; the alarm intents are explicit and reach it regardless. -->
        <receiver android:name=".ChuksNotifReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <!-- Files handed to other apps (the clipboard, the share sheet) go through this
             provider, which serves one cache directory by content URI. The authority is
             the app id, filled by the build, so two Chuks apps can be installed together. -->
        <provider android:name=".ChuksFileProvider"
                  android:authorities="__APP_ID__.files"
                  android:exported="false"
                  android:grantUriPermissions="true" />
    </application>
</manifest>
