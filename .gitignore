# Chuks Mobile SDK — framework (core/) + native engines (ios/, android/) + docs/
# + the starter template (template/). Root-level demo/dev dirs are excluded (anchored
# with a leading /) so they don't ship, WITHOUT swallowing template/app, template/assets.

# Build outputs (regenerated by ios/build.sh, android/build.sh, dev.sh)
.out/
.out-device/
.chuks/ios-out/
.chuks/android-out/
*_exe

# Root-level demo app + local dev dirs (NOT part of the package; the shippable
# starter lives under template/).
/app/
/assets/
/benchmarks/
/utils/
/build/
/chuks_packages/

# macOS
.DS_Store

# NOTE: ios/yoga/*.a, ios/yoga-device/*.a, android/yoga/*.a are prebuilt Yoga
# static libs — build INPUTS, kept on purpose so the repo builds out of the box.

# Internal design docs / roadmaps — kept local, out of the repo.
docs/
