# Chuks Mobile SDK — framework (core/) + native engines (ios/, android/) + docs/.
# The demo app + assets live in the separate app/starter repo (see the project
# structure discussion); they are intentionally not tracked here yet.

# Build outputs (regenerated by ios/build.sh, android/build.sh, dev.sh)
.out/
.out-device/
build/
*_exe

# Fetched Chuks packages (deps, not source)
chuks_packages/

# Not part of the SDK repo yet (moving to the app/starter repo)
app/
assets/
benchmarks/
utils/

# macOS
.DS_Store

# NOTE: ios/yoga/*.a, ios/yoga-device/*.a, android/yoga/*.a are prebuilt Yoga
# static libs — build INPUTS, kept on purpose so the repo builds out of the box.
