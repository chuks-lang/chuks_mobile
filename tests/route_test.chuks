// Route params + body: the contract a screen can rely on.
//
// Params are the RESTORABLE half (they ride the hot-reload snapshot, so a screen
// comes back with the same identity); body is the FAST half (in memory only, so a
// screen must always be able to rebuild itself from params alone). These tests pin
// that difference down, because the day it silently stops holding, every screen
// quietly becomes un-reloadable.
//
// Run:  chuks run tests/route_test.chuks   (exits non-zero on failure)

import { Node, Column, Row, Text, List, Route, NavStack, Reconciler } from "../core/ui.chuks";
import { useState, Cell } from "../core/state.chuks";

function has(s: string, sub: string): bool {
    if (sub.length > s.length) { return false }
    for (var i: int = 0; i + sub.length <= s.length; i = i + 1) {
        if (s.slice(i, i + sub.length) == sub) { return true }
    }
    return false
}

var PASS: int = 0
var FAIL: int = 0
function check(cond: bool, name: string): void {
    if (cond) { PASS = PASS + 1; println("  ok   " + name) }
    else { FAIL = FAIL + 1; println("  FAIL " + name) }
}

dataType Club { id: string; name: string }

var RENDERED: []string = []
var SEEN_ID: string = ""
var SEEN_BODY: bool = false
var SEEN_RESULT: string = ""

function screen(r: Route): Node {
    RENDERED.push(r.name + ":" + r.str("id", ""))
    SEEN_ID = r.str("id", "")
    SEEN_BODY = r.body != null
    SEEN_RESULT = r.result != null ? string(r.result) : ""
    return Text({}, "club " + SEEN_ID)
}

// Two screens that each own a long list, recording the FIRST row each pass builds, so a
// test can see where each list is windowed.
var FIRST_ROW: map[string]int = {}
function listScreen(r: Route): Node {
    const who: string = r.str("who", "?")
    return Column({ dir: "col", grow: 1 }, [
        List({ count: 300, rowHeight: 60,
               key:  function(i: int): string { return who + "-" + string(i) },
               item: function(i: int, top: int): Node {
                   if (!FIRST_ROW.has(who) || i < FIRST_ROW.getOr(who, 999999)) { FIRST_ROW[who] = i }
                   return Row({ abs: true, top: top, left: 0, right: 0, h: 60 }, [ Text({}, who + string(i)) ])
               } }),
    ])
}

var DEEP_CELL: Cell<int>? = null
var DEEP_SEEN: int = -1
var DEEP_STATE: any = 0
var DEEP_RENDERED: []string = []
// A level of a deep stack: stateful, and carrying a virtualized List, so a pop has to
// restore both the level's own state and its list's bookkeeping.
function deepScreen(r: Route): Node {
    const c: Cell<int> = useState(0)
    const n: int = r.int("n", 0)
    DEEP_RENDERED.push("lvl" + string(n))
    DEEP_CELL = c
    DEEP_SEEN = n
    DEEP_STATE = c.get()
    return Column({ dir: "col", grow: 1 }, [
        List({ count: 30, rowHeight: 40,
               key:  function(i: int): string { return "l" + string(n) + "-" + string(i) },
               item: function(i: int, top: int): Node {
                   return Row({ abs: true, top: top, left: 0, right: 0, h: 40 }, [ Text({}, "row " + string(i)) ])
               } }),
    ])
}

var TAB: Cell<int>? = null
var SEEN_TAB: int = -1
// A stateful screen, the way a tab shell is: it remembers which tab you were on.
function statefulScreen(_: Route): Node {
    const t: Cell<int> = useState(0)
    TAB = t
    SEEN_TAB = int(t.get())
    return Text({}, "tab " + string(SEEN_TAB))
}
function navStateful(): NavStack {
    var routes: map[string]function(r: Route): Node = {}
    routes["home"] = statefulScreen
    routes["club"] = screen
    return new NavStack(routes, "home")
}

function nav(): NavStack {
    var routes: map[string]function(r: Route): Node = {}
    routes["home"] = screen
    routes["club"] = screen
    return new NavStack(routes, "home")
}

function main(): void {
    println("route_test")

    // 1. Typed accessors, with defaults for what was never passed. Never a raw map
    //    read: a missing key in a typed map reads back differently on VM vs AOT, and
    //    string(null) is the text "null".
    const r: Route = new Route("club", { "id": "c-7", "page": 3, "edit": true }, null)
    check(r.str("id", "") == "c-7", "str() reads a param")
    check(r.int("page", 1) == 3, "int() reads a param")
    check(r.bool("edit", false), "bool() reads a param")
    check(r.str("nope", "dflt") == "dflt", "str() falls back when absent")
    check(r.int("nope", 42) == 42, "int() falls back when absent")
    check(!r.bool("nope", false), "bool() falls back when absent")
    check(r.has("id") && !r.has("nope"), "has() reports presence")

    // 2. A push carries params and body to the screen.
    const nv: NavStack = nav()
    const c: Club = { id: "c-7", name: "Riverside Walkers" }
    nv.push("club", { "id": c.id }, c)
    check(nv.depth() == 2, "push deepens the stack")
    const rc: Reconciler = new Reconciler()
    rc.begin(); rc.renderRoot(nv.render())
    check(SEEN_ID == "c-7", "the screen reads its param, got '" + SEEN_ID + "'")
    check(SEEN_BODY, "the screen receives the body")

    // 3. THE CONTRACT: params survive a reload, body does not. A screen that leans on
    //    body alone comes back empty; one that reads params comes back whole.
    const snap: string = nv.saveState()
    const nv2: NavStack = nav()
    nv2.loadState(snap)
    check(nv2.depth() == 2, "the reloaded stack keeps its depth")
    check(nv2.top().name == "club", "the reloaded stack keeps the route")
    check(nv2.top().str("id", "") == "c-7", "params survive the reload")
    check(nv2.top().body == null, "body does NOT survive the reload")

    // 4. back(result) hands a value to the screen underneath.
    nv.popStack("chosen")
    check(nv.depth() == 1, "pop shrinks the stack")
    check(nv.top().result != null && string(nv.top().result) == "chosen", "the popped screen's result lands on the one below")
    rc.begin(); rc.renderRoot(nv.render())
    check(SEEN_RESULT == "chosen", "the screen below reads the result, got '" + SEEN_RESULT + "'")

    // 5. A pop at the root is refused, so the host can do its platform default.
    check(!nv.popRoute(), "popRoute() at the root returns false")

    // 6. A SCREEN UNDER THE TOP KEEPS ITS STATE. Only the visible route renders, so
    //    without parking, pushing a detail screen would sweep the list screen's cells
    //    and popping back would land on a screen that had forgotten its tab, its
    //    scroll position, everything the user had set up.
    const nv3: NavStack = navStateful()
    const rc3: Reconciler = new Reconciler()
    rc3.begin(); rc3.renderRoot(nv3.render())        // home mounts, tab defaults to 0
    if (TAB != null) { TAB.set(2) }                  // the user picks the third tab
    rc3.begin(); rc3.renderRoot(nv3.render())
    check(SEEN_TAB == 2, "the screen's own state applies, got " + string(SEEN_TAB))
    nv3.push("club", { "id": "c-1" }, null)          // push a detail over it
    rc3.begin(); rc3.renderRoot(nv3.render())
    nv3.popStack(null)                               // and come back
    rc3.begin(); rc3.renderRoot(nv3.render())
    check(SEEN_TAB == 2, "state under the top survives a push and pop, got " + string(SEEN_TAB))

    // 7. TWO SCREENS ARE MOUNTED AT ONCE: the visible one and the one a back gesture
    //    would reveal. Each is its own full-screen container, stacked in order, and
    //    each renders ITS OWN route -- a loop-body closure in Chuks is one hoisted
    //    slot, so binding the wrong way makes every layer render the topmost route.
    const nv4: NavStack = nav()
    const rc4: Reconciler = new Reconciler()
    nv4.push("club", { "id": "c-1" }, null)
    var e1: []string = []; RENDERED = e1
    rc4.begin(); rc4.renderRoot(nv4.render())
    check(RENDERED.length == 2, "the top two entries both render, got " + string(RENDERED.length))
    check(RENDERED.length == 2 && RENDERED[0] == "home:" && RENDERED[1] == "club:c-1",
          "each layer renders its OWN route, got " + RENDERED.join(" | "))

    // 8. A push does not renumber the screens below it: a route's node id follows its
    //    DEPTH, so the reconciler leaves an unchanged screen alone instead of tearing
    //    it down and rebuilding it (which would drop native scroll position).
    rc4.begin(); rc4.renderRoot(nv4.render())
    check(rc4.count() == 0, "re-rendering the stack emits 0 mutations, got " + string(rc4.count()))
    nv4.push("club", { "id": "c-2" }, null)
    rc4.begin(); rc4.renderRoot(nv4.render())
    const churn: string = rc4.drain()
    // The screen a back gesture would reveal keeps its id and its subtree: it is not
    // torn down and rebuilt just because something was pushed over it.
    check(!has(churn, "R|app.1"), "pushing leaves the revealed screen's tree intact")
    // The screen that fell out of the live window IS released (its state is parked,
    // its native views are not kept): that is the point of only rendering two.
    check(has(churn, "R|app.0."), "a screen pushed out of the live window is released")

    // 9. A DEEP STACK, POPPED ALL THE WAY BACK. Every level keeps its own params, its
    //    own state and its own list bookkeeping, and each pop reveals the level below
    //    intact -- no churn, no screen coming back empty.
    var deepRoutes: map[string]function(r: Route): Node = {}
    deepRoutes["lvl"] = deepScreen
    const nv5: NavStack = new NavStack(deepRoutes, "lvl")
    const rc5: Reconciler = new Reconciler()
    rc5.setViewport(0, 600, 400)
    rc5.begin(); rc5.renderRoot(nv5.render())
    if (DEEP_CELL != null) { DEEP_CELL.set(100) }            // stamp the root level
    for (var d: int = 1; d <= 4; d = d + 1) {
        nv5.push("lvl", { "n": d }, null)
        rc5.begin(); rc5.renderRoot(nv5.render())
        if (DEEP_CELL != null) { DEEP_CELL.set(100 + d) }    // stamp this level
        rc5.begin(); rc5.renderRoot(nv5.render())
    }
    check(nv5.depth() == 5, "five levels deep, got " + string(nv5.depth()))
    check(DEEP_SEEN == 4, "the top level is the one on screen, got " + string(DEEP_SEEN))
    // Only the top two render, however deep the stack is.
    var e2: []string = []; DEEP_RENDERED = e2
    rc5.begin(); rc5.renderRoot(nv5.render())
    check(DEEP_RENDERED.length == 2, "only the top two levels render at depth 5, got " + string(DEEP_RENDERED.length))
    check(rc5.count() == 0, "a settled deep stack emits 0 mutations, got " + string(rc5.count()))

    // Now unwind the whole way, checking each revealed level as it appears.
    var ok: bool = true
    var noChurn: bool = true
    for (var b: int = 3; b >= 0; b = b - 1) {
        nv5.popStack(null)
        rc5.begin(); rc5.renderRoot(nv5.render())
        if (DEEP_SEEN != b) { ok = false }                   // the right level is on screen
        if (int(DEEP_STATE) != 100 + b) { ok = false }       // and it kept the state it had
        rc5.begin(); rc5.renderRoot(nv5.render())
        if (rc5.count() != 0) { noChurn = false }            // and settles with no churn
    }
    check(ok, "every level revealed by a pop is the right one, with its state")
    check(noChurn, "no mutation churn while unwinding the stack")
    check(nv5.depth() == 1, "back at the root, got depth " + string(nv5.depth()))

    // 10. A COVERED LIST KEEPS ITS OWN POSITION. The host reports one viewport, for the
    //     list on screen; without routing that to the right list, a covered screen's list
    //     would follow the visible one's scrolling and mount rows for a place it is not at.
    var lr: map[string]function(r: Route): Node = {}
    lr["scr"] = listScreen
    const nv6: NavStack = new NavStack(lr, "scr")
    const rc6: Reconciler = new Reconciler()
    rc6.setViewport(0, 600, 400)
    var f0: map[string]int = {}; FIRST_ROW = f0
    rc6.begin(); rc6.renderRoot(nv6.render())          // one screen, at the top
    nv6.push("scr", { "who": "B" }, null)              // B over A (A has who="?")
    rc6.begin(); rc6.renderRoot(nv6.render())
    rc6.setViewport(6000, 600, 400)                    // the user scrolls B a long way down
    var f1: map[string]int = {}; FIRST_ROW = f1
    rc6.begin(); rc6.renderRoot(nv6.render())
    check(FIRST_ROW.getOr("B", -1) > 80, "the visible list follows the scroll, first row " + string(FIRST_ROW.getOr("B", -1)))
    check(FIRST_ROW.getOr("?", -1) == 0, "the covered list stays where it was, first row " + string(FIRST_ROW.getOr("?", -1)))

    // 11. A RELEASED SCREEN COMES BACK WHERE YOU LEFT IT. Push far enough that the
    //     scrolled screen falls out of the live window and is released, then pop back:
    //     it re-mounts windowed at its old position, and asks the host to set the same
    //     offset without animation. That lands while the screen is still covered, which
    //     is why the position is never seen being restored.
    nv6.push("scr", { "who": "C" }, null)
    rc6.begin(); rc6.renderRoot(nv6.render())
    nv6.push("scr", { "who": "D" }, null)              // now B is third from the top: released
    rc6.begin(); rc6.renderRoot(nv6.render())
    // Popping to C re-mounts B UNDERNEATH it -- one gesture before B could be revealed.
    nv6.popStack(null)
    var f2: map[string]int = {}; FIRST_ROW = f2
    rc6.begin(); rc6.renderRoot(nv6.render())
    const restored: string = rc6.drain()
    check(FIRST_ROW.getOr("B", -1) > 80, "the re-mounted list windows at its old position, first row " + string(FIRST_ROW.getOr("B", -1)))
    check(has(restored, "LS|"), "the host is asked to restore the offset, while the screen is still covered")
    // And by the time it IS revealed, nothing further is needed: no second restore, no jump.
    nv6.popStack(null)
    rc6.begin(); rc6.renderRoot(nv6.render())
    const revealed: string = rc6.drain()
    check(!has(revealed, "LS|"), "revealing it asks for no further scrolling")

    println("route_test: " + string(PASS) + " passed, " + string(FAIL) + " failed")
    if (FAIL > 0) { throw "route_test failed" }
}
main()
