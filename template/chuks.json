{
  "name": "__APP_NAME__",
  "version": "0.1.0",
  "entry": ".chuks/entry.chuks",
  "iosEngine": "swiftui",
  "dependencies": {
    "@chuks/mobile": "^0.1.4",
    "@chuks/lucide": "^1.0.0",
    "@chuks/qr": "^0.1.0"
  },
  "scripts": {
    "ios": "FAST=1 bash chuks_packages/@chuks/mobile/ios/build.sh",
    "ios:release": "bash chuks_packages/@chuks/mobile/ios/build.sh",
    "ios:device": "IOS_TARGET=device bash chuks_packages/@chuks/mobile/ios/build.sh",
    "android": "bash chuks_packages/@chuks/mobile/android/build.sh",
    "dev": "E=\"$PWD/app/app.chuks\"; cd \"${CHUKS_REPO:?set CHUKS_REPO to the chuks source repo}\" && go run ./cmd/chukspack serve \"$E\" --port 7799",
    "dev:ios": "DEV=1 bash chuks_packages/@chuks/mobile/ios/build-cmr.sh",
    "dev:android": "DEV=1 bash chuks_packages/@chuks/mobile/android/build-cmr.sh",
    "typecheck": "chuks check .chuks/entry.chuks"
  }
}
