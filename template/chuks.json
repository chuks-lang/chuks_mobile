{
  "name": "__APP_NAME__",
  "displayName": "__APP_NAME__",
  "bundleId": "__BUNDLE_ID__",
  "version": "0.1.0",
  "entry": ".chuks/entry.chuks",
  "iosEngine": "swiftui",
  "dependencies": {
    "@chuks/mobile": "^0.1.3",
    "@chuks/lucide": "^1.0.0"
  },
  "scripts": {
    "ios": "FAST=1 bash chuks_packages/@chuks/mobile/ios/build.sh",
    "ios:release": "bash chuks_packages/@chuks/mobile/ios/build.sh",
    "android": "bash chuks_packages/@chuks/mobile/android/build.sh",
    "dev": "rm -f .chuks/dev-state.txt; chuks watch .chuks/devserver.chuks",
    "dev:ios": "DEV=1 FAST=1 bash chuks_packages/@chuks/mobile/ios/build.sh",
    "dev:android": "DEV=1 bash chuks_packages/@chuks/mobile/android/build.sh",
    "typecheck": "chuks check .chuks/entry.chuks"
  }
}
