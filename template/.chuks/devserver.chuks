// Chuks Mobile dev server (hot reload). Runs the SAME engine in the Chuks VM and
// serves the mutation protocol over HTTP, so a thin host fetches frames without
// the engine being AOT-linked into the app. Editing engine.chuks + restarting
// this server reloads the logic with NO app rebuild/reinstall -- Fast Refresh.
//
// State preservation: after each state-changing request we snapshot saveState() to a
// project-local file; on boot we restore it, so useState values survive a chuks watch
// restart. The `dev` script clears the file at session start for a clean first launch.
import { createServer, Request, Response } from "std/http";
import { fs } from "std/fs";
import { set_count, mount, remount, tick, setViewport, dispatch, dispatchInput, resolve, fail, drain, saveState, loadState } from "./entry.chuks";

const STATE_FILE: string = ".chuks/dev-state.txt"

set_count(1000)
if (fs.exists(STATE_FILE)) {
    loadState(fs.readFile(STATE_FILE))
    print("dev server: restored preserved state")
}

// Snapshot state after every change so the next boot (after a chuks watch restart)
// restores it. A per-event file write is negligible for a dev server.
function persist(): void { fs.writeFile(STATE_FILE, saveState()) }

var app = createServer({})

// remount() (not mount()) so every host that connects or relaunches gets the FULL tree,
// not an empty diff — mount()'s output is one-shot against the reconciler's committed state.
app.post("/mount", function(req: Request, res: Response) { remount(); res.send(drain()) })
app.post("/tick", function(req: Request, res: Response) { tick(); res.send(drain()) })
app.post("/viewport", function(req: Request, res: Response) {
    const p: []string = req.body.split(" ")   // "top height"
    setViewport(int(p[0]), int(p[1]))
    res.send(drain())
})
app.post("/event", function(req: Request, res: Response) { dispatch(req.body.trim()); persist(); res.send(drain()) })
app.post("/input", function(req: Request, res: Response) {
    const b: string = req.body                // "action\nvalue"
    const nl: int = b.indexOf("\n")
    if (nl >= 0) { dispatchInput(b.slice(0, nl), b.slice(nl + 1)) }
    else { dispatchInput(b.trim(), "") }
    persist(); res.send(drain())
})
app.post("/resolve", function(req: Request, res: Response) {   // "token\npayload" — async host->engine result (F3)
    const b: string = req.body
    const nl: int = b.indexOf("\n")
    if (nl >= 0) { resolve(b.slice(0, nl), b.slice(nl + 1)) }
    else { resolve(b.trim(), "") }
    persist(); res.send(drain())
})
app.post("/fail", function(req: Request, res: Response) {   // "token\nmessage" — async capability failure (F3 error channel)
    const b: string = req.body
    const nl: int = b.indexOf("\n")
    if (nl >= 0) { fail(b.slice(0, nl), b.slice(nl + 1)) }
    else { fail(b.trim(), "") }
    persist(); res.send(drain())
})
app.get("/state", function(req: Request, res: Response) { res.send(saveState()) })

// Bind on all interfaces so a real phone on the same Wi-Fi can reach it (sim via
// localhost, Android emulator via 10.0.2.2, real device via the machine's LAN IP).
// macOS may show a one-time firewall prompt the first time.
app.listen(7799, "0.0.0.0")
print("chuks-mobile dev server on :7799 (sim: localhost | emulator: 10.0.2.2 | device: your LAN IP)")
