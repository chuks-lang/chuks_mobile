// Prints a "scan to run on your phone" QR for the running dev server, the way
// Expo Go does. `chuks dev` runs this once at session start; a phone on the same
// Wi-Fi opens Chuks Preview and scans it to load the app over HTTP. Rendering is
// delegated to the published @chuks/qr package, so no QR logic lives in the mobile
// SDK or the toolchain.
//
//   chuks run core/qrprint.chuks                       # auto-detect LAN IP, port 7799
//   chuks run core/qrprint.chuks "chuks://10.0.0.4:7799"  # explicit URL override
import { terminal } from "pkg/@chuks/qr";
import { os } from "std/os";

const PORT: string = "7799"

// Best-effort LAN IP so a real device can reach the dev server. Returns "" if it
// cannot be determined, in which case the caller falls back to localhost.
function lanIp(): string {
    const plat: string = os.platform()
    var cmds: []string = []
    if (plat == "darwin") {
        cmds = ["ipconfig getifaddr en0", "ipconfig getifaddr en1"]
    } else if (plat == "windows") {
        cmds = []
    } else {
        // linux + others: first token of `hostname -I`, else the route source IP.
        cmds = ["hostname -I", "ip -4 -o route get 1.1.1.1"]
    }
    var i: int = 0
    for (i = 0; i < cmds.length; i = i + 1) {
        const r: map[string]any = os.exec(cmds[i])
        if (int(r["exitCode"]) == 0) {
            var out: string = string(r["stdout"]).trim()
            // `hostname -I` returns a space-separated list; take the first.
            const sp: int = out.indexOf(" ")
            if (sp >= 0) { out = out.slice(0, sp) }
            // `ip route get` prints "... src 192.168.1.5 ..."; pull the token after src.
            const si: int = out.indexOf("src ")
            if (si >= 0) {
                var rest: string = out.slice(si + 4)
                const sp2: int = rest.indexOf(" ")
                if (sp2 >= 0) { rest = rest.slice(0, sp2) }
                out = rest.trim()
            }
            if (out.length > 0) { return out }
        }
    }
    return ""
}

const argv: []string = os.args()
var url: string = ""
if (argv.length > 3 && argv[3].length > 0) {
    url = argv[3]
} else {
    const ip: string = lanIp()
    url = "chuks://" + (ip.length > 0 ? ip : "localhost") + ":" + PORT
}

print("\n  Scan to run on your phone (Chuks Preview):\n")
print(terminal(url))
print("  " + url + "\n\n")
